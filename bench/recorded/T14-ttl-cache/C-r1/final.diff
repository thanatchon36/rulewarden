 import time
+from collections import OrderedDict
 
 
 class TTLCache:
+    """LRU cache whose entries expire `ttl` seconds after being set.
+
+    Entries are kept in recency order (least recently used first). Expired
+    entries occupy no capacity: they are purged before any eviction decision.
+    """
+
     def __init__(self, maxsize, ttl, clock=time.monotonic):
-        raise NotImplementedError
+        if maxsize <= 0:
+            raise ValueError("maxsize must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self._maxsize = maxsize
+        self._ttl = ttl
+        self._clock = clock
+        # Maps key -> (value, expiry); expiry is compared against clock().
+        self._data = OrderedDict()
+
+    def set(self, key, value):
+        now = self._clock()
+        if key not in self._data:
+            # Purge first so expired entries don't count toward capacity.
+            self._purge_expired(now)
+            while len(self._data) >= self._maxsize:
+                self._data.popitem(last=False)
+        self._data[key] = (value, now + self._ttl)
+        self._data.move_to_end(key)
+
+    def get(self, key, default=None):
+        entry = self._data.get(key)
+        if entry is None:
+            return default
+        value, expiry = entry
+        if self._clock() >= expiry:
+            del self._data[key]
+            return default
+        self._data.move_to_end(key)
+        return value
+
+    def delete(self, key):
+        entry = self._data.pop(key, None)
+        if entry is None or self._clock() >= entry[1]:
+            raise KeyError(key)
+
+    def __contains__(self, key):
+        entry = self._data.get(key)
+        return entry is not None and self._clock() < entry[1]
+
+    def __len__(self):
+        self._purge_expired(self._clock())
+        return len(self._data)
+
+    def _purge_expired(self, now):
+        expired = [k for k, (_, expiry) in self._data.items() if now >= expiry]
+        for k in expired:
+            del self._data[k]
diff --git a/tests/test_ttl_behaviour.py b/tests/test_ttl_behaviour.py
new file mode 100644
index 0000000..331a65c
--- /dev/null
+++ b/tests/test_ttl_behaviour.py
@@ -0,0 +1,165 @@
+import pytest
+
+from ttlcache import TTLCache
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+@pytest.fixture
+def clock():
+    return FakeClock()
+
+
+def test_rejects_non_positive_maxsize_and_ttl(clock):
+    with pytest.raises(ValueError):
+        TTLCache(0, 10, clock=clock)
+    with pytest.raises(ValueError):
+        TTLCache(-1, 10, clock=clock)
+    with pytest.raises(ValueError):
+        TTLCache(2, 0, clock=clock)
+    with pytest.raises(ValueError):
+        TTLCache(2, -5, clock=clock)
+
+
+def test_get_returns_default_for_missing_key(clock):
+    c = TTLCache(2, 10, clock=clock)
+    assert c.get("missing") is None
+    assert c.get("missing", "fallback") == "fallback"
+
+
+def test_entry_expires_at_exact_expiry_time(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(9.999)
+    assert c.get("a") == 1
+    clock.advance(0.001)
+    assert c.get("a", "gone") == "gone"
+
+
+def test_expired_entry_removed_on_get(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(10)
+    c.get("a")
+    assert "a" not in c._data
+
+
+def test_set_existing_key_replaces_value_and_resets_expiry(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(8)
+    c.set("a", 2)
+    clock.advance(8)
+    assert c.get("a") == 2
+
+
+def test_get_refreshes_recency_for_eviction(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    assert c.get("a") == 1
+    c.set("c", 3)
+    assert "a" in c
+    assert "b" not in c
+    assert "c" in c
+
+
+def test_set_existing_key_makes_it_most_recently_used(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("a", 10)
+    c.set("c", 3)
+    assert "a" in c
+    assert "b" not in c
+
+
+def test_full_cache_evicts_least_recently_used(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("c", 3)
+    assert len(c) == 2
+    assert "a" not in c
+    assert c.get("b") == 2
+    assert c.get("c") == 3
+
+
+def test_expired_entries_dropped_before_lru_eviction(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    c.set("b", 2)
+    clock.advance(5)
+    # "a" has expired; inserting "c" must not evict live "b".
+    c.set("c", 3)
+    assert "b" in c
+    assert "c" in c
+    assert len(c) == 2
+
+
+def test_contains_ignores_expired_entries(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    assert "a" in c
+    clock.advance(10)
+    assert "a" not in c
+
+
+def test_contains_does_not_refresh_recency(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    assert "a" in c
+    c.set("c", 3)
+    assert "a" not in c
+    assert "b" in c
+
+
+def test_len_counts_only_live_entries(clock):
+    c = TTLCache(3, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    c.set("b", 2)
+    assert len(c) == 2
+    clock.advance(5)
+    assert len(c) == 1
+    clock.advance(5)
+    assert len(c) == 0
+
+
+def test_delete_removes_live_key(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    c.delete("a")
+    assert "a" not in c
+    assert len(c) == 0
+
+
+def test_delete_missing_key_raises_key_error(clock):
+    c = TTLCache(2, 10, clock=clock)
+    with pytest.raises(KeyError):
+        c.delete("nope")
+
+
+def test_delete_expired_key_raises_key_error(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(10)
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_default_clock_is_monotonic_and_usable():
+    c = TTLCache(2, 60)
+    c.set("a", 1)
+    assert c.get("a") == 1

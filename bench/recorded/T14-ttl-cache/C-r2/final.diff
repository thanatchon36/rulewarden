index 0000000..5280a61
--- /dev/null
+++ b/tests/test_expiry_and_eviction.py
@@ -0,0 +1,151 @@
+import pytest
+
+from ttlcache import TTLCache
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+
+@pytest.fixture
+def clock():
+    return FakeClock()
+
+
+def make_cache(clock, maxsize=2, ttl=10):
+    return TTLCache(maxsize, ttl, clock=clock)
+
+
+def test_value_expires_at_ttl(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    clock.now = 9.99
+    assert c.get("a") == 1
+    clock.now = 10
+    assert c.get("a", "gone") == "gone"
+
+
+def test_expired_entry_is_removed_on_get(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    clock.now = 10
+    c.get("a")
+    assert "a" not in c._data
+
+
+def test_set_existing_key_replaces_value_and_resets_expiry(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    clock.now = 8
+    c.set("a", 2)
+    clock.now = 15
+    assert c.get("a") == 2
+
+
+def test_get_refreshes_recency(clock):
+    c = make_cache(clock, maxsize=2)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.get("a")
+    c.set("c", 3)
+    assert "a" in c
+    assert "b" not in c
+
+
+def test_set_existing_key_refreshes_recency(clock):
+    c = make_cache(clock, maxsize=2)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("a", 10)
+    c.set("c", 3)
+    assert "a" in c
+    assert "b" not in c
+
+
+def test_get_missing_returns_default(clock):
+    c = make_cache(clock)
+    assert c.get("nope") is None
+    assert c.get("nope", 42) == 42
+
+
+def test_delete_removes_key(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    c.delete("a")
+    assert "a" not in c
+
+
+def test_delete_missing_raises_key_error(clock):
+    c = make_cache(clock)
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_delete_expired_raises_key_error(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    clock.now = 10
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_contains_ignores_expired(clock):
+    c = make_cache(clock)
+    c.set("a", 1)
+    assert "a" in c
+    clock.now = 10
+    assert "a" not in c
+
+
+def test_len_counts_only_live_entries(clock):
+    c = make_cache(clock, maxsize=5)
+    c.set("a", 1)
+    clock.now = 5
+    c.set("b", 2)
+    assert len(c) == 2
+    clock.now = 10
+    assert len(c) == 1
+
+
+def test_full_cache_drops_expired_before_evicting_lru(clock):
+    c = make_cache(clock, maxsize=2)
+    c.set("a", 1)
+    clock.now = 5
+    c.set("b", 2)
+    clock.now = 10
+    c.set("c", 3)
+    assert "a" not in c
+    assert c.get("b") == 2
+    assert c.get("c") == 3
+
+
+def test_full_cache_evicts_lru_when_nothing_expired(clock):
+    c = make_cache(clock, maxsize=3)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("c", 3)
+    c.get("a")
+    c.set("d", 4)
+    assert "b" not in c
+    assert len(c) == 3
+
+
+def test_expired_entries_do_not_count_toward_capacity(clock):
+    c = make_cache(clock, maxsize=2)
+    c.set("a", 1)
+    clock.now = 5
+    c.set("b", 2)
+    clock.now = 10
+    c.set("c", 3)
+    assert len(c) == 2
+    assert c.get("b") == 2
+
+
+@pytest.mark.parametrize("maxsize, ttl", [(0, 10), (-1, 10), (2, 0), (2, -5)])
+def test_non_positive_arguments_raise_value_error(maxsize, ttl):
+    with pytest.raises(ValueError):
+        TTLCache(maxsize, ttl)

 import time
+from collections import OrderedDict
 
 
 class TTLCache:
+    """An LRU cache whose entries expire `ttl` seconds after being set.
+
+    Inserting a new key into a full cache drops expired entries first,
+    then evicts the least recently used entry if still full.
+    """
+
     def __init__(self, maxsize, ttl, clock=time.monotonic):
-        raise NotImplementedError
+        if maxsize <= 0:
+            raise ValueError("maxsize must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self._maxsize = maxsize
+        self._ttl = ttl
+        self._clock = clock
+        # Maps key -> (value, expiry). Iteration order is recency order, so the
+        # first item is the least recently used one.
+        self._data = OrderedDict()
+
+    def set(self, key, value):
+        if not self._is_live(key):
+            self._make_room()
+        self._data[key] = (value, self._clock() + self._ttl)
+        self._data.move_to_end(key)
+
+    def get(self, key, default=None):
+        if not self._is_live(key):
+            return default
+        self._data.move_to_end(key)
+        return self._data[key][0]
+
+    def delete(self, key):
+        if not self._is_live(key):
+            raise KeyError(key)
+        del self._data[key]
+
+    def __contains__(self, key):
+        return self._is_live(key)
+
+    def __len__(self):
+        self._purge_expired()
+        return len(self._data)
+
+    def _is_live(self, key):
+        entry = self._data.get(key)
+        if entry is None:
+            return False
+        if self._clock() < entry[1]:
+            return True
+        # Removed on lookup so expired entries do not linger in the store.
+        del self._data[key]
+        return False
+
+    def _make_room(self):
+        if len(self._data) < self._maxsize:
+            return
+        self._purge_expired()
+        if len(self._data) >= self._maxsize:
+            self._data.popitem(last=False)
+
+    def _purge_expired(self):
+        now = self._clock()
+        expired = [key for key, (_, expiry) in self._data.items() if now >= expiry]
+        for key in expired:
+            del self._data[key]
diff --git a/tests/test_expiry_and_eviction.py b/tests/test_expiry_and_eviction.py

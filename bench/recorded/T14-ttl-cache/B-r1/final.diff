 import time
+from collections import OrderedDict
 
 
 class TTLCache:
+    """LRU cache whose entries expire `ttl` seconds after they are set.
+
+    Entries are kept in an OrderedDict ordered from least to most recently
+    used. An entry is live while `clock() < expiry`.
+    """
+
     def __init__(self, maxsize, ttl, clock=time.monotonic):
-        raise NotImplementedError
+        if maxsize <= 0:
+            raise ValueError("maxsize must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self._maxsize = maxsize
+        self._ttl = ttl
+        self._clock = clock
+        self._entries = OrderedDict()
+
+    def set(self, key, value):
+        expiry = self._clock() + self._ttl
+        if key in self._entries:
+            del self._entries[key]
+        elif len(self._entries) >= self._maxsize:
+            self._make_room()
+        self._entries[key] = (value, expiry)
+
+    def get(self, key, default=None):
+        entry = self._lookup(key)
+        if entry is None:
+            return default
+        self._entries.move_to_end(key)
+        return entry[0]
+
+    def delete(self, key):
+        if self._lookup(key) is None:
+            raise KeyError(key)
+        del self._entries[key]
+
+    def __contains__(self, key):
+        return self._lookup(key) is not None
+
+    def __len__(self):
+        self._purge_expired()
+        return len(self._entries)
+
+    def _lookup(self, key):
+        """Return the live (value, expiry) entry for key, or None."""
+        entry = self._entries.get(key)
+        if entry is not None and self._clock() >= entry[1]:
+            del self._entries[key]
+            return None
+        return entry
+
+    def _purge_expired(self):
+        now = self._clock()
+        expired = [key for key, (_, expiry) in self._entries.items() if now >= expiry]
+        for key in expired:
+            del self._entries[key]
+
+    def _make_room(self):
+        self._purge_expired()
+        if len(self._entries) >= self._maxsize:
+            self._entries.popitem(last=False)
diff --git a/tests/test_ttl_behaviour.py b/tests/test_ttl_behaviour.py
new file mode 100644
index 0000000..afd7b43
--- /dev/null
+++ b/tests/test_ttl_behaviour.py
@@ -0,0 +1,175 @@
+import pytest
+
+from ttlcache import TTLCache
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+@pytest.fixture
+def clock():
+    return FakeClock()
+
+
+def test_rejects_non_positive_maxsize(clock):
+    with pytest.raises(ValueError):
+        TTLCache(0, 10, clock=clock)
+
+
+def test_rejects_non_positive_ttl(clock):
+    with pytest.raises(ValueError):
+        TTLCache(2, 0, clock=clock)
+    with pytest.raises(ValueError):
+        TTLCache(2, -1, clock=clock)
+
+
+def test_get_returns_default_for_missing_key(clock):
+    c = TTLCache(2, 10, clock=clock)
+    assert c.get("missing") is None
+    assert c.get("missing", "fallback") == "fallback"
+
+
+def test_entry_live_until_expiry_instant(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(9.99)
+    assert c.get("a") == 1
+    clock.advance(0.01)
+    assert c.get("a") is None
+
+
+def test_expired_entry_removed_on_get(clock):
+    c = TTLCache(2, 5, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    assert c.get("a", "gone") == "gone"
+    assert len(c) == 0
+
+
+def test_set_replaces_value_and_resets_expiry(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(8)
+    c.set("a", 2)
+    clock.advance(8)
+    assert c.get("a") == 2
+
+
+def test_set_existing_key_makes_it_most_recently_used(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("a", 3)
+    c.set("c", 4)
+    assert "b" not in c
+    assert c.get("a") == 3
+    assert c.get("c") == 4
+
+
+def test_get_marks_entry_most_recently_used(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    assert c.get("a") == 1
+    c.set("c", 3)
+    assert "a" in c
+    assert "b" not in c
+
+
+def test_contains_does_not_affect_recency(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    assert "a" in c
+    c.set("c", 3)
+    assert "a" not in c
+    assert "b" in c
+
+
+def test_contains_ignores_expired(clock):
+    c = TTLCache(2, 5, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    assert "a" not in c
+
+
+def test_len_counts_only_live_entries(clock):
+    c = TTLCache(3, 5, clock=clock)
+    c.set("a", 1)
+    clock.advance(3)
+    c.set("b", 2)
+    assert len(c) == 2
+    clock.advance(2)
+    assert len(c) == 1
+
+
+def test_delete_removes_live_key(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    c.delete("a")
+    assert "a" not in c
+    assert len(c) == 0
+
+
+def test_delete_missing_key_raises(clock):
+    c = TTLCache(2, 10, clock=clock)
+    with pytest.raises(KeyError):
+        c.delete("nope")
+
+
+def test_delete_expired_key_raises(clock):
+    c = TTLCache(2, 5, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_full_cache_evicts_least_recently_used(clock):
+    c = TTLCache(2, 100, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("c", 3)
+    assert "a" not in c
+    assert c.get("b") == 2
+    assert c.get("c") == 3
+    assert len(c) == 2
+
+
+def test_full_cache_drops_expired_before_evicting_lru(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(6)
+    c.set("b", 2)
+    clock.advance(5)
+    # "a" has expired at t=10, "b" is still live until t=16.
+    c.set("c", 3)
+    assert c.get("b") == 2
+    assert c.get("c") == 3
+    assert len(c) == 2
+
+
+def test_expired_entries_do_not_count_toward_capacity(clock):
+    c = TTLCache(2, 5, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    clock.advance(5)
+    c.set("c", 3)
+    c.set("d", 4)
+    assert c.get("c") == 3
+    assert c.get("d") == 4
+    assert len(c) == 2
+
+
+def test_default_clock_is_monotonic_and_usable():
+    c = TTLCache(2, 60)
+    c.set("a", 1)
+    assert c.get("a") == 1

 import time
+from collections import OrderedDict
 
 
 class TTLCache:
+    """LRU cache whose entries expire `ttl` seconds after being set.
+
+    Entries are kept in recency order; an entry is live while
+    `clock() < expiry`. Expired entries are dropped lazily.
+    """
+
     def __init__(self, maxsize, ttl, clock=time.monotonic):
-        raise NotImplementedError
+        if maxsize <= 0:
+            raise ValueError("maxsize must be positive")
+        if ttl <= 0:
+            raise ValueError("ttl must be positive")
+        self._maxsize = maxsize
+        self._ttl = ttl
+        self._clock = clock
+        # Maps key -> (value, expiry), least recently used first.
+        self._data = OrderedDict()
+
+    def set(self, key, value):
+        now = self._clock()
+        if key not in self._data:
+            if len(self._data) >= self._maxsize:
+                self._drop_expired(now)
+            if len(self._data) >= self._maxsize:
+                self._data.popitem(last=False)
+        self._data[key] = (value, now + self._ttl)
+        self._data.move_to_end(key)
+
+    def get(self, key, default=None):
+        if not self._is_live(key, self._clock()):
+            return default
+        self._data.move_to_end(key)
+        return self._data[key][0]
+
+    def delete(self, key):
+        if not self._is_live(key, self._clock()):
+            raise KeyError(key)
+        del self._data[key]
+
+    def __contains__(self, key):
+        return self._is_live(key, self._clock())
+
+    def __len__(self):
+        self._drop_expired(self._clock())
+        return len(self._data)
+
+    def _is_live(self, key, now):
+        entry = self._data.get(key)
+        if entry is None:
+            return False
+        if now < entry[1]:
+            return True
+        del self._data[key]
+        return False
+
+    def _drop_expired(self, now):
+        expired = [key for key, (_, expiry) in self._data.items() if now >= expiry]
+        for key in expired:
+            del self._data[key]
diff --git a/tests/test_ttlcache_behaviour.py b/tests/test_ttlcache_behaviour.py
new file mode 100644
index 0000000..f407c4c
--- /dev/null
+++ b/tests/test_ttlcache_behaviour.py
@@ -0,0 +1,165 @@
+import pytest
+
+from ttlcache import TTLCache
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+@pytest.fixture
+def clock():
+    return FakeClock()
+
+
+def test_get_missing_returns_default():
+    c = TTLCache(2, 10)
+    assert c.get("missing") is None
+    assert c.get("missing", 42) == 42
+
+
+def test_entry_expires_at_expiry_time(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(9.9)
+    assert c.get("a") == 1
+    clock.advance(0.1)
+    assert c.get("a", "gone") == "gone"
+
+
+def test_set_existing_key_replaces_value_and_resets_expiry(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(8)
+    c.set("a", 2)
+    clock.advance(8)
+    assert c.get("a") == 2
+
+
+def test_get_expired_entry_is_removed(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(10)
+    assert c.get("a") is None
+    assert "a" not in c._data
+
+
+def test_delete_removes_key():
+    c = TTLCache(2, 10)
+    c.set("a", 1)
+    c.delete("a")
+    assert "a" not in c
+    assert len(c) == 0
+
+
+def test_delete_missing_raises_key_error():
+    c = TTLCache(2, 10)
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_delete_expired_raises_key_error(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(10)
+    with pytest.raises(KeyError):
+        c.delete("a")
+
+
+def test_contains_ignores_expired(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    assert "a" in c
+    clock.advance(10)
+    assert "a" not in c
+
+
+def test_len_counts_only_live_entries(clock):
+    c = TTLCache(3, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    c.set("b", 2)
+    assert len(c) == 2
+    clock.advance(5)
+    assert len(c) == 1
+
+
+def test_get_refreshes_recency_so_other_key_is_evicted():
+    c = TTLCache(2, 100)
+    c.set("a", 1)
+    c.set("b", 2)
+    assert c.get("a") == 1
+    c.set("c", 3)
+    assert "b" not in c
+    assert c.get("a") == 1
+    assert c.get("c") == 3
+
+
+def test_set_existing_key_makes_it_most_recently_used():
+    c = TTLCache(2, 100)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("a", 10)
+    c.set("c", 3)
+    assert "b" not in c
+    assert c.get("a") == 10
+
+
+def test_full_cache_evicts_least_recently_used():
+    c = TTLCache(2, 100)
+    c.set("a", 1)
+    c.set("b", 2)
+    c.set("c", 3)
+    assert len(c) == 2
+    assert "a" not in c
+    assert "b" in c and "c" in c
+
+
+def test_insert_into_full_cache_drops_expired_before_evicting(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("old", 1)
+    clock.advance(5)
+    c.set("new", 2)
+    clock.advance(5)
+    # "old" is expired; "new" is live and must survive the insert.
+    c.set("x", 3)
+    assert "new" in c
+    assert "x" in c
+    assert "old" not in c._data
+    assert len(c) == 2
+
+
+def test_insert_when_expired_entries_free_space_does_not_evict_live(clock):
+    c = TTLCache(3, 10, clock=clock)
+    c.set("a", 1)
+    clock.advance(5)
+    c.set("b", 2)
+    c.set("c", 3)
+    clock.advance(5)
+    c.set("d", 4)
+    assert "b" in c and "c" in c and "d" in c
+    assert "a" not in c
+
+
+def test_overwriting_expired_key_does_not_evict_others(clock):
+    c = TTLCache(2, 10, clock=clock)
+    c.set("a", 1)
+    c.set("b", 2)
+    clock.advance(10)
+    c.set("a", 3)
+    assert c.get("a") == 3
+    assert "b" not in c
+    assert len(c) == 1
+
+
+@pytest.mark.parametrize("maxsize, ttl", [(0, 10), (-1, 10), (2, 0), (2, -5)])
+def test_non_positive_arguments_raise_value_error(maxsize, ttl):
+    with pytest.raises(ValueError):
+        TTLCache(maxsize, ttl)

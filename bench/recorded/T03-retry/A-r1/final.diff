+import functools
 import time
 
 
 def retry(times, exceptions=(Exception,), delay=0.0, backoff=2.0, sleep=time.sleep):
-    raise NotImplementedError
+    if times < 1:
+        raise ValueError("times must be at least 1")
+    if delay < 0:
+        raise ValueError("delay must be non-negative")
+    if backoff < 1:
+        raise ValueError("backoff must be at least 1")
+
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            attempt = 0
+            try:
+                while True:
+                    attempt += 1
+                    try:
+                        return func(*args, **kwargs)
+                    except exceptions:
+                        if attempt >= times:
+                            raise
+                        if delay:
+                            sleep(delay * backoff ** (attempt - 1))
+            finally:
+                wrapper.last_attempts = attempt
+
+        wrapper.last_attempts = 0
+        return wrapper
+
+    return decorator
diff --git a/tests/test_retry_behaviour.py b/tests/test_retry_behaviour.py

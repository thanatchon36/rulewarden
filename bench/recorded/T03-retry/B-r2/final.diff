index cb6d921..f8bc771 100644
--- a/src/resilience/retry.py
+++ b/src/resilience/retry.py
@@ -1,5 +1,36 @@
+import functools
 import time
 
 
 def retry(times, exceptions=(Exception,), delay=0.0, backoff=2.0, sleep=time.sleep):
-    raise NotImplementedError
+    """Retry the decorated function on the given exceptions.
+
+    The function is called at most `times` times. Before retry number n
+    the wrapper waits `delay * backoff ** (n - 1)` seconds via `sleep`.
+    The final failure is re-raised unchanged.
+    """
+    if times < 1:
+        raise ValueError(f"times must be >= 1, got {times}")
+    if delay < 0:
+        raise ValueError(f"delay must be >= 0, got {delay}")
+    if backoff < 1:
+        raise ValueError(f"backoff must be >= 1, got {backoff}")
+
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            wrapper.last_attempts = 0
+            for attempt in range(1, times + 1):
+                wrapper.last_attempts = attempt
+                try:
+                    return func(*args, **kwargs)
+                except exceptions:
+                    if attempt == times:
+                        raise
+                    if delay:
+                        sleep(delay * backoff ** (attempt - 1))
+
+        wrapper.last_attempts = 0
+        return wrapper
+
+    return decorator
diff --git a/tests/test_retry_behaviour.py b/tests/test_retry_behaviour.py
new file mode 100644
index 0000000..209863c
--- /dev/null
+++ b/tests/test_retry_behaviour.py
@@ -0,0 +1,173 @@
+import pytest
+
+from resilience import retry
+
+
+class Flaky:
+    def __init__(self, failures, exc=ValueError):
+        self.failures = failures
+        self.exc = exc
+        self.calls = 0
+
+    def __call__(self):
+        self.calls += 1
+        if self.calls <= self.failures:
+            raise self.exc(f"fail {self.calls}")
+        return self.calls
+
+
+def test_retries_until_success():
+    flaky = Flaky(failures=2)
+    wrapped = retry(3, sleep=lambda s: None)(flaky)
+
+    assert wrapped() == 3
+    assert flaky.calls == 3
+    assert wrapped.last_attempts == 3
+
+
+def test_reraises_last_exception_unchanged():
+    err = ValueError("boom")
+
+    @retry(3, sleep=lambda s: None)
+    def always_fails():
+        raise err
+
+    with pytest.raises(ValueError) as info:
+        always_fails()
+
+    assert info.value is err
+    assert always_fails.last_attempts == 3
+
+
+def test_called_at_most_times():
+    flaky = Flaky(failures=10)
+    wrapped = retry(4, sleep=lambda s: None)(flaky)
+
+    with pytest.raises(ValueError):
+        wrapped()
+
+    assert flaky.calls == 4
+    assert wrapped.last_attempts == 4
+
+
+def test_unlisted_exception_propagates_without_retry():
+    flaky = Flaky(failures=5, exc=KeyError)
+    wrapped = retry(5, exceptions=(ValueError,), sleep=lambda s: None)(flaky)
+
+    with pytest.raises(KeyError):
+        wrapped()
+
+    assert flaky.calls == 1
+    assert wrapped.last_attempts == 1
+
+
+def test_listed_exception_subclass_is_retried():
+    class MyError(ValueError):
+        pass
+
+    flaky = Flaky(failures=1, exc=MyError)
+    wrapped = retry(2, exceptions=(ValueError,), sleep=lambda s: None)(flaky)
+
+    assert wrapped() == 2
+
+
+def test_default_exceptions_retries_any_exception():
+    flaky = Flaky(failures=1, exc=RuntimeError)
+    wrapped = retry(2, sleep=lambda s: None)(flaky)
+
+    assert wrapped() == 2
+
+
+def test_backoff_sleep_schedule():
+    sleeps = []
+    flaky = Flaky(failures=3)
+    wrapped = retry(4, delay=1.5, backoff=2.0, sleep=sleeps.append)(flaky)
+
+    assert wrapped() == 4
+    assert sleeps == [1.5, 3.0, 6.0]
+
+
+def test_no_sleep_after_final_failure():
+    sleeps = []
+
+    @retry(3, delay=1.0, sleep=sleeps.append)
+    def always_fails():
+        raise ValueError
+
+    with pytest.raises(ValueError):
+        always_fails()
+
+    assert sleeps == [1.0, 2.0]
+
+
+def test_no_sleep_call_when_delay_is_zero():
+    calls = []
+
+    def record(seconds):
+        calls.append(seconds)
+
+    flaky = Flaky(failures=2)
+    wrapped = retry(3, delay=0.0, sleep=record)(flaky)
+
+    assert wrapped() == 3
+    assert calls == []
+
+
+def test_no_sleep_for_non_retried_exception():
+    sleeps = []
+    flaky = Flaky(failures=1, exc=KeyError)
+    wrapped = retry(3, exceptions=(ValueError,), delay=1.0, sleep=sleeps.append)(flaky)
+
+    with pytest.raises(KeyError):
+        wrapped()
+
+    assert sleeps == []
+
+
+def test_last_attempts_resets_each_invocation():
+    flaky = Flaky(failures=1)
+    wrapped = retry(3, sleep=lambda s: None)(flaky)
+
+    assert wrapped() == 2
+    assert wrapped.last_attempts == 2
+
+    flaky.failures = 0
+    assert wrapped() == 3
+    assert wrapped.last_attempts == 1
+
+
+def test_wrapper_keeps_name_and_doc():
+    @retry(2)
+    def documented():
+        """Some doc."""
+        return 1
+
+    assert documented.__name__ == "documented"
+    assert documented.__doc__ == "Some doc."
+
+
+def test_passes_arguments_through():
+    @retry(2, sleep=lambda s: None)
+    def add(a, b=0):
+        return a + b
+
+    assert add(2, b=3) == 5
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"times": 0},
+        {"times": -1},
+        {"times": 3, "delay": -0.1},
+        {"times": 3, "backoff": 0.5},
+    ],
+)
+def test_invalid_arguments_raise_value_error(kwargs):
+    with pytest.raises(ValueError):
+        retry(**kwargs)
+
+
+def test_boundary_values_accepted():
+    retry(1)
+    retry(1, delay=0.0, backoff=1.0)

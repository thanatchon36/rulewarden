diff --git a/scripts/backup.sh b/scripts/backup.sh
index efba8c1..53c5e29 100755
--- a/scripts/backup.sh
+++ b/scripts/backup.sh
@@ -1,3 +1,48 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+set -euo pipefail
+
+usage() {
+    echo "usage: backup.sh SRC_DIR DEST_DIR [KEEP]" >&2
+    exit 2
+}
+
+if [[ $# -lt 2 || $# -gt 3 ]]; then
+    usage
+fi
+
+src=$1
+dest=$2
+keep=${3-5}
+
+if ! [[ $keep =~ ^[0-9]+$ ]] || (( 10#$keep < 1 )); then
+    usage
+fi
+keep=$((10#$keep))
+
+if [[ ! -d $src ]]; then
+    echo "error: not a directory: $src" >&2
+    exit 1
+fi
+
+stamp=${BACKUP_NOW:-$(date +%Y%m%d-%H%M%S)}
+archive="$dest/backup-$stamp.tar.gz"
+
+mkdir -p -- "$dest"
+COPYFILE_DISABLE=1 tar -czf "$archive" -C "$src" .
+
+shopt -s nullglob
+LC_COLLATE=C
+backups=()
+for file in "$dest"/backup-*.tar.gz; do
+    if [[ -f $file ]]; then
+        backups+=("$file")
+    fi
+done
+
+# Glob results are sorted ascending by name, so the oldest come first.
+excess=$(( ${#backups[@]} - keep ))
+for (( i = 0; i < excess; i++ )); do
+    rm -f -- "${backups[i]}"
+done
+
+echo "$archive"
diff --git a/tests/test_backup_archive.py b/tests/test_backup_archive.py
new file mode 100644
index 0000000..2566e1a
--- /dev/null
+++ b/tests/test_backup_archive.py
@@ -0,0 +1,157 @@
+import os
+import re
+import subprocess
+import tarfile
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "backup.sh"
+
+
+def run_backup(*args, now=None):
+    env = dict(os.environ)
+    env.pop("BACKUP_NOW", None)
+    if now is not None:
+        env["BACKUP_NOW"] = now
+    return subprocess.run(
+        ["bash", str(SCRIPT), *map(str, args)],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+
+
+@pytest.fixture
+def src(tmp_path):
+    d = tmp_path / "src"
+    (d / "sub").mkdir(parents=True)
+    (d / "a.txt").write_text("alpha")
+    (d / "sub" / "b.txt").write_text("beta")
+    return d
+
+
+def test_archive_contains_source_contents_with_relative_paths(src, tmp_path):
+    dest = tmp_path / "out"
+    result = run_backup(src, dest, now="20240102-030405")
+    assert result.returncode == 0, result.stderr
+
+    archive = dest / "backup-20240102-030405.tar.gz"
+    assert archive.is_file()
+    with tarfile.open(archive, "r:gz") as tar:
+        members = {os.path.normpath(m.name): m for m in tar.getmembers()}
+        assert not any(os.path.isabs(m.name) for m in tar.getmembers())
+        assert "a.txt" in members
+        assert os.path.join("sub", "b.txt") in members
+        assert tar.extractfile(members["a.txt"]).read() == b"alpha"
+        assert "src" not in members
+
+
+def test_prints_archive_path_on_stdout(src, tmp_path):
+    dest = tmp_path / "out"
+    result = run_backup(src, dest, now="20240102-030405")
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.strip() == str(dest / "backup-20240102-030405.tar.gz")
+
+
+def test_creates_missing_dest_directory(src, tmp_path):
+    dest = tmp_path / "nested" / "deeper"
+    result = run_backup(src, dest, now="20240102-030405")
+    assert result.returncode == 0, result.stderr
+    assert (dest / "backup-20240102-030405.tar.gz").is_file()
+
+
+def test_default_stamp_uses_local_time_format(src, tmp_path):
+    dest = tmp_path / "out"
+    result = run_backup(src, dest)
+    assert result.returncode == 0, result.stderr
+    created = [p.name for p in dest.iterdir()]
+    assert len(created) == 1
+    assert re.fullmatch(r"backup-\d{8}-\d{6}\.tar\.gz", created[0])
+
+
+def test_backup_now_overrides_stamp(src, tmp_path):
+    dest = tmp_path / "out"
+    result = run_backup(src, dest, now="19990101-000000")
+    assert result.returncode == 0, result.stderr
+    assert (dest / "backup-19990101-000000.tar.gz").is_file()
+
+
+def test_default_keep_is_five(src, tmp_path):
+    dest = tmp_path / "out"
+    dest.mkdir()
+    for day in range(1, 8):
+        (dest / f"backup-2024010{day}-000000.tar.gz").write_bytes(b"old")
+    result = run_backup(src, dest, now="20240108-000000")
+    assert result.returncode == 0, result.stderr
+
+    remaining = sorted(p.name for p in dest.glob("backup-*.tar.gz"))
+    assert remaining == [
+        "backup-20240104-000000.tar.gz",
+        "backup-20240105-000000.tar.gz",
+        "backup-20240106-000000.tar.gz",
+        "backup-20240107-000000.tar.gz",
+        "backup-20240108-000000.tar.gz",
+    ]
+
+
+def test_explicit_keep_retains_newest_only(src, tmp_path):
+    dest = tmp_path / "out"
+    dest.mkdir()
+    for name in ["backup-20230101-000000.tar.gz", "backup-20240101-000000.tar.gz"]:
+        (dest / name).write_bytes(b"old")
+    result = run_backup(src, dest, 1, now="20250101-000000")
+    assert result.returncode == 0, result.stderr
+
+    assert sorted(p.name for p in dest.iterdir()) == ["backup-20250101-000000.tar.gz"]
+
+
+def test_rotation_never_deletes_other_files(src, tmp_path):
+    dest = tmp_path / "out"
+    dest.mkdir()
+    others = ["notes.txt", "backup-old.zip", "backup-20200101-000000.tar", "readme"]
+    for name in others:
+        (dest / name).write_text("keep me")
+    (dest / "backup-20200101-000000.tar.gz").write_bytes(b"old")
+
+    result = run_backup(src, dest, 1, now="20240101-000000")
+    assert result.returncode == 0, result.stderr
+
+    for name in others:
+        assert (dest / name).read_text() == "keep me"
+    assert sorted(p.name for p in dest.glob("backup-*.tar.gz")) == [
+        "backup-20240101-000000.tar.gz"
+    ]
+
+
+def test_keep_larger_than_count_deletes_nothing(src, tmp_path):
+    dest = tmp_path / "out"
+    dest.mkdir()
+    (dest / "backup-20200101-000000.tar.gz").write_bytes(b"old")
+    result = run_backup(src, dest, 10, now="20240101-000000")
+    assert result.returncode == 0, result.stderr
+    assert len(list(dest.glob("backup-*.tar.gz"))) == 2
+
+
+@pytest.mark.parametrize("keep", ["0", "-1", "abc", "1.5", "", "2x"])
+def test_invalid_keep_is_usage_error(src, tmp_path, keep):
+    dest = tmp_path / "out"
+    result = run_backup(src, dest, keep)
+    assert result.returncode == 2
+    assert "usage" in result.stderr.lower()
+    assert not dest.exists()
+
+
+def test_too_few_arguments_is_usage_error(src):
+    result = run_backup(src)
+    assert result.returncode == 2
+    assert "usage" in result.stderr.lower()
+
+
+def test_source_not_a_directory_exits_1(tmp_path):
+    missing = tmp_path / "missing"
+    dest = tmp_path / "out"
+    result = run_backup(missing, dest, now="20240101-000000")
+    assert result.returncode == 1
+    assert result.stderr.strip() != ""
+    assert not (dest / "backup-20240101-000000.tar.gz").exists()

index 7f39ed3..6976062 100644
--- a/src/ratelimit/bucket.py
+++ b/src/ratelimit/bucket.py
@@ -3,4 +3,51 @@ import time
 
 class TokenBucket:
     def __init__(self, rate, capacity, clock=time.monotonic):
-        raise NotImplementedError
+        if rate <= 0:
+            raise ValueError("rate must be positive")
+        if capacity <= 0:
+            raise ValueError("capacity must be positive")
+        self._rate = rate
+        self._capacity = capacity
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    @property
+    def rate(self):
+        return self._rate
+
+    @property
+    def capacity(self):
+        return self._capacity
+
+    @property
+    def tokens(self):
+        self._refill()
+        return self._tokens
+
+    def try_acquire(self, n=1):
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
+
+    def wait_time(self, n=1):
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._rate
+
+    def _check_n(self, n):
+        if n <= 0 or n > self._capacity:
+            raise ValueError("n must be positive and at most capacity")
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        if elapsed > 0:
+            self._tokens = min(self._capacity, self._tokens + elapsed * self._rate)
+        self._last = now
diff --git a/tests/test_bucket_behaviour.py b/tests/test_bucket_behaviour.py
new file mode 100644
index 0000000..5dde313
--- /dev/null
+++ b/tests/test_bucket_behaviour.py
@@ -0,0 +1,107 @@
+import pytest
+
+from ratelimit import TokenBucket
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+def test_try_acquire_removes_tokens_on_success():
+    b = TokenBucket(1, 5, clock=FakeClock())
+    assert b.try_acquire(2) is True
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_try_acquire_fails_and_removes_nothing():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.try_acquire(2) is True
+    assert b.try_acquire(2) is False
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_default_n_is_one():
+    b = TokenBucket(1, 1, clock=FakeClock())
+    assert b.try_acquire() is True
+    assert b.try_acquire() is False
+
+
+def test_refills_continuously_at_rate():
+    clock = FakeClock()
+    b = TokenBucket(2, 10, clock=clock)
+    assert b.try_acquire(10) is True
+    clock.advance(1.5)
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_refill_capped_at_capacity():
+    clock = FakeClock()
+    b = TokenBucket(5, 4, clock=clock)
+    clock.advance(100.0)
+    assert b.tokens == pytest.approx(4.0)
+
+
+def test_tokens_is_float():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert isinstance(b.tokens, float)
+
+
+def test_wait_time_zero_when_available():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_computes_seconds_until_available():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    assert b.wait_time(3) == pytest.approx(1.5)
+    clock.advance(0.5)
+    assert b.wait_time(3) == pytest.approx(1.0)
+    clock.advance(1.0)
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_does_not_remove_tokens():
+    clock = FakeClock()
+    b = TokenBucket(1, 2, clock=clock)
+    assert b.try_acquire(2) is True
+    b.wait_time(2)
+    b.wait_time(1)
+    assert b.tokens == pytest.approx(0.0)
+
+
+def test_wait_time_then_try_acquire_succeeds_after_wait():
+    clock = FakeClock()
+    b = TokenBucket(4, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    clock.advance(b.wait_time(2))
+    assert b.try_acquire(2) is True
+
+
+def test_rate_and_capacity_exposed():
+    b = TokenBucket(2.5, 7, clock=FakeClock())
+    assert b.rate == 2.5
+    assert b.capacity == 7
+
+
+@pytest.mark.parametrize("rate,capacity", [(0, 1), (-1, 1), (1, 0), (1, -2)])
+def test_rejects_non_positive_rate_or_capacity(rate, capacity):
+    with pytest.raises(ValueError):
+        TokenBucket(rate, capacity, clock=FakeClock())
+
+
+@pytest.mark.parametrize("n", [0, -1, 4])
+def test_rejects_invalid_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(n)
+    with pytest.raises(ValueError):
+        b.wait_time(n)

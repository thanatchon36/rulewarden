index 7f39ed3..b373dbc 100644
--- a/src/ratelimit/bucket.py
+++ b/src/ratelimit/bucket.py
@@ -2,5 +2,55 @@ import time
 
 
 class TokenBucket:
+    """Token bucket that starts full and refills continuously at `rate` tokens/second."""
+
     def __init__(self, rate, capacity, clock=time.monotonic):
-        raise NotImplementedError
+        if rate <= 0:
+            raise ValueError(f"rate must be positive, got {rate}")
+        if capacity <= 0:
+            raise ValueError(f"capacity must be positive, got {capacity}")
+        self._rate = rate
+        self._capacity = capacity
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    @property
+    def rate(self):
+        return self._rate
+
+    @property
+    def capacity(self):
+        return self._capacity
+
+    @property
+    def tokens(self):
+        self._refill()
+        return self._tokens
+
+    def try_acquire(self, n=1):
+        """Remove `n` tokens and return True if available; otherwise return False."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
+
+    def wait_time(self, n=1):
+        """Return seconds until `n` tokens are available; 0.0 if available now."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._rate
+
+    def _check_n(self, n):
+        if n <= 0 or n > self._capacity:
+            raise ValueError(f"n must be in (0, {self._capacity}], got {n}")
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        self._last = now
+        self._tokens = min(float(self._capacity), self._tokens + elapsed * self._rate)
diff --git a/tests/test_token_bucket_behaviour.py b/tests/test_token_bucket_behaviour.py
new file mode 100644
index 0000000..611aa97
--- /dev/null
+++ b/tests/test_token_bucket_behaviour.py
@@ -0,0 +1,105 @@
+import pytest
+
+from ratelimit import TokenBucket
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+def test_try_acquire_removes_tokens_on_success():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.try_acquire(2) is True
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_try_acquire_fails_without_removing_tokens():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.try_acquire(2) is True
+    assert b.try_acquire(2) is False
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_default_n_is_one():
+    b = TokenBucket(1, 1, clock=FakeClock())
+    assert b.try_acquire() is True
+    assert b.try_acquire() is False
+
+
+def test_refills_continuously_at_rate():
+    clock = FakeClock()
+    b = TokenBucket(2, 10, clock=clock)
+    assert b.try_acquire(10) is True
+    clock.now = 1.5
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_refill_never_exceeds_capacity():
+    clock = FakeClock()
+    b = TokenBucket(5, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    clock.now = 1000.0
+    assert b.tokens == pytest.approx(4.0)
+
+
+def test_tokens_is_float():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert isinstance(b.tokens, float)
+
+
+def test_wait_time_zero_when_available():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_computes_seconds_until_available():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    assert b.wait_time(3) == pytest.approx(1.5)
+
+
+def test_wait_time_does_not_remove_tokens():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    b.wait_time(2)
+    assert b.tokens == pytest.approx(0.0)
+    clock.now = 1.0
+    assert b.try_acquire(2) is True
+
+
+def test_wait_time_matches_acquire_timing():
+    clock = FakeClock()
+    b = TokenBucket(4, 4, clock=clock)
+    assert b.try_acquire(4) is True
+    delay = b.wait_time(2)
+    clock.now += delay
+    assert b.try_acquire(2) is True
+
+
+@pytest.mark.parametrize("kwargs", [{"rate": 0, "capacity": 1}, {"rate": -1, "capacity": 1},
+                                    {"rate": 1, "capacity": 0}, {"rate": 1, "capacity": -2}])
+def test_rejects_non_positive_rate_or_capacity(kwargs):
+    with pytest.raises(ValueError):
+        TokenBucket(clock=FakeClock(), **kwargs)
+
+
+@pytest.mark.parametrize("n", [0, -1, 4])
+def test_rejects_invalid_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(n)
+    with pytest.raises(ValueError):
+        b.wait_time(n)
+
+
+def test_invalid_n_does_not_change_state():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(4)
+    assert b.tokens == pytest.approx(3.0)

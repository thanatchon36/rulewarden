index 7f39ed3..67f51f0 100644
--- a/src/ratelimit/bucket.py
+++ b/src/ratelimit/bucket.py
@@ -2,5 +2,64 @@ import time
 
 
 class TokenBucket:
+    """Token bucket that starts full and refills continuously.
+
+    Tokens accrue at ``rate`` per second up to ``capacity``. Time is read
+    from the injected ``clock`` callable, so behaviour can be tested with a
+    fake clock.
+    """
+
     def __init__(self, rate, capacity, clock=time.monotonic):
-        raise NotImplementedError
+        if rate <= 0:
+            raise ValueError(f"rate must be positive, got {rate!r}")
+        if capacity <= 0:
+            raise ValueError(f"capacity must be positive, got {capacity!r}")
+        self._rate = rate
+        self._capacity = capacity
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    @property
+    def rate(self):
+        return self._rate
+
+    @property
+    def capacity(self):
+        return self._capacity
+
+    @property
+    def tokens(self):
+        """Current token count after refilling up to now."""
+        self._refill()
+        return self._tokens
+
+    def try_acquire(self, n=1):
+        """Remove ``n`` tokens if available; return whether they were taken."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
+
+    def wait_time(self, n=1):
+        """Seconds until ``n`` tokens are available; 0.0 if available now."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._rate
+
+    def _check_n(self, n):
+        if n <= 0 or n > self._capacity:
+            raise ValueError(
+                f"n must be positive and at most capacity {self._capacity!r}, got {n!r}"
+            )
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        if elapsed > 0:
+            self._tokens = min(self._capacity, self._tokens + elapsed * self._rate)
+        self._last = now
diff --git a/tests/test_token_bucket_behaviour.py b/tests/test_token_bucket_behaviour.py
new file mode 100644
index 0000000..ddc784f
--- /dev/null
+++ b/tests/test_token_bucket_behaviour.py
@@ -0,0 +1,114 @@
+import pytest
+
+from ratelimit import TokenBucket
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+
+def test_refills_at_rate():
+    clock = FakeClock()
+    b = TokenBucket(2, 10, clock=clock)
+    assert b.try_acquire(10)
+    clock.now = 1.5
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_refill_capped_at_capacity():
+    clock = FakeClock()
+    b = TokenBucket(5, 4, clock=clock)
+    assert b.try_acquire(4)
+    clock.now = 100.0
+    assert b.tokens == pytest.approx(4.0)
+
+
+def test_failed_acquire_removes_nothing():
+    clock = FakeClock()
+    b = TokenBucket(1, 3, clock=clock)
+    assert b.try_acquire(2)
+    assert not b.try_acquire(2)
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_acquire_takes_exact_amount():
+    clock = FakeClock()
+    b = TokenBucket(1, 5, clock=clock)
+    assert b.try_acquire(2)
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_default_n_is_one():
+    clock = FakeClock()
+    b = TokenBucket(1, 1, clock=clock)
+    assert b.try_acquire()
+    assert not b.try_acquire()
+
+
+def test_wait_time_zero_when_available():
+    clock = FakeClock()
+    b = TokenBucket(1, 3, clock=clock)
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_computes_deficit_over_rate():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4)
+    assert b.wait_time(3) == pytest.approx(1.5)
+    clock.now = 0.5
+    assert b.wait_time(3) == pytest.approx(1.0)
+
+
+def test_wait_time_does_not_remove_tokens():
+    clock = FakeClock()
+    b = TokenBucket(1, 2, clock=clock)
+    assert b.try_acquire(2)
+    b.wait_time(2)
+    assert b.tokens == pytest.approx(0.0)
+    clock.now = 2.0
+    assert b.try_acquire(2)
+
+
+def test_wait_time_matches_acquire_moment():
+    clock = FakeClock()
+    b = TokenBucket(4, 4, clock=clock)
+    assert b.try_acquire(4)
+    delay = b.wait_time(2)
+    clock.now += delay
+    assert b.try_acquire(2)
+
+
+def test_tokens_is_float():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert isinstance(b.tokens, float)
+
+
+@pytest.mark.parametrize("rate", [0, -1])
+def test_rate_must_be_positive(rate):
+    with pytest.raises(ValueError):
+        TokenBucket(rate, 3, clock=FakeClock())
+
+
+@pytest.mark.parametrize("capacity", [0, -2])
+def test_capacity_must_be_positive(capacity):
+    with pytest.raises(ValueError):
+        TokenBucket(1, capacity, clock=FakeClock())
+
+
+@pytest.mark.parametrize("n", [0, -1, 4])
+def test_try_acquire_rejects_invalid_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(n)
+
+
+@pytest.mark.parametrize("n", [0, -1, 4])
+def test_wait_time_rejects_invalid_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.wait_time(n)

index 7f39ed3..adbbea2 100644
--- a/src/ratelimit/bucket.py
+++ b/src/ratelimit/bucket.py
@@ -2,5 +2,54 @@ import time
 
 
 class TokenBucket:
+    """Token bucket that refills continuously at `rate` tokens per second.
+
+    The bucket starts full with `capacity` tokens and never holds more.
+    Time is read from `clock`, so tests can supply a fake clock.
+    """
+
     def __init__(self, rate, capacity, clock=time.monotonic):
-        raise NotImplementedError
+        if rate <= 0:
+            raise ValueError("rate must be positive")
+        if capacity <= 0:
+            raise ValueError("capacity must be positive")
+        self.rate = rate
+        self.capacity = capacity
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        self._last = now
+        self._tokens = min(float(self.capacity), self._tokens + elapsed * self.rate)
+
+    def _check_n(self, n):
+        if n <= 0:
+            raise ValueError("n must be positive")
+        if n > self.capacity:
+            raise ValueError("n must not exceed capacity")
+
+    @property
+    def tokens(self):
+        """Current token count, including tokens refilled since the last call."""
+        self._refill()
+        return self._tokens
+
+    def try_acquire(self, n=1):
+        """Take `n` tokens if available. Return False and take nothing otherwise."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
+
+    def wait_time(self, n=1):
+        """Seconds until `n` tokens are available; 0.0 if they are now. Takes nothing."""
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.rate
diff --git a/tests/test_token_bucket_behaviour.py b/tests/test_token_bucket_behaviour.py
new file mode 100644
index 0000000..04bbcde
--- /dev/null
+++ b/tests/test_token_bucket_behaviour.py
@@ -0,0 +1,121 @@
+import pytest
+
+from ratelimit import TokenBucket
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+def test_refills_continuously():
+    clock = FakeClock()
+    b = TokenBucket(2, 10, clock=clock)
+    assert b.try_acquire(10)
+    clock.advance(1.5)
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_refill_never_exceeds_capacity():
+    clock = FakeClock()
+    b = TokenBucket(5, 4, clock=clock)
+    clock.advance(100)
+    assert b.tokens == pytest.approx(4.0)
+
+
+def test_tokens_starts_at_capacity_as_float():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.tokens == pytest.approx(3.0)
+    assert isinstance(b.tokens, float)
+
+
+def test_failed_acquire_removes_nothing():
+    clock = FakeClock()
+    b = TokenBucket(1, 3, clock=clock)
+    assert b.try_acquire(2)
+    assert not b.try_acquire(2)
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_acquire_default_is_one_token():
+    b = TokenBucket(1, 1, clock=FakeClock())
+    assert b.try_acquire()
+    assert not b.try_acquire()
+
+
+def test_acquire_then_refill_allows_again():
+    clock = FakeClock()
+    b = TokenBucket(1, 1, clock=clock)
+    assert b.try_acquire()
+    assert not b.try_acquire()
+    clock.advance(1.0)
+    assert b.try_acquire()
+
+
+def test_wait_time_zero_when_available():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_is_seconds_until_available():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4)
+    assert b.wait_time(3) == pytest.approx(1.5)
+    clock.advance(0.5)
+    assert b.wait_time(3) == pytest.approx(1.0)
+    clock.advance(0.5)
+    assert b.wait_time(3) == pytest.approx(0.5)
+    clock.advance(0.5)
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_does_not_remove_tokens():
+    clock = FakeClock()
+    b = TokenBucket(1, 2, clock=clock)
+    assert b.try_acquire(2)
+    b.wait_time(1)
+    b.wait_time(1)
+    assert b.tokens == pytest.approx(0.0)
+
+
+def test_wait_time_matches_try_acquire_after_waiting():
+    clock = FakeClock()
+    b = TokenBucket(0.5, 2, clock=clock)
+    assert b.try_acquire(2)
+    clock.advance(b.wait_time(1))
+    assert b.try_acquire(1)
+
+
+@pytest.mark.parametrize("rate, capacity", [(0, 1), (-1, 1), (1, 0), (1, -2)])
+def test_rejects_non_positive_rate_or_capacity(rate, capacity):
+    with pytest.raises(ValueError):
+        TokenBucket(rate, capacity, clock=FakeClock())
+
+
+@pytest.mark.parametrize("n", [0, -1])
+def test_rejects_non_positive_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(n)
+    with pytest.raises(ValueError):
+        b.wait_time(n)
+
+
+def test_rejects_n_above_capacity():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(4)
+    with pytest.raises(ValueError):
+        b.wait_time(4)
+
+
+def test_uses_monotonic_clock_by_default():
+    b = TokenBucket(1, 1)
+    assert b.try_acquire()

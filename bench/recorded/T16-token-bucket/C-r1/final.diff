diff --git a/src/ratelimit/bucket.py b/src/ratelimit/bucket.py
index 7f39ed3..92c38fb 100644
--- a/src/ratelimit/bucket.py
+++ b/src/ratelimit/bucket.py
@@ -2,5 +2,52 @@ import time
 
 
 class TokenBucket:
+    """Token bucket that starts full and refills continuously.
+
+    Tokens refill at `rate` per second up to `capacity`. Time is read
+    from `clock`, so callers can inject a fake clock in tests.
+    """
+
     def __init__(self, rate, capacity, clock=time.monotonic):
-        raise NotImplementedError
+        if not rate > 0:
+            raise ValueError("rate must be positive")
+        if not capacity > 0:
+            raise ValueError("capacity must be positive")
+        self.rate = rate
+        self.capacity = capacity
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    def _refill(self):
+        now = self._clock()
+        elapsed = now - self._last
+        self._last = now
+        if elapsed > 0:
+            self._tokens = min(self.capacity, self._tokens + elapsed * self.rate)
+
+    def _check_n(self, n):
+        if not n > 0:
+            raise ValueError("n must be positive")
+        if n > self.capacity:
+            raise ValueError("n must not exceed capacity")
+
+    @property
+    def tokens(self):
+        self._refill()
+        return self._tokens
+
+    def try_acquire(self, n=1):
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
+
+    def wait_time(self, n=1):
+        self._check_n(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.rate
diff --git a/tests/test_token_bucket.py b/tests/test_token_bucket.py
new file mode 100644
index 0000000..7780f7f
--- /dev/null
+++ b/tests/test_token_bucket.py
@@ -0,0 +1,116 @@
+import pytest
+
+from ratelimit import TokenBucket
+
+
+class FakeClock:
+    def __init__(self, now=0.0):
+        self.now = now
+
+    def __call__(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+def test_starts_with_full_capacity():
+    b = TokenBucket(1, 5, clock=FakeClock())
+    assert b.tokens == 5.0
+
+
+def test_try_acquire_removes_tokens_when_available():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.try_acquire(2)
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_try_acquire_fails_without_removing_tokens():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.try_acquire(2)
+    assert not b.try_acquire(2)
+    assert b.tokens == pytest.approx(1.0)
+
+
+def test_try_acquire_defaults_to_one_token():
+    b = TokenBucket(1, 1, clock=FakeClock())
+    assert b.try_acquire()
+    assert not b.try_acquire()
+
+
+def test_refills_continuously_at_rate():
+    clock = FakeClock()
+    b = TokenBucket(2, 10, clock=clock)
+    assert b.try_acquire(10)
+    clock.advance(1.5)
+    assert b.tokens == pytest.approx(3.0)
+
+
+def test_refill_never_exceeds_capacity():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(1)
+    clock.advance(100.0)
+    assert b.tokens == pytest.approx(4.0)
+
+
+def test_acquire_after_refill():
+    clock = FakeClock()
+    b = TokenBucket(1, 2, clock=clock)
+    assert b.try_acquire(2)
+    assert not b.try_acquire(1)
+    clock.advance(1.0)
+    assert b.try_acquire(1)
+    assert not b.try_acquire(1)
+
+
+def test_wait_time_zero_when_available():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    assert b.wait_time(3) == 0.0
+
+
+def test_wait_time_for_missing_tokens():
+    clock = FakeClock()
+    b = TokenBucket(2, 4, clock=clock)
+    assert b.try_acquire(4)
+    assert b.wait_time(3) == pytest.approx(1.5)
+
+
+def test_wait_time_does_not_remove_tokens():
+    clock = FakeClock()
+    b = TokenBucket(1, 2, clock=clock)
+    assert b.try_acquire(2)
+    b.wait_time(1)
+    b.wait_time(1)
+    assert b.tokens == pytest.approx(0.0)
+
+
+def test_wait_time_matches_acquire_boundary():
+    clock = FakeClock()
+    b = TokenBucket(4, 4, clock=clock)
+    assert b.try_acquire(4)
+    clock.advance(b.wait_time(2))
+    assert b.try_acquire(2)
+
+
+@pytest.mark.parametrize("rate,capacity", [(0, 1), (-1, 1), (1, 0), (1, -2)])
+def test_rejects_non_positive_rate_or_capacity(rate, capacity):
+    with pytest.raises(ValueError):
+        TokenBucket(rate, capacity, clock=FakeClock())
+
+
+@pytest.mark.parametrize("n", [0, -1])
+def test_rejects_non_positive_n(n):
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(n)
+    with pytest.raises(ValueError):
+        b.wait_time(n)
+
+
+def test_rejects_n_above_capacity():
+    b = TokenBucket(1, 3, clock=FakeClock())
+    with pytest.raises(ValueError):
+        b.try_acquire(4)
+    with pytest.raises(ValueError):
+        b.wait_time(4)

+def _det_gauss(m: Matrix, convert) -> int | float | Fraction:
+    """Gaussian elimination with partial pivoting; `convert` sets the number type."""
+    n = len(m)
+    work = [[convert(x) for x in row] for row in m]
+    sign = 1
+    det = convert(1)
+    for k in range(n):
+        pivot = max(range(k, n), key=lambda r: abs(work[r][k]))
+        if work[pivot][k] == 0:
+            return convert(0)
+        if pivot != k:
+            work[k], work[pivot] = work[pivot], work[k]
+            sign = -sign
+        p = work[k][k]
+        det *= p
+        for r in range(k + 1, n):
+            f = work[r][k] / p
+            for j in range(k, n):
+                work[r][j] -= f * work[k][j]
+    return sign * det
 
 
-def determinant(m: Matrix) -> float:
-    raise NotImplementedError
+def determinant(m: Matrix) -> int | float | Fraction:
+    rows, cols = _shape(m)
+    if rows != cols:
+        raise ValueError(f"determinant requires a square matrix, got {rows}x{cols}")
+    if any(isinstance(x, float) for row in m for x in row):
+        return _det_gauss(m, float)
+    det = _det_gauss(m, Fraction)
+    if all(isinstance(x, int) for row in m for x in row):
+        return int(det)
+    return det

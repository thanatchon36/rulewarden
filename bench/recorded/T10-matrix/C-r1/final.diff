+def _shape(m: Matrix) -> tuple[int, int]:
+    """Return (rows, cols) of m, raising ValueError if it is empty or ragged."""
+    if not m or any(not row for row in m):
+        raise ValueError("matrix must be non-empty with non-empty rows")
+    width = len(m[0])
+    if any(len(row) != width for row in m):
+        raise ValueError("matrix rows must all have the same length")
+    return len(m), width
 
 

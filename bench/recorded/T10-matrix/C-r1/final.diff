+import itertools
+import math
+import random
+from fractions import Fraction
+
+import pytest
+
+from matrix.ops import determinant, identity, matmul, transpose
+
+
+def leibniz_det(m):
+    """Reference determinant via permutation expansion, independent of the module."""
+    n = len(m)
+    total = 0
+    for perm in itertools.permutations(range(n)):
+        sign = 1
+        for i in range(n):
+            for j in range(i + 1, n):
+                if perm[i] > perm[j]:
+                    sign = -sign
+        term = sign
+        for i in range(n):
+            term = term * m[i][perm[i]]
+        total += term
+    return total
+
+
+def test_transpose_rectangular():
+    assert transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]
+
+
+def test_transpose_does_not_modify_input():
+    m = [[1, 2], [3, 4]]
+    transpose(m)
+    assert m == [[1, 2], [3, 4]]
+
+
+def test_matmul_rectangular():
+    a = [[1, 2, 3], [4, 5, 6]]
+    b = [[7, 8], [9, 10], [11, 12]]
+    assert matmul(a, b) == [[58, 64], [139, 154]]
+
+
+def test_matmul_with_identity_is_noop():
+    a = [[1.5, -2], [0, 3]]
+    assert matmul(a, identity(2)) == a
+
+
+def test_matmul_fraction_stays_exact():
+    a = [[Fraction(1, 3)]]
+    b = [[Fraction(3, 1)]]
+    assert matmul(a, b) == [[Fraction(1, 1)]]
+
+
+def test_matmul_does_not_modify_inputs():
+    a = [[1, 2], [3, 4]]
+    b = [[5, 6], [7, 8]]
+    matmul(a, b)
+    assert a == [[1, 2], [3, 4]]
+    assert b == [[5, 6], [7, 8]]
+
+
+def test_identity_values():
+    assert identity(1) == [[1]]
+    assert identity(3) == [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
+
+
+def test_determinant_int_returns_int():
+    assert determinant([[1, 2], [3, 4]]) == -2
+    assert type(determinant([[1, 2], [3, 4]])) is int
+
+
+def test_determinant_singular_int_is_zero():
+    assert determinant([[1, 2], [2, 4]]) == 0
+
+
+def test_determinant_needs_row_swap():
+    assert determinant([[0, 1], [1, 0]]) == -1
+
+
+def test_determinant_fraction_returns_fraction():
+    m = [[Fraction(1, 2), Fraction(1, 3)], [Fraction(1, 4), Fraction(1, 5)]]
+    result = determinant(m)
+    assert type(result) is Fraction
+    assert result == Fraction(1, 2) * Fraction(1, 5) - Fraction(1, 3) * Fraction(1, 4)
+
+
+def test_determinant_mixed_int_and_fraction_is_fraction():
+    result = determinant([[Fraction(1, 2), 1], [1, 1]])
+    assert type(result) is Fraction
+    assert result == Fraction(-1, 2)
+
+
+def test_determinant_float_returns_float():
+    result = determinant([[2.0, 1.0], [1.0, 3.0]])
+    assert isinstance(result, float)
+    assert math.isclose(result, 5.0)
+
+
+def test_determinant_float_singular_is_zero():
+    assert determinant([[1.0, 2.0], [2.0, 4.0]]) == 0.0
+
+
+def test_determinant_does_not_modify_input():
+    m = [[0, 1], [1, 0]]
+    determinant(m)
+    assert m == [[0, 1], [1, 0]]
+
+
+@pytest.mark.parametrize("size", range(1, 9))
+def test_determinant_int_matches_reference(size):
+    rng = random.Random(size)
+    m = [[rng.randint(-9, 9) for _ in range(size)] for _ in range(size)]
+    result = determinant(m)
+    assert type(result) is int
+    assert result == leibniz_det(m)
+
+
+@pytest.mark.parametrize("size", [5, 8])
+def test_determinant_fraction_matches_reference(size):
+    rng = random.Random(100 + size)
+    m = [
+        [Fraction(rng.randint(-9, 9), rng.randint(1, 9)) for _ in range(size)]
+        for _ in range(size)
+    ]
+    result = determinant(m)
+    assert type(result) is Fraction
+    assert result == leibniz_det(m)
+
+
+@pytest.mark.parametrize(
+    "func, args",
+    [
+        (transpose, ([],)),
+        (transpose, ([[]],)),
+        (transpose, ([[1, 2], [3]],)),
+        (matmul, ([[1, 2]], [[1, 2]])),
+        (matmul, ([[1, 2], [3]], [[1], [2]])),
+        (determinant, ([[1, 2]],)),
+        (determinant, ([],)),
+        (determinant, ([[1, 2], [3]],)),
+        (identity, (0,)),
+        (identity, (-1,)),
+    ],
+)
+def test_invalid_input_raises_value_error(func, args):
+    with pytest.raises(ValueError):
+        func(*args)

+"""Pure-Python matrix helpers on lists of lists."""
+
+import operator
+from fractions import Fraction
+
+Number = int | float | Fraction
+Matrix = list[list[Number]]
+
+
+def _validate(m: Matrix) -> None:
+    """Raise if m is not a non-empty, rectangular matrix of real numbers."""
+    if not isinstance(m, list) or not m:
+        raise ValueError("matrix must be a non-empty list of rows")
+    if not all(isinstance(row, list) and row for row in m):
+        raise ValueError("every row must be a non-empty list")
+    if len({len(row) for row in m}) != 1:
+        raise ValueError("ragged matrix: all rows must have the same length")
+    for row in m:
+        for x in row:
+            if isinstance(x, bool) or not isinstance(x, (int, float, Fraction)):
+                raise TypeError(f"unsupported matrix element: {x!r}")
+
+
+def _copy(m: Matrix) -> Matrix:
+    """Return a row-by-row copy so callers' matrices are never mutated."""
+    return [list(row) for row in m]
 
 
 def transpose(m: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the transpose of m."""
+    _validate(m)
+    return [list(col) for col in zip(*m)]
 
 
 def matmul(a: Matrix, b: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the matrix product a @ b."""
+    _validate(a)
+    _validate(b)
+    if len(a[0]) != len(b):
+        raise ValueError(
+            f"shape mismatch: {len(a)}x{len(a[0])} @ {len(b)}x{len(b[0])}"
+        )
+    cols = list(zip(*b))
+    return [[sum(x * y for x, y in zip(row, col)) for col in cols] for row in a]
 
 
 def identity(n: int) -> Matrix:
-    raise NotImplementedError
+    """Return the n-by-n identity matrix."""
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 1:
+        raise ValueError(f"n must be at least 1, got {n}")
+    return [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+
+
+def determinant(m: Matrix) -> Number:
+    """Return the determinant of square matrix m.
+
+    Int and Fraction input is computed exactly (int or Fraction result).
+    Float input is computed in floating point and returns a float.
+    """
+    _validate(m)
+    if len(m) != len(m[0]):
+        raise ValueError(f"determinant requires a square matrix, got {len(m)}x{len(m[0])}")
+    if any(isinstance(x, float) for row in m for x in row):
+        return _det_float([[float(x) for x in row] for row in m])
+    if any(isinstance(x, Fraction) for row in m for x in row):
+        return _bareiss([[Fraction(x) for x in row] for row in m], operator.truediv, Fraction(0))
+    return _bareiss(_copy(m), operator.floordiv, 0)
+
+
+def _bareiss(rows: Matrix, div, zero: Number) -> Number:
+    """Fraction-free Gaussian elimination (Bareiss); divisions are exact.
+
+    `rows` is modified in place, so the caller must pass a copy.
+    """
+    n = len(rows)
+    sign = 1
+    prev = 1
+    for k in range(n - 1):
+        if rows[k][k] == 0:
+            swap = next((i for i in range(k + 1, n) if rows[i][k] != 0), None)
+            if swap is None:
+                return zero
+            rows[k], rows[swap] = rows[swap], rows[k]
+            sign = -sign
+        for i in range(k + 1, n):
+            for j in range(k + 1, n):
+                rows[i][j] = div(rows[i][j] * rows[k][k] - rows[i][k] * rows[k][j], prev)
+        prev = rows[k][k]
+    return sign * rows[n - 1][n - 1]
 
 
-def determinant(m: Matrix) -> float:
-    raise NotImplementedError
+def _det_float(rows: Matrix) -> float:
+    """Gaussian elimination with partial pivoting; `rows` is modified in place."""
+    n = len(rows)
+    det = 1.0
+    for k in range(n):
+        p = max(range(k, n), key=lambda i: abs(rows[i][k]))
+        if rows[p][k] == 0.0:
+            return 0.0
+        if p != k:
+            rows[k], rows[p] = rows[p], rows[k]
+            det = -det
+        pivot = rows[k][k]
+        det *= pivot
+        for i in range(k + 1, n):
+            f = rows[i][k] / pivot
+            for j in range(k + 1, n):
+                rows[i][j] -= f * rows[k][j]
+    return det

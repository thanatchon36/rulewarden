+from fractions import Fraction
+
+Number = int | float | Fraction
+Matrix = list[list[Number]]
+
+
+def _validate(m: Matrix) -> None:
+    if not isinstance(m, list) or not m:
+        raise ValueError("matrix must be a non-empty list of rows")
+    width = None
+    for row in m:
+        if not isinstance(row, list) or not row:
+            raise ValueError("every row must be a non-empty list")
+        if width is None:
+            width = len(row)
+        elif len(row) != width:
+            raise ValueError("matrix rows must all have the same length")
+        for x in row:
+            if isinstance(x, bool) or not isinstance(x, (int, float, Fraction)):
+                raise ValueError(f"unsupported matrix element: {x!r}")
+
+
+def _shape(m: Matrix) -> tuple[int, int]:
+    return len(m), len(m[0])
 
 
 def transpose(m: Matrix) -> Matrix:
-    raise NotImplementedError
+    _validate(m)
+    return [list(col) for col in zip(*m)]
 
 
 def matmul(a: Matrix, b: Matrix) -> Matrix:
-    raise NotImplementedError
+    _validate(a)
+    _validate(b)
+    rows_a, cols_a = _shape(a)
+    rows_b, cols_b = _shape(b)
+    if cols_a != rows_b:
+        raise ValueError(
+            f"shape mismatch: ({rows_a}x{cols_a}) @ ({rows_b}x{cols_b})"
+        )
+    b_cols = list(zip(*b))
+    return [
+        [sum(x * y for x, y in zip(row, col)) for col in b_cols]

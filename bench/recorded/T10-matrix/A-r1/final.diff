+import copy
+import random
+from fractions import Fraction
+
+import pytest
+
+from matrix import determinant, identity, matmul, transpose
+
+
+# transpose
+
+def test_transpose_rectangular():
+    assert transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]
+
+
+def test_transpose_single_row_and_column():
+    assert transpose([[1, 2, 3]]) == [[1], [2], [3]]
+    assert transpose([[1], [2], [3]]) == [[1, 2, 3]]
+
+
+def test_transpose_twice_is_identity_operation():
+    m = [[1.5, 2], [Fraction(1, 3), 4]]
+    assert transpose(transpose(m)) == m
+
+
+# matmul
+
+def test_matmul_int():
+    assert matmul([[1, 2], [3, 4]], [[5, 6], [7, 8]]) == [[19, 22], [43, 50]]
+
+
+def test_matmul_rectangular():
+    assert matmul([[1, 2, 3]], [[4], [5], [6]]) == [[32]]
+    assert matmul([[1], [2]], [[3, 4]]) == [[3, 4], [6, 8]]
+
+
+def test_matmul_with_identity():
+    m = [[2, -1, 0], [5, 3, 7], [1, 1, 1]]
+    assert matmul(m, identity(3)) == m
+    assert matmul(identity(3), m) == m
+
+
+def test_matmul_fraction_stays_exact():
+    a = [[Fraction(1, 2), Fraction(1, 3)]]
+    b = [[Fraction(1, 2)], [Fraction(1, 3)]]
+    assert matmul(a, b) == [[Fraction(1, 4) + Fraction(1, 9)]]
+
+
+def test_matmul_shape_mismatch_raises():
+    with pytest.raises(ValueError):
+        matmul([[1, 2]], [[1, 2]])
+
+
+# identity
+
+def test_identity_values():
+    assert identity(1) == [[1]]
+    assert identity(3) == [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
+
+
+@pytest.mark.parametrize("n", [0, -1, -5])
+def test_identity_rejects_small_n(n):
+    with pytest.raises(ValueError):
+        identity(n)
+
+
+# determinant
+
+def test_det_1x1():
+    assert determinant([[7]]) == 7
+
+
+def test_det_2x2_and_3x3():
+    assert determinant([[1, 2], [3, 4]]) == -2
+    assert determinant([[6, 1, 1], [4, -2, 5], [2, 8, 7]]) == -306
+
+
+def test_det_int_returns_int():
+    result = determinant([[2, 0], [0, 3]])
+    assert result == 6
+    assert type(result) is int
+
+
+def test_det_singular_is_zero():
+    assert determinant([[1, 2, 3], [4, 5, 6], [7, 8, 9]]) == 0
+    assert determinant([[0, 0], [0, 0]]) == 0
+
+
+def test_det_needs_row_swap():
+    # Leading zero forces pivoting; the sign must flip correctly.
+    assert determinant([[0, 1], [1, 0]]) == -1
+    # Expansion along row 0: -2 * (1) + 1 * (1) = -1
+    assert determinant([[0, 2, 1], [1, 0, 0], [3, 1, 1]]) == -1
+
+
+def test_det_fraction_returns_fraction():
+    m = [[Fraction(1, 2), Fraction(1, 3)], [Fraction(1, 4), Fraction(1, 5)]]
+    result = determinant(m)
+    assert type(result) is Fraction
+    assert result == Fraction(1, 2) * Fraction(1, 5) - Fraction(1, 3) * Fraction(1, 4)
+
+
+def test_det_mixed_int_and_fraction_returns_fraction():
+    result = determinant([[1, Fraction(1, 2)], [Fraction(1, 3), 2]])
+    assert type(result) is Fraction
+    assert result == 2 - Fraction(1, 6)
+
+
+def test_det_float_input_returns_float():
+    result = determinant([[1.5, 2.0], [3.0, 4.0]])
+    assert isinstance(result, float)
+    assert result == pytest.approx(0.0)
+    assert determinant([[0.5, 0.0], [0.0, 4.0]]) == 2.0
+
+
+def test_det_int_exact_beyond_float_precision():
+    # Float elimination would lose the low digits of this value.
+    big = 10**20
+    assert determinant([[big + 1, big], [big, big - 1]]) == -1
+
+
+def _reference_det(m):
+    """Plain Fraction Laplace expansion, used only to check the fast paths."""
+    n = len(m)
+    if n == 1:
+        return Fraction(m[0][0])
+    total = Fraction(0)
+    for j in range(n):
+        minor = [row[:j] + row[j + 1:] for row in m[1:]]
+        total += (-1) ** j * Fraction(m[0][j]) * _reference_det(minor)
+    return total
+
+
+@pytest.mark.parametrize("n", range(1, 7))
+def test_det_int_matches_reference(n):
+    rng = random.Random(n)
+    for _ in range(20):
+        m = [[rng.randint(-9, 9) for _ in range(n)] for _ in range(n)]
+        expected = _reference_det(m)
+        result = determinant(m)
+        assert type(result) is int
+        assert result == expected
+
+
+@pytest.mark.parametrize("n", [7, 8])
+def test_det_int_matches_reference_large(n):
+    rng = random.Random(100 + n)
+    for _ in range(3):
+        m = [[rng.randint(-20, 20) for _ in range(n)] for _ in range(n)]
+        assert determinant(m) == _reference_det(m)
+
+
+def test_det_8x8_with_zero_pivots():
+    # Permutation-like matrix with many zero pivots; determinant is +-1.
+    n = 8
+    m = [[1 if j == (i + 1) % n else 0 for j in range(n)] for i in range(n)]
+    assert determinant(m) == _reference_det(m)
+    assert determinant(m) in (1, -1)
+
+
+def test_det_fraction_8x8_matches_reference():
+    rng = random.Random(8)
+    m = [[Fraction(rng.randint(-9, 9), rng.randint(1, 9)) for _ in range(8)] for _ in range(8)]
+    result = determinant(m)
+    assert type(result) is Fraction
+    assert result == _reference_det(m)
+
+
+def test_det_identity_all_sizes():
+    for n in range(1, 9):
+        assert determinant(identity(n)) == 1
+
+
+def test_det_multiplicative():
+    a = [[2, 1, 0], [1, 3, 2], [0, 1, 4]]
+    b = [[1, 2, 3], [0, 1, 4], [5, 6, 0]]
+    assert determinant(matmul(a, b)) == determinant(a) * determinant(b)
+
+
+@pytest.mark.parametrize("m", [[[1, 2, 3], [4, 5, 6]], [[1, 2], [3, 4], [5, 6]]])
+def test_det_non_square_raises(m):
+    with pytest.raises(ValueError):
+        determinant(m)
+
+
+# input validation (shared)
+
+BAD_MATRICES = [
+    [],
+    [[]],
+    [[1, 2], [3]],
+    [[1], [2, 3]],
+    [[1, "2"]],
+    [[1, None]],
+    [[1, True]],
+    [1, 2],
+    [[1, 2], (3, 4)],
+]
+
+
+@pytest.mark.parametrize("bad", BAD_MATRICES)
+def test_transpose_rejects_bad_input(bad):
+    with pytest.raises(ValueError):
+        transpose(bad)
+
+
+@pytest.mark.parametrize("bad", BAD_MATRICES)
+def test_determinant_rejects_bad_input(bad):
+    with pytest.raises(ValueError):
+        determinant(bad)
+
+
+@pytest.mark.parametrize("bad", BAD_MATRICES)
+def test_matmul_rejects_bad_input(bad):
+    with pytest.raises(ValueError):
+        matmul(bad, [[1]])
+    with pytest.raises(ValueError):
+        matmul([[1]], bad)
+
+
+# arguments are not modified
+
+def test_functions_do_not_modify_arguments():
+    a = [[2, 1, 0], [1, 3, 2], [0, 1, 4]]
+    b = [[Fraction(1, 2), 2, 3], [0, 1, 4], [5, 6, Fraction(1, 7)]]
+    f = [[0.5, 1.0], [2.0, 3.0]]
+    snapshots = [copy.deepcopy(x) for x in (a, b, f)]
+
+    transpose(a)
+    matmul(a, b)
+    determinant(a)
+    determinant(b)
+    determinant(f)
+    transpose(f)
+    matmul(f, f)
+
+    assert [a, b, f] == snapshots
+    assert [type(x) for x in a[0]] == [int, int, int]

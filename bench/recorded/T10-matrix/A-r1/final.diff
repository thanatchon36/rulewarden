+    ]
 
 
 def identity(n: int) -> Matrix:
-    raise NotImplementedError
+    if n < 1:
+        raise ValueError(f"identity size must be at least 1, got {n}")
+    return [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+
+
+def _det_int(m: Matrix) -> int:
+    # Bareiss fraction-free elimination: every intermediate value is an
+    # integer, and the division by the previous pivot is always exact.
+    a = [row[:] for row in m]
+    n = len(a)
+    sign = 1
+    prev = 1
+    for k in range(n - 1):
+        if a[k][k] == 0:
+            swap = next((i for i in range(k + 1, n) if a[i][k] != 0), None)
+            if swap is None:
+                return 0
+            a[k], a[swap] = a[swap], a[k]
+            sign = -sign
+        for i in range(k + 1, n):
+            for j in range(k + 1, n):
+                a[i][j] = (a[i][j] * a[k][k] - a[i][k] * a[k][j]) // prev
+        prev = a[k][k]
+    return sign * a[n - 1][n - 1]
+
+
+def _det_fraction(m: Matrix) -> Fraction:
+    a = [[Fraction(x) for x in row] for row in m]
+    n = len(a)
+    det = Fraction(1)
+    for k in range(n):
+        pivot = next((i for i in range(k, n) if a[i][k] != 0), None)
+        if pivot is None:
+            return Fraction(0)
+        if pivot != k:
+            a[k], a[pivot] = a[pivot], a[k]
+            det = -det
+        det *= a[k][k]
+        for i in range(k + 1, n):
+            factor = a[i][k] / a[k][k]
+            if factor:
+                for j in range(k, n):
+                    a[i][j] -= factor * a[k][j]
+    return det
 
 
-def determinant(m: Matrix) -> float:
-    raise NotImplementedError
+def determinant(m: Matrix) -> Number:
+    _validate(m)
+    rows, cols = _shape(m)
+    if rows != cols:
+        raise ValueError(f"determinant needs a square matrix, got {rows}x{cols}")
+    flat = [x for row in m for x in row]
+    if any(isinstance(x, float) for x in flat):
+        # Fraction(float) is exact, so the result is the correctly rounded
+        # value of the exact determinant of the float inputs.
+        return float(_det_fraction(m))
+    if any(isinstance(x, Fraction) for x in flat):
+        return _det_fraction(m)
+    return _det_int(m)

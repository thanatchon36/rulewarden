+from fractions import Fraction
+
 Matrix = list[list[float]]
 
 
+def _check_matrix(m) -> None:
+    """Raise ValueError unless m is a non-empty, rectangular list of non-empty rows."""
+    if not m or not all(m):
+        raise ValueError("matrix must be non-empty with non-empty rows")
+    width = len(m[0])
+    if any(len(row) != width for row in m):
+        raise ValueError("matrix rows must all have the same length")
+
+
 def transpose(m: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the transpose of m as a new list of lists."""
+    _check_matrix(m)
+    return [list(col) for col in zip(*m)]
 
 
 def matmul(a: Matrix, b: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the matrix product a @ b as a new list of lists."""
+    _check_matrix(a)
+    _check_matrix(b)
+    if len(a[0]) != len(b):
+        raise ValueError(f"shape mismatch: {len(a)}x{len(a[0])} @ {len(b)}x{len(b[0])}")
+    cols = list(zip(*b))
+    return [[sum(x * y for x, y in zip(row, col)) for col in cols] for row in a]
 
 
 def identity(n: int) -> Matrix:
-    raise NotImplementedError
+    """Return the n x n identity matrix."""
+    if n < 1:
+        raise ValueError("identity size must be at least 1")
+    return [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+
+
+def _kind(m: Matrix) -> type:
+    """Return float, Fraction or int, whichever is the widest type present in m."""
+    flat = [x for row in m for x in row]
+    if any(isinstance(x, float) for x in flat):
+        return float
+    if any(isinstance(x, Fraction) for x in flat):
+        return Fraction
+    return int
+
+
+def _det_bareiss(m: Matrix) -> int:
+    """Exact integer determinant via Bareiss fraction-free elimination."""
+    a = [list(row) for row in m]
+    n = len(a)
+    sign, prev = 1, 1
+    for k in range(n - 1):
+        if a[k][k] == 0:
+            swap = next((i for i in range(k + 1, n) if a[i][k] != 0), None)
+            if swap is None:
+                return 0
+            a[k], a[swap] = a[swap], a[k]
+            sign = -sign
+        for i in range(k + 1, n):
+            for j in range(k + 1, n):
+                a[i][j] = (a[i][j] * a[k][k] - a[i][k] * a[k][j]) // prev
+        prev = a[k][k]
+    return sign * a[n - 1][n - 1]
+
+
+def _det_gauss(m: Matrix, one: float | Fraction) -> float | Fraction:
+    """Gaussian elimination with partial pivoting; `one` sets the result type."""
+    a = [list(row) for row in m]
+    n = len(a)
+    det = one
+    for k in range(n):
+        p = max(range(k, n), key=lambda i: abs(a[i][k]))
+        if a[p][k] == 0:
+            return one * 0
+        if p != k:
+            a[k], a[p] = a[p], a[k]
+            det = -det
+        det *= a[k][k]
+        for i in range(k + 1, n):
+            f = a[i][k] / a[k][k]
+            for j in range(k, n):
+                a[i][j] -= f * a[k][j]
+    return det
 
 
 def determinant(m: Matrix) -> float:
-    raise NotImplementedError
+    """Return the determinant of square m.
+
+    int input gives an exact int, Fraction input gives an exact Fraction,
+    and float input gives a float.
+    """
+    _check_matrix(m)
+    if len(m) != len(m[0]):
+        raise ValueError("determinant requires a square matrix")
+    kind = _kind(m)
+    if kind is int:
+        return _det_bareiss(m)
+    if kind is Fraction:
+        return _det_gauss([[Fraction(x) for x in row] for row in m], Fraction(1))
+    return _det_gauss([[float(x) for x in row] for row in m], 1.0)

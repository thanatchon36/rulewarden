+from fractions import Fraction
+from typing import Union
+
+Number = Union[int, float, Fraction]
+Matrix = list[list[Number]]
+
+
+def _validate(m: Matrix, name: str = "matrix") -> tuple[int, int]:
+    """Return (rows, cols) of m, raising ValueError if it is empty or ragged."""
+    if not m or not all(isinstance(row, list) for row in m):
+        raise ValueError(f"{name} must be a non-empty list of rows")
+    cols = len(m[0])
+    if cols == 0:
+        raise ValueError(f"{name} must not contain empty rows")
+    if any(len(row) != cols for row in m):
+        raise ValueError(f"{name} rows must all have the same length")
+    return len(m), cols
 
 
 def transpose(m: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the transpose of m as a new list of lists."""
+    _validate(m)
+    return [list(col) for col in zip(*m)]
 
 
 def matmul(a: Matrix, b: Matrix) -> Matrix:
-    raise NotImplementedError
+    """Return the matrix product a @ b as a new list of lists."""
+    _, a_cols = _validate(a, "a")
+    b_rows, _ = _validate(b, "b")
+    if a_cols != b_rows:
+        raise ValueError(f"shape mismatch: a has {a_cols} columns, b has {b_rows} rows")
+    b_t = transpose(b)
+    return [[sum(x * y for x, y in zip(row, col)) for col in b_t] for row in a]
 
 
 def identity(n: int) -> Matrix:
-    raise NotImplementedError
+    """Return the n x n identity matrix."""
+    if n < 1:
+        raise ValueError("identity size must be at least 1")
+    return [[1 if i == j else 0 for j in range(n)] for i in range(n)]
+
+
+def determinant(m: Matrix) -> Number:
+    """Return the determinant of square m.
+
+    Int and Fraction input are computed exactly (int or Fraction result);
+    float input returns a float.
+    """
+    rows, cols = _validate(m)
+    if rows != cols:
+        raise ValueError(f"determinant requires a square matrix, got {rows}x{cols}")
+    if any(isinstance(x, float) for row in m for x in row):
+        return _float_determinant([[float(x) for x in row] for row in m])
+    result = _exact_determinant([[Fraction(x) for x in row] for row in m])
+    if all(isinstance(x, int) for row in m for x in row):
+        return int(result)
+    return result
+
+
+def _exact_determinant(m: list[list[Fraction]]) -> Fraction:
+    """Gaussian elimination over Fraction; m is consumed (copy before calling)."""
+    n = len(m)
+    det = Fraction(1)
+    for col in range(n):
+        pivot = next((r for r in range(col, n) if m[r][col] != 0), None)
+        if pivot is None:
+            return Fraction(0)
+        if pivot != col:
+            m[col], m[pivot] = m[pivot], m[col]
+            det = -det
+        det *= m[col][col]
+        for r in range(col + 1, n):
+            factor = m[r][col] / m[col][col]
+            for c in range(col, n):
+                m[r][c] -= factor * m[col][c]
+    return det
 
 

+def _float_determinant(m: list[list[float]]) -> float:
+    """Gaussian elimination with partial pivoting; m is consumed."""
+    n = len(m)
+    det = 1.0
+    for col in range(n):
+        pivot = max(range(col, n), key=lambda r: abs(m[r][col]))
+        if m[pivot][col] == 0:
+            return 0.0
+        if pivot != col:
+            m[col], m[pivot] = m[pivot], m[col]
+            det = -det
+        det *= m[col][col]
+        for r in range(col + 1, n):
+            factor = m[r][col] / m[col][col]
+            for c in range(col, n):
+                m[r][c] -= factor * m[col][c]
+    return det
diff --git a/tests/test_matrix_ops.py b/tests/test_matrix_ops.py

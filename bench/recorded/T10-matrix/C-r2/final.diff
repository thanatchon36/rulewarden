@@ -0,0 +1,104 @@
+from fractions import Fraction
+
+import pytest
+
+from matrix.ops import determinant, identity, matmul, transpose
+
+
+def test_transpose_rectangular():
+    assert transpose([[1, 2, 3], [4, 5, 6]]) == [[1, 4], [2, 5], [3, 6]]
+
+
+def test_transpose_does_not_modify_input():
+    m = [[1, 2], [3, 4]]
+    transpose(m)
+    assert m == [[1, 2], [3, 4]]
+
+
+def test_matmul_rectangular():
+    assert matmul([[1, 2, 3]], [[4], [5], [6]]) == [[32]]
+    assert matmul([[1, 2], [3, 4]], [[5, 6], [7, 8]]) == [[19, 22], [43, 50]]
+
+
+def test_matmul_identity_is_neutral():
+    m = [[1.5, 2], [3, 4]]
+    assert matmul(m, identity(2)) == m
+
+
+def test_matmul_shape_mismatch_raises():
+    with pytest.raises(ValueError):
+        matmul([[1, 2]], [[1, 2]])
+
+
+def test_identity():
+    assert identity(1) == [[1]]
+    assert identity(3) == [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
+
+
+def test_identity_rejects_small_n():
+    with pytest.raises(ValueError):
+        identity(0)
+    with pytest.raises(ValueError):
+        identity(-2)
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [[], [[]], [[1, 2], [3]], [[1], [2, 3]]],
+)
+def test_empty_or_ragged_raises(bad):
+    with pytest.raises(ValueError):
+        transpose(bad)
+    with pytest.raises(ValueError):
+        determinant(bad)
+
+
+def test_determinant_non_square_raises():
+    with pytest.raises(ValueError):
+        determinant([[1, 2, 3], [4, 5, 6]])
+
+
+def test_determinant_int_returns_int():
+    result = determinant([[2, 0, 1], [1, 3, 2], [1, 1, 1]])
+    assert result == 4
+    assert type(result) is int
+
+
+def test_determinant_singular_int():
+    assert determinant([[1, 2], [2, 4]]) == 0
+
+
+def test_determinant_needs_row_swap():
+    assert determinant([[0, 1], [1, 0]]) == -1
+
+
+def test_determinant_fraction_returns_fraction():
+    m = [[Fraction(1, 2), Fraction(1, 3)], [Fraction(1, 4), Fraction(1, 5)]]
+    result = determinant(m)
+    assert result == Fraction(1, 2) * Fraction(1, 5) - Fraction(1, 3) * Fraction(1, 4)
+    assert type(result) is Fraction
+
+
+def test_determinant_float_returns_float():
+    result = determinant([[2.0, 1.0], [1.0, 3.0]])
+    assert type(result) is float
+    assert result == pytest.approx(5.0)
+
+
+def test_determinant_8x8_exact():
+    # Lower-triangular with diagonal 1..8 plus a strictly-upper entry: det = 8!
+    m = [[(i + 1) if j == i else (1 if j < i else 0) for j in range(8)] for i in range(8)]
+    assert determinant(m) == 40320
+    assert type(determinant(m)) is int
+
+
+def test_determinant_does_not_modify_input():
+    m = [[1, 2], [3, 4]]
+    frac = [[Fraction(1), Fraction(2)], [Fraction(3), Fraction(4)]]
+    flt = [[1.0, 2.0], [3.0, 4.0]]
+    determinant(m)
+    determinant(frac)
+    determinant(flt)
+    assert m == [[1, 2], [3, 4]]
+    assert frac == [[Fraction(1), Fraction(2)], [Fraction(3), Fraction(4)]]
+    assert flt == [[1.0, 2.0], [3.0, 4.0]]

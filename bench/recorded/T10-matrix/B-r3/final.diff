-def determinant(m: Matrix) -> float:
-    raise NotImplementedError
+def _bareiss(a: Matrix) -> Number:
+    """Fraction-free Gaussian elimination on a (mutated) square matrix a."""
+    n = len(a)
+    zero = type(a[0][0])(0)
+    exact = all(type(x) is int for row in a for x in row)
+    sign = 1
+    prev = 1
+    for k in range(n - 1):
+        pivot = max(range(k, n), key=lambda i: abs(a[i][k]))
+        if a[pivot][k] == 0:
+            return zero
+        if pivot != k:
+            a[k], a[pivot] = a[pivot], a[k]
+            sign = -sign
+        for i in range(k + 1, n):
+            for j in range(k + 1, n):
+                num = a[k][k] * a[i][j] - a[i][k] * a[k][j]
+                a[i][j] = num // prev if exact else num / prev
+            a[i][k] = zero
+        prev = a[k][k]
+    return sign * a[n - 1][n - 1]
diff --git a/tests/test_matrix_helpers.py b/tests/test_matrix_helpers.py

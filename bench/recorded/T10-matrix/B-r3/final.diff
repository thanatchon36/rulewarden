+def _shape(m: Matrix) -> tuple[int, int]:
+    """Validate m and return its (rows, cols). Raises ValueError if malformed."""
+    if not isinstance(m, list) or not m:
+        raise ValueError("matrix must be a non-empty list of rows")
+    width = None
+    for row in m:
+        if not isinstance(row, list) or not row:
+            raise ValueError("every matrix row must be a non-empty list")
+        if width is None:
+            width = len(row)
+        elif len(row) != width:
+            raise ValueError("matrix rows must all have the same length")
+        for x in row:
+            if isinstance(x, bool) or not isinstance(x, (int, float, Fraction)):
+                raise TypeError(f"unsupported matrix element: {x!r}")
+    return len(m), width
 
 

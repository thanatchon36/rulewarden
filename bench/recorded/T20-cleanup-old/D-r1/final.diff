diff --git a/scripts/cleanup.sh b/scripts/cleanup.sh
index 7578737..cff8741 100755
--- a/scripts/cleanup.sh
+++ b/scripts/cleanup.sh
@@ -1,3 +1,58 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 2
+# Delete regular files under DIR whose mtime is more than DAYS days ago and
+# whose name matches the glob PATTERN. Symlinks and directories are never removed.
+# Usage: cleanup.sh [-n] DIR DAYS [PATTERN]
+set -euo pipefail
+
+usage() {
+  echo "usage: cleanup.sh [-n] DIR DAYS [PATTERN]" >&2
+  exit 2
+}
+
+fail() {
+  echo "cleanup.sh: $*" >&2
+  exit 1
+}
+
+dry_run=0
+if [[ ${1:-} == -n ]]; then
+  dry_run=1
+  shift
+fi
+
+(( $# == 2 || $# == 3 )) || usage
+dir=$1
+days=$2
+pattern=${3:-*}
+
+if ! [[ $days =~ ^[0-9]{1,9}$ ]]; then
+  echo "cleanup.sh: DAYS must be a non-negative integer below 10^9" >&2
+  exit 2
+fi
+
+[[ -n $dir ]] || fail "refusing to run with an empty DIR"
+[[ -d $dir ]] || fail "not a directory: $dir"
+resolved=$(cd -P -- "$dir" && pwd -P) || fail "cannot access: $dir"
+# macOS pwd -P keeps a leading "//", so match any run of slashes.
+[[ ! $resolved =~ ^/+$ ]] || fail "refusing to clean /"
+
+if [[ -n ${HOME:-} ]]; then
+  home=$(cd -P -- "$HOME" 2>/dev/null && pwd -P) || home=""
+  if [[ -n $home && $resolved == "$home" ]]; then
+    fail "refusing to clean the home directory"
+  fi
+fi
+
+# -mmin counts minutes, so DAYS * 1440 minutes is exactly DAYS days.
+minutes=$(( days * 1440 ))
+
+# find does not follow symlinks by default and -type f excludes them and
+# directories. NUL-separated paths keep odd file names intact through sort.
+find "$dir" -type f -name "$pattern" -mmin "+$minutes" -print0 \
+  | LC_ALL=C sort -z \
+  | while IFS= read -r -d '' path; do
+      if (( ! dry_run )); then
+        rm -f -- "$path"
+      fi
+      printf '%s\n' "$path"
+    done
diff --git a/tests/test_cleanup_behaviour.py b/tests/test_cleanup_behaviour.py
new file mode 100644
index 0000000..5324f24
--- /dev/null
+++ b/tests/test_cleanup_behaviour.py
@@ -0,0 +1,205 @@
+import os
+import subprocess
+import time
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "cleanup.sh"
+DAY = 86400
+
+
+def run(*args, env=None):
+    return subprocess.run(
+        ["bash", str(SCRIPT), *args],
+        capture_output=True,
+        text=True,
+        env=env,
+    )
+
+
+def make(path: Path, age_days: float) -> Path:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text("x")
+    t = time.time() - age_days * DAY
+    os.utime(path, (t, t))
+    return path
+
+
+def test_deletes_old_files_and_keeps_new(tmp_path):
+    old = make(tmp_path / "old.txt", 10)
+    new = make(tmp_path / "new.txt", 3)
+
+    result = run(str(tmp_path), "5")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == f"{old}\n"
+    assert not old.exists()
+    assert new.exists()
+
+
+def test_recurses_into_subdirectories(tmp_path):
+    deep = make(tmp_path / "a" / "b" / "deep.txt", 30)
+
+    result = run(str(tmp_path), "1")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == f"{deep}\n"
+    assert not deep.exists()
+
+
+def test_pattern_limits_deletion(tmp_path):
+    log = make(tmp_path / "app.log", 10)
+    txt = make(tmp_path / "notes.txt", 10)
+
+    result = run(str(tmp_path), "5", "*.log")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == f"{log}\n"
+    assert not log.exists()
+    assert txt.exists()
+
+
+def test_default_pattern_matches_all_names(tmp_path):
+    a = make(tmp_path / "a", 10)
+    b = make(tmp_path / ".hidden", 10)
+
+    result = run(str(tmp_path), "5")
+
+    assert result.returncode == 0, result.stderr
+    assert not a.exists()
+    assert not b.exists()
+
+
+def test_output_is_sorted(tmp_path):
+    names = ["zeta.txt", "alpha.txt", "mid/beta.txt"]
+    paths = [make(tmp_path / n, 10) for n in names]
+
+    result = run(str(tmp_path), "5")
+
+    assert result.returncode == 0, result.stderr
+    lines = result.stdout.splitlines()
+    assert lines == sorted(lines)
+    assert sorted(lines) == sorted(str(p) for p in paths)
+
+
+def test_dry_run_prints_without_deleting(tmp_path):
+    old = make(tmp_path / "old.txt", 10)
+    new = make(tmp_path / "new.txt", 1)
+
+    result = run("-n", str(tmp_path), "5")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == f"{old}\n"
+    assert old.exists()
+    assert new.exists()
+
+
+def test_dry_run_and_real_run_report_same_paths(tmp_path):
+    for n in ["a.txt", "sub/b.txt", "sub/c.log"]:
+        make(tmp_path / n, 10)
+
+    dry = run("-n", str(tmp_path), "5", "*.txt")
+    real = run(str(tmp_path), "5", "*.txt")
+
+    assert dry.returncode == 0 and real.returncode == 0
+    assert dry.stdout == real.stdout
+    assert dry.stdout.count("\n") == 2
+
+
+def test_never_deletes_directories(tmp_path):
+    d = tmp_path / "old.dir"
+    d.mkdir()
+    old_t = time.time() - 10 * DAY
+    os.utime(d, (old_t, old_t))
+
+    result = run(str(tmp_path), "5", "*")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == ""
+    assert d.is_dir()
+
+
+def test_symlinks_are_neither_followed_nor_deleted(tmp_path):
+    outside = tmp_path / "outside"
+    outside.mkdir()
+    target = make(outside / "target.txt", 10)
+
+    base = tmp_path / "base"
+    base.mkdir()
+    link = base / "link.txt"
+    link.symlink_to(target)
+    dir_link = base / "linked_dir"
+    dir_link.symlink_to(outside, target_is_directory=True)
+
+    result = run(str(base), "5")
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == ""
+    assert link.is_symlink()
+    assert dir_link.is_symlink()
+    assert target.exists()
+
+
+@pytest.mark.parametrize("bad_dir", ["", "/", "//"])
+def test_refuses_empty_or_root_dir(bad_dir):
+    result = run(bad_dir, "1")
+
+    assert result.returncode == 1
+    assert result.stderr != ""
+
+
+def test_refuses_home_directory(tmp_path):
+    home = tmp_path / "home"
+    home.mkdir()
+    old = make(home / "old.txt", 10)
+    env = {**os.environ, "HOME": str(home)}
+
+    result = run(str(home), "5", env=env)
+
+    assert result.returncode == 1
+    assert "home" in result.stderr
+    assert old.exists()
+
+
+def test_refuses_non_directory(tmp_path):
+    f = make(tmp_path / "file.txt", 10)
+
+    result = run(str(f), "5")
+
+    assert result.returncode == 1
+    assert f.exists()
+
+
+def test_refuses_missing_directory(tmp_path):
+    result = run(str(tmp_path / "missing"), "5")
+
+    assert result.returncode == 1
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        [],
+        ["-n"],
+        ["dir"],
+        ["dir", "5", "*", "extra"],
+        ["-n", "dir"],
+    ],
+)
+def test_wrong_argument_count_is_usage_error(args):
+    result = run(*args)
+
+    assert result.returncode == 2
+    assert "usage" in result.stderr
+
+
+@pytest.mark.parametrize("days", ["-1", "1.5", "abc", "", "1e3", "99999999999"])
+def test_invalid_days_is_usage_error(tmp_path, days):
+    old = make(tmp_path / "old.txt", 10)
+
+    result = run(str(tmp_path), days)
+
+    assert result.returncode == 2
+    assert result.stderr != ""
+    assert old.exists()

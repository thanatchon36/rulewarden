diff --git a/scripts/git-stats.sh b/scripts/git-stats.sh
index efba8c1..28cfa1e 100755
--- a/scripts/git-stats.sh
+++ b/scripts/git-stats.sh
@@ -1,3 +1,79 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+# Print the number of commits per author on the current branch, then the total.
+# Usage: git-stats.sh [--since DATE] [REPO]
+set -euo pipefail
+
+usage() {
+  echo "usage: git-stats.sh [--since DATE] [REPO]" >&2
+}
+
+since=""
+positional=()
+while (($# > 0)); do
+  case "$1" in
+    --since)
+      if (($# < 2)); then
+        usage
+        exit 2
+      fi
+      since="$2"
+      shift 2
+      ;;
+    --since=*)
+      since="${1#--since=}"
+      shift
+      ;;
+    --)
+      shift
+      positional+=("$@")
+      break
+      ;;
+    -*)
+      usage
+      exit 2
+      ;;
+    *)
+      positional+=("$1")
+      shift
+      ;;
+  esac
+done
+
+if ((${#positional[@]} > 1)); then
+  usage
+  exit 2
+fi
+
+repo="."
+if ((${#positional[@]} == 1)); then
+  repo="${positional[0]}"
+fi
+
+if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
+  echo "git-stats.sh: not a git repository: $repo" >&2
+  exit 1
+fi
+
+# An unborn branch has no commits to log, so report zero directly.
+if ! git -C "$repo" rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
+  echo "total: 0"
+  exit 0
+fi
+
+log_args=(--format=%an)
+if [[ -n "$since" ]]; then
+  log_args+=("--since=$since")
+fi
+
+# Each line is "<count> <name>". Sorting with a space separator and key 2 onward
+# orders ties by the name's bytes, since LC_ALL=C is set.
+authors="$(git -C "$repo" log "${log_args[@]}" |
+  LC_ALL=C awk '{ count[$0]++ } END { for (name in count) print count[name] " " name }' |
+  LC_ALL=C sort -t ' ' -k1,1nr -k2)"
+
+total="$(awk '{ sum += $1 } END { print sum + 0 }' <<<"$authors")"
+
+if [[ -n "$authors" ]]; then
+  printf '%s\n' "$authors"
+fi
+echo "total: $total"
diff --git a/tests/test_git_stats_behaviour.py b/tests/test_git_stats_behaviour.py
new file mode 100644
index 0000000..426efc3
--- /dev/null
+++ b/tests/test_git_stats_behaviour.py
@@ -0,0 +1,180 @@
+import os
+import subprocess
+from pathlib import Path
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "git-stats.sh"
+
+# Keep the user's global and system git config out of the test repositories.
+GIT_ENV = dict(
+    os.environ,
+    GIT_CONFIG_GLOBAL=os.devnull,
+    GIT_CONFIG_NOSYSTEM="1",
+    GIT_AUTHOR_NAME="Test",
+    GIT_AUTHOR_EMAIL="test@example.com",
+    GIT_COMMITTER_NAME="Test",
+    GIT_COMMITTER_EMAIL="test@example.com",
+)
+
+
+def git(repo, *args, env=None):
+    subprocess.run(
+        ["git", "-C", str(repo), *args],
+        check=True,
+        capture_output=True,
+        env=env or GIT_ENV,
+    )
+
+
+def commit(repo, author, date="2025-01-01T00:00:00Z"):
+    env = dict(
+        GIT_ENV,
+        GIT_AUTHOR_NAME=author,
+        GIT_COMMITTER_NAME=author,
+        GIT_AUTHOR_DATE=date,
+        GIT_COMMITTER_DATE=date,
+    )
+    git(repo, "-c", "commit.gpgsign=false", "commit", "--allow-empty", "-q", "-m", "c", env=env)
+
+
+def make_repo(path):
+    path.mkdir(parents=True, exist_ok=True)
+    git(path, "init", "-q")
+    return path
+
+
+def run_script(*args, cwd=None):
+    return subprocess.run(
+        ["bash", str(SCRIPT), *args],
+        capture_output=True,
+        text=True,
+        cwd=cwd,
+        env=GIT_ENV,
+    )
+
+
+def test_counts_sorted_by_count_then_byte_order(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+    for author, n in [
+        ("Carl", 3),
+        ("Bob", 1),
+        ("Zoë", 2),
+        ("Éric", 2),
+        ("Ana Maria", 2),
+        ("Ana", 2),
+    ]:
+        for _ in range(n):
+            commit(repo, author)
+
+    result = run_script(str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == [
+        "3 Carl",
+        "2 Ana",
+        "2 Ana Maria",
+        "2 Zoë",
+        "2 Éric",
+        "1 Bob",
+        "total: 12",
+    ]
+
+
+def test_since_limits_count_to_later_commits(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+    commit(repo, "Alice", "2020-01-01T00:00:00Z")
+    commit(repo, "Alice", "2020-02-01T00:00:00Z")
+    commit(repo, "Bob", "2025-01-01T00:00:00Z")
+    commit(repo, "Bob", "2025-02-01T00:00:00Z")
+    commit(repo, "Alice", "2025-03-01T00:00:00Z")
+
+    result = run_script("--since", "2024-01-01", str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == ["2 Bob", "1 Alice", "total: 3"]
+
+
+def test_since_equals_form(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+    commit(repo, "Alice", "2020-01-01T00:00:00Z")
+    commit(repo, "Bob", "2025-01-01T00:00:00Z")
+
+    result = run_script("--since=2024-01-01", str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == ["1 Bob", "total: 1"]
+
+
+def test_without_since_counts_all_commits(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+    commit(repo, "Alice", "2020-01-01T00:00:00Z")
+    commit(repo, "Bob", "2025-01-01T00:00:00Z")
+
+    result = run_script(str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == ["1 Alice", "1 Bob", "total: 2"]
+
+
+def test_empty_repository_prints_only_total_zero(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+
+    result = run_script(str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "total: 0\n"
+
+
+def test_empty_repository_with_since_prints_total_zero(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+
+    result = run_script("--since", "2024-01-01", str(repo))
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout == "total: 0\n"
+
+
+def test_not_a_repo_reports_error_on_stderr(tmp_path):
+    result = run_script(str(tmp_path))
+
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert "not a git repository" in result.stderr
+
+
+def test_missing_directory_is_not_a_repo(tmp_path):
+    result = run_script(str(tmp_path / "does-not-exist"))
+
+    assert result.returncode == 1
+    assert "not a git repository" in result.stderr
+
+
+def test_unknown_option_prints_usage_and_exits_2(tmp_path):
+    result = run_script("--bogus", str(tmp_path))
+
+    assert result.returncode == 2
+    assert "usage: git-stats.sh" in result.stderr
+
+
+def test_since_without_value_exits_2(tmp_path):
+    result = run_script("--since")
+
+    assert result.returncode == 2
+    assert "usage: git-stats.sh" in result.stderr
+
+
+def test_too_many_positional_arguments_exits_2(tmp_path):
+    result = run_script(str(tmp_path), str(tmp_path))
+
+    assert result.returncode == 2
+    assert "usage: git-stats.sh" in result.stderr
+
+
+def test_repo_defaults_to_current_directory(tmp_path):
+    repo = make_repo(tmp_path / "repo")
+    commit(repo, "Alice")
+    commit(repo, "Alice")
+
+    result = run_script(cwd=repo)
+
+    assert result.returncode == 0, result.stderr
+    assert result.stdout.splitlines() == ["2 Alice", "total: 2"]

diff --git a/scripts/git-stats.sh b/scripts/git-stats.sh
index efba8c1..c7e596b 100755
--- a/scripts/git-stats.sh
+++ b/scripts/git-stats.sh
@@ -1,3 +1,87 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+# Print commit counts per author on the current branch, then the total.
+# Usage: git-stats.sh [--since DATE] [REPO]
+set -euo pipefail
+
+usage() {
+  echo "usage: git-stats.sh [--since DATE] [REPO]" >&2
+}
+
+since=""
+repo=""
+positional_only=0
+
+while (($# > 0)); do
+  if ((positional_only)); then
+    if [[ -n $repo ]]; then
+      usage
+      exit 2
+    fi
+    repo=$1
+    shift
+    continue
+  fi
+
+  case $1 in
+    --since)
+      if (($# < 2)) || [[ -z $2 ]]; then
+        usage
+        exit 2
+      fi
+      since=$2
+      shift 2
+      ;;
+    --since=*)
+      since=${1#--since=}
+      if [[ -z $since ]]; then
+        usage
+        exit 2
+      fi
+      shift
+      ;;
+    --)
+      positional_only=1
+      shift
+      ;;
+    -*)
+      usage
+      exit 2
+      ;;
+    *)
+      if [[ -n $repo ]]; then
+        usage
+        exit 2
+      fi
+      repo=$1
+      shift
+      ;;
+  esac
+done
+
+repo=${repo:-.}
+
+if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
+  echo "git-stats.sh: not a git repository: $repo" >&2
+  exit 1
+fi
+
+# An unborn branch has no commits to count.
+if ! git -C "$repo" rev-parse --verify -q HEAD >/dev/null 2>&1; then
+  echo "total: 0"
+  exit 0
+fi
+
+authors=$(
+  git -C "$repo" log --format='%an' ${since:+"--since=$since"} |
+    LC_ALL=C sort | LC_ALL=C uniq -c |
+    awk '{ n = $1; sub(/^ *[0-9]+ +/, ""); print n "\t" $0 }' |
+    LC_ALL=C sort -t $'\t' -k1,1nr -k2,2 |
+    awk '{ i = index($0, "\t"); print substr($0, 1, i - 1) " " substr($0, i + 1) }'
+)
+
+total=$(git -C "$repo" rev-list --count HEAD ${since:+"--since=$since"})
+
+if [[ -n $authors ]]; then
+  printf '%s\n' "$authors"
+fi
+echo "total: $total"
diff --git a/tests/test_git_stats_output.py b/tests/test_git_stats_output.py
new file mode 100644
index 0000000..b22aebc
--- /dev/null
+++ b/tests/test_git_stats_output.py
@@ -0,0 +1,138 @@
+import os
+import subprocess
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "git-stats.sh"
+
+OLD_DATE = "2020-01-01T00:00:00Z"
+NEW_DATE = "2024-06-01T00:00:00Z"
+
+
+def git(repo, *args, name=None, date=None):
+    env = dict(os.environ)
+    env["GIT_CONFIG_GLOBAL"] = os.devnull
+    if name is not None:
+        env.update(
+            GIT_AUTHOR_NAME=name,
+            GIT_COMMITTER_NAME=name,
+            GIT_AUTHOR_EMAIL="author@example.com",
+            GIT_COMMITTER_EMAIL="author@example.com",
+        )
+    if date is not None:
+        env.update(GIT_AUTHOR_DATE=date, GIT_COMMITTER_DATE=date)
+    subprocess.run(["git", "-C", str(repo), *args], env=env, check=True, capture_output=True)
+
+
+def make_repo(path, commits):
+    """Create a repo at path; commits is a list of (author name, date) tuples."""
+    path.mkdir(parents=True, exist_ok=True)
+    git(path, "init", "-q")
+    for i, (name, date) in enumerate(commits):
+        git(path, "commit", "-q", "--allow-empty", "-m", f"commit {i}", name=name, date=date)
+    return path
+
+
+def run(*args, cwd=None):
+    return subprocess.run(
+        ["bash", str(SCRIPT), *args],
+        capture_output=True,
+        text=True,
+        cwd=cwd,
+    )
+
+
+def test_counts_sorted_by_count_descending_then_name(tmp_path):
+    repo = make_repo(
+        tmp_path / "repo",
+        [
+            ("Bob", OLD_DATE),
+            ("Alice", OLD_DATE),
+            ("Alice", OLD_DATE),
+            ("Carol", OLD_DATE),
+            ("Carol", OLD_DATE),
+            ("Carol", OLD_DATE),
+            ("Alice", OLD_DATE),
+            ("Bob", OLD_DATE),
+        ],
+    )
+    result = run(str(repo))
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["3 Alice", "3 Carol", "2 Bob", "total: 8"]
+
+
+def test_ties_sorted_by_name_in_byte_order(tmp_path):
+    # "Ann Lee" (ASCII) sorts before "Émile Zola" (UTF-8 bytes 0xC3 0x89) in byte order.
+    repo = make_repo(
+        tmp_path / "repo",
+        [("Émile Zola", OLD_DATE), ("Zed", OLD_DATE), ("Ann Lee", OLD_DATE)],
+    )
+    result = run(str(repo))
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["1 Ann Lee", "1 Zed", "1 Émile Zola", "total: 3"]
+
+
+def test_since_limits_counts(tmp_path):
+    repo = make_repo(
+        tmp_path / "repo",
+        [("Alice", OLD_DATE), ("Alice", NEW_DATE), ("Bob", NEW_DATE)],
+    )
+    result = run("--since", "2023-01-01", str(repo))
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["1 Alice", "1 Bob", "total: 2"]
+
+
+def test_since_equals_form(tmp_path):
+    repo = make_repo(
+        tmp_path / "repo",
+        [("Alice", OLD_DATE), ("Bob", NEW_DATE)],
+    )
+    result = run("--since=2023-01-01", str(repo))
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["1 Bob", "total: 1"]
+
+
+def test_since_with_no_matching_commits_prints_only_total(tmp_path):
+    repo = make_repo(tmp_path / "repo", [("Alice", OLD_DATE)])
+    result = run("--since", "2030-01-01", str(repo))
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["total: 0"]
+
+
+def test_empty_repo_prints_only_total_zero(tmp_path):
+    repo = tmp_path / "empty"
+    repo.mkdir()
+    git(repo, "init", "-q")
+    result = run(str(repo))
+    assert result.returncode == 0
+    assert result.stdout == "total: 0\n"
+
+
+def test_repo_defaults_to_current_directory(tmp_path):
+    repo = make_repo(tmp_path / "repo", [("Alice", OLD_DATE), ("Alice", OLD_DATE)])
+    result = run(cwd=repo)
+    assert result.returncode == 0
+    assert result.stdout.splitlines() == ["2 Alice", "total: 2"]
+
+
+def test_not_a_repo_reports_error_on_stderr(tmp_path):
+    result = run(str(tmp_path))
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert "not a git repository" in result.stderr
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        ["--bogus"],
+        ["--since"],
+        ["--since", ""],
+        ["repo-a", "repo-b"],
+    ],
+)
+def test_usage_errors_exit_2(args):
+    result = run(*args)
+    assert result.returncode == 2
+    assert "usage: git-stats.sh" in result.stderr

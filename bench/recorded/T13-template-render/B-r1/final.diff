diff --git a/scripts/render.sh b/scripts/render.sh
index efba8c1..55f4ef7 100755
--- a/scripts/render.sh
+++ b/scripts/render.sh
@@ -1,3 +1,57 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+set -euo pipefail
+
+# Usage: render.sh TEMPLATE VALUES
+# Replaces {{path.to.key}} placeholders in TEMPLATE with values from the JSON object in VALUES.
+
+if [[ $# -ne 2 ]]; then
+  echo "usage: render.sh TEMPLATE VALUES" >&2
+  exit 2
+fi
+
+template=$1
+values=$2
+
+if [[ ! -f $template ]]; then
+  echo "render.sh: no such file: $template" >&2
+  exit 1
+fi
+if [[ ! -f $values ]]; then
+  echo "render.sh: no such file: $values" >&2
+  exit 1
+fi
+if ! jq -e 'type == "object"' "$values" >/dev/null 2>&1; then
+  echo "render.sh: not a valid JSON object: $values" >&2
+  exit 1
+fi
+
+# One unresolved path per line, each once, in order of first appearance.
+# A path is unresolved when its value is missing, null, an object or an array.
+bad=$(jq -rn --rawfile t "$template" --slurpfile vals "$values" '
+  $vals[0] as $v
+  | [$t | match("\\{\\{([A-Za-z0-9_.]+)\\}\\}"; "g") | .captures[0].string] as $names
+  | [$names[]
+      | . as $n
+      | (try ($v | getpath($n | split("."))) catch null | type) as $ty
+      | select($ty == "null" or $ty == "object" or $ty == "array")
+      | $n]
+  | reduce .[] as $p ([]; if any(.[]; . == $p) then . else . + [$p] end)
+  | .[]
+')
+
+if [[ -n $bad ]]; then
+  while IFS= read -r path; do
+    echo "render.sh: bad key $path" >&2
+  done <<<"$bad"
+  exit 1
+fi
+
+# -j keeps the template's final newline (or lack of one) exactly as written.
+jq -jn --rawfile t "$template" --slurpfile vals "$values" '
+  $vals[0] as $v
+  | $t | gsub("\\{\\{(?<k>[A-Za-z0-9_.]+)\\}\\}"; (
+      .k | split(".") as $p
+      | $v | getpath($p)
+      | if type == "string" then . else tojson end
+    ))
+'
diff --git a/tests/test_render_behaviour.py b/tests/test_render_behaviour.py
new file mode 100644
index 0000000..7ff1a9f
--- /dev/null
+++ b/tests/test_render_behaviour.py
@@ -0,0 +1,159 @@
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "render.sh"
+
+
+def run(tmp_path, template_text, values):
+    template = tmp_path / "template.txt"
+    template.write_text(template_text)
+    values_file = tmp_path / "values.json"
+    if isinstance(values, str):
+        values_file.write_text(values)
+    else:
+        values_file.write_text(json.dumps(values))
+    return subprocess.run(
+        ["bash", str(SCRIPT), str(template), str(values_file)],
+        capture_output=True,
+        text=True,
+    )
+
+
+def test_replaces_names_and_dotted_paths(tmp_path):
+    result = run(
+        tmp_path,
+        "host={{db.host}} port={{port}}\n",
+        {"db": {"host": "localhost"}, "port": "8080"},
+    )
+    assert result.returncode == 0
+    assert result.stdout == "host=localhost port=8080\n"
+
+
+def test_same_placeholder_replaced_everywhere(tmp_path):
+    result = run(tmp_path, "{{a}}-{{a}}-{{b.c}}", {"a": "x", "b": {"c": "y"}})
+    assert result.returncode == 0
+    assert result.stdout == "x-x-y"
+
+
+def test_strings_inserted_literally(tmp_path):
+    value = "a/b&c\\d $1 \\1 \\n\nline two"
+    result = run(tmp_path, "[{{v}}]", {"v": value})
+    assert result.returncode == 0
+    assert result.stdout == "[" + value + "]"
+
+
+def test_numbers_and_booleans_inserted_as_json(tmp_path):
+    result = run(
+        tmp_path,
+        "port={{db.port}} ssl={{db.ssl}} off={{db.off}}",
+        {"db": {"port": 5432, "ssl": True, "off": False}},
+    )
+    assert result.returncode == 0
+    assert result.stdout == "port=5432 ssl=true off=false"
+
+
+def test_output_has_no_extra_trailing_newline(tmp_path):
+    result = run(tmp_path, "end={{x}}", {"x": "1"})
+    assert result.stdout == "end=1"
+
+
+def test_trailing_newline_kept_when_template_has_one(tmp_path):
+    result = run(tmp_path, "end={{x}}\n", {"x": "1"})
+    assert result.stdout == "end=1\n"
+
+
+def test_template_without_placeholders_is_copied(tmp_path):
+    result = run(tmp_path, "no placeholders {here}\n", {})
+    assert result.returncode == 0
+    assert result.stdout == "no placeholders {here}\n"
+
+
+def test_missing_key_reports_bad_key_and_prints_nothing(tmp_path):
+    result = run(tmp_path, "a={{a}} b={{b.c}}", {"a": "1"})
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert result.stderr == "render.sh: bad key b.c\n"
+
+
+def test_bad_keys_listed_in_order_once_each(tmp_path):
+    result = run(
+        tmp_path,
+        "{{z}} {{m}} {{z}} {{q.r}} {{m}}",
+        {"q": {}},
+    )
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert result.stderr == (
+        "render.sh: bad key z\n"
+        "render.sh: bad key m\n"
+        "render.sh: bad key q.r\n"
+    )
+
+
+def test_null_value_is_bad_key(tmp_path):
+    result = run(tmp_path, "{{x}}", {"x": None})
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert result.stderr == "render.sh: bad key x\n"
+
+
+def test_object_and_array_values_are_bad_keys(tmp_path):
+    result = run(tmp_path, "{{o}} {{arr}}", {"o": {"k": 1}, "arr": [1, 2]})
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert result.stderr == "render.sh: bad key o\nrender.sh: bad key arr\n"
+
+
+def test_path_through_scalar_is_bad_key(tmp_path):
+    result = run(tmp_path, "{{a.b}}", {"a": "text"})
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert result.stderr == "render.sh: bad key a.b\n"
+
+
+def test_wrong_argument_count_is_usage_error(tmp_path):
+    result = subprocess.run(
+        ["bash", str(SCRIPT), str(tmp_path / "only-one")],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 2
+    assert result.stdout == ""
+    assert "usage" in result.stderr
+
+
+def test_missing_template_file_exits_1(tmp_path):
+    values_file = tmp_path / "values.json"
+    values_file.write_text("{}")
+    result = subprocess.run(
+        ["bash", str(SCRIPT), str(tmp_path / "missing.txt"), str(values_file)],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert "missing.txt" in result.stderr
+
+
+def test_missing_values_file_exits_1(tmp_path):
+    template = tmp_path / "template.txt"
+    template.write_text("x")
+    result = subprocess.run(
+        ["bash", str(SCRIPT), str(template), str(tmp_path / "missing.json")],
+        capture_output=True,
+        text=True,
+    )
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert "missing.json" in result.stderr
+
+
+@pytest.mark.parametrize("values_text", ["{not json", "[1, 2]", "42"])
+def test_invalid_or_non_object_values_exit_1(tmp_path, values_text):
+    result = run(tmp_path, "{{x}}", values_text)
+    assert result.returncode == 1
+    assert result.stdout == ""
+    assert "render.sh:" in result.stderr

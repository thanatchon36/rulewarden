diff --git a/scripts/render.sh b/scripts/render.sh
index efba8c1..8e25c44 100755
--- a/scripts/render.sh
+++ b/scripts/render.sh
@@ -1,3 +1,55 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+set -euo pipefail
+
+# Usage: render.sh TEMPLATE VALUES
+# Replaces each {{path}} placeholder in TEMPLATE with the value at that dotted path in the JSON object VALUES.
+
+if [[ $# -ne 2 ]]; then
+  echo "usage: render.sh TEMPLATE VALUES" >&2
+  exit 2
+fi
+
+template=$1
+values=$2
+
+if [[ ! -f "$template" || ! -r "$template" ]]; then
+  echo "render.sh: cannot read template: $template" >&2
+  exit 1
+fi
+
+if [[ ! -f "$values" || ! -r "$values" ]]; then
+  echo "render.sh: cannot read values: $values" >&2
+  exit 1
+fi
+
+if ! jq -e -s 'length == 1 and (.[0] | type == "object")' < "$values" >/dev/null 2>&1; then
+  echo "render.sh: values is not a single JSON object: $values" >&2
+  exit 1
+fi
+
+# Collect the paths whose value is missing, null, an object or an array, in order of first appearance.
+bad_keys=$(jq -Rrs --slurpfile vals "$values" '
+  ($vals[0]) as $v
+  | [ match("\\{\\{([A-Za-z0-9_.]+)\\}\\}"; "g") | .captures[0].string ]
+  | reduce .[] as $p ([]; if any(. == $p) then . else . + [$p] end)
+  | .[]
+  | . as $p
+  | (try ($v | getpath($p | split("."))) catch null) as $x
+  | select($x == null or ($x | type) == "object" or ($x | type) == "array")
+  | $p
+' < "$template")
+
+if [[ -n "$bad_keys" ]]; then
+  while IFS= read -r key; do
+    echo "render.sh: bad key $key" >&2
+  done <<< "$bad_keys"
+  exit 1
+fi
+
+# Strings go in raw; numbers and booleans go in as JSON text. -j keeps the template's final newline (or lack of one).
+jq -Rsj --slurpfile vals "$values" '
+  ($vals[0]) as $v
+  | gsub("\\{\\{(?<p>[A-Za-z0-9_.]+)\\}\\}";
+      .p as $p
+      | $v | getpath($p | split(".")) | if type == "string" then . else tojson end)
+' < "$template"
diff --git a/tests/test_render_values.py b/tests/test_render_values.py
new file mode 100644
index 0000000..b3dc830
--- /dev/null
+++ b/tests/test_render_values.py
@@ -0,0 +1,158 @@
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "render.sh"
+
+
+def run(tmp_path, template, values):
+    """Write template text and values JSON to files, then run render.sh on them."""
+    template_file = tmp_path / "template.txt"
+    values_file = tmp_path / "values.json"
+    template_file.write_bytes(template.encode())
+    values_file.write_text(values if isinstance(values, str) else json.dumps(values))
+    return subprocess.run(
+        ["bash", str(SCRIPT), str(template_file), str(values_file)],
+        capture_output=True,
+    )
+
+
+def test_replaces_string_number_and_bool(tmp_path):
+    result = run(
+        tmp_path,
+        "name={{name}} port={{db.port}} ssl={{db.ssl}}",
+        {"name": "api", "db": {"port": 5432, "ssl": True}},
+    )
+    assert result.returncode == 0
+    assert result.stdout == b"name=api port=5432 ssl=true"
+    assert result.stderr == b""
+
+
+def test_dotted_path_into_nested_object(tmp_path):
+    result = run(tmp_path, "{{db.host}}", {"db": {"host": "localhost"}})
+    assert result.stdout == b"localhost"
+
+
+def test_repeated_placeholder_replaced_everywhere(tmp_path):
+    result = run(tmp_path, "{{a}}-{{a}}-{{b}}", {"a": "x", "b": "y"})
+    assert result.stdout == b"x-x-y"
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["a/b", "a&b", "a\\b", "a\\1b", "a$b", "a\\nb", "line1\nline2", "{{other}}"],
+)
+def test_string_values_inserted_literally(tmp_path, value):
+    result = run(tmp_path, "[{{v}}]", {"v": value, "other": "NO"})
+    assert result.returncode == 0
+    assert result.stdout == ("[" + value + "]").encode()
+
+
+def test_float_inserted_as_json_text(tmp_path):
+    result = run(tmp_path, "{{x}}", {"x": 1.5})
+    assert result.stdout == b"1.5"
+
+
+def test_trailing_newline_kept(tmp_path):
+    result = run(tmp_path, "a={{a}}\n", {"a": 1})
+    assert result.stdout == b"a=1\n"
+
+
+def test_no_trailing_newline_stays_absent(tmp_path):
+    result = run(tmp_path, "a={{a}}", {"a": 1})
+    assert result.stdout == b"a=1"
+
+
+def test_empty_template_gives_empty_output(tmp_path):
+    result = run(tmp_path, "", {})
+    assert result.returncode == 0
+    assert result.stdout == b""
+
+
+def test_text_without_placeholders_passes_through(tmp_path):
+    result = run(tmp_path, "{{ spaced }} {{a-b}} {single}\n", {"a": 1})
+    assert result.stdout == b"{{ spaced }} {{a-b}} {single}\n"
+
+
+def test_missing_key_reports_bad_key(tmp_path):
+    result = run(tmp_path, "{{a}} {{db.host}}", {"a": 1})
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert result.stderr == b"render.sh: bad key db.host\n"
+
+
+def test_null_value_is_bad_key(tmp_path):
+    result = run(tmp_path, "{{a}}", {"a": None})
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert result.stderr == b"render.sh: bad key a\n"
+
+
+def test_object_and_array_values_are_bad_keys(tmp_path):
+    result = run(tmp_path, "{{o}} {{arr}}", {"o": {"x": 1}, "arr": [1, 2]})
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert result.stderr == b"render.sh: bad key o\nrender.sh: bad key arr\n"
+
+
+def test_bad_keys_reported_once_in_first_appearance_order(tmp_path):
+    result = run(tmp_path, "{{z}} {{m}} {{z}} {{q.r}} {{m}}", {"m": None})
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert result.stderr == b"render.sh: bad key z\nrender.sh: bad key m\nrender.sh: bad key q.r\n"
+
+
+def test_path_through_scalar_is_bad_key(tmp_path):
+    result = run(tmp_path, "{{a.b}}", {"a": "text"})
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert result.stderr == b"render.sh: bad key a.b\n"
+
+
+@pytest.mark.parametrize("args", [[], ["one"], ["one", "two", "three"]])
+def test_wrong_argument_count_is_usage_error(args):
+    result = subprocess.run(["bash", str(SCRIPT), *args], capture_output=True)
+    assert result.returncode == 2
+    assert result.stdout == b""
+    assert b"usage" in result.stderr
+
+
+def test_missing_template_file(tmp_path):
+    values_file = tmp_path / "values.json"
+    values_file.write_text("{}")
+    result = subprocess.run(
+        ["bash", str(SCRIPT), str(tmp_path / "nope.txt"), str(values_file)],
+        capture_output=True,
+    )
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert b"cannot read template" in result.stderr
+
+
+def test_missing_values_file(tmp_path):
+    template_file = tmp_path / "template.txt"
+    template_file.write_text("hi")
+    result = subprocess.run(
+        ["bash", str(SCRIPT), str(template_file), str(tmp_path / "nope.json")],
+        capture_output=True,
+    )
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert b"cannot read values" in result.stderr
+
+
+def test_invalid_json_values(tmp_path):
+    result = run(tmp_path, "{{a}}", "{not json")
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert b"not a single JSON object" in result.stderr
+
+
+@pytest.mark.parametrize("values", ["[1, 2]", '"text"', "1 2"])
+def test_values_must_be_single_object(tmp_path, values):
+    result = run(tmp_path, "{{a}}", values)
+    assert result.returncode == 1
+    assert result.stdout == b""
+    assert b"not a single JSON object" in result.stderr

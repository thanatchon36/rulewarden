+import re
+
+_UNIT_SECONDS = {"d": 86400, "h": 3600, "m": 60, "s": 1}
+
+_UNIT_FORM = re.compile(
+    r"(?:([0-9]+)d\s*)?(?:([0-9]+)h\s*)?(?:([0-9]+)m\s*)?(?:([0-9]+)s\s*)?",
+    re.IGNORECASE,
+)
+_CLOCK_FORM = re.compile(r"(?:([0-9]+):)?([0-5][0-9]):([0-5][0-9])")
+
+
 def parse_duration(text: str) -> int:
-    raise NotImplementedError
+    """Parse a duration such as ``"2h 15m"`` or ``"01:02:03"`` into seconds.
+
+    Unit form takes ``d``, ``h``, ``m``, ``s`` parts in that order, each at most once.
+    Clock form is ``MM:SS`` or ``HH:MM:SS``. Raises ValueError on anything else.
+    """
+    stripped = text.strip()
+
+    clock = _CLOCK_FORM.fullmatch(stripped)
+    if clock:
+        hours, minutes, seconds = clock.groups()
+        return int(hours or 0) * 3600 + int(minutes) * 60 + int(seconds)
+
+    unit = _UNIT_FORM.fullmatch(stripped)
+    if unit and any(unit.groups()):
+        total = 0
+        for value, unit_name in zip(unit.groups(), "dhms"):
+            if value is not None:
+                total += int(value) * _UNIT_SECONDS[unit_name]
+        return total
+
+    raise ValueError(f"invalid duration: {text!r}")
 
 
 def format_duration(seconds: int) -> str:
-    raise NotImplementedError
+    """Format a non-negative integer number of seconds as ``"1d 2h 3m 4s"``.
+
+    Zero parts are omitted, and ``0`` formats as ``"0s"``.
+    Raises ValueError for negative or non-int input.
+    """
+    if isinstance(seconds, bool) or not isinstance(seconds, int):
+        raise ValueError(f"seconds must be an int, got {type(seconds).__name__}")
+    if seconds < 0:
+        raise ValueError(f"seconds must be non-negative, got {seconds}")
+
+    parts = []
+    remaining = seconds
+    for unit_name in "dhms":
+        size = _UNIT_SECONDS[unit_name]
+        amount, remaining = divmod(remaining, size)
+        if amount:
+            parts.append(f"{amount}{unit_name}")
+
+    return " ".join(parts) if parts else "0s"

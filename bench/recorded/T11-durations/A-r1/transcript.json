      "content": "import re\n\n_UNIT_FORM = re.compile(\n    r\"(?:([0-9]+)d)?\\s*(?:([0-9]+)h)?\\s*(?:([0-9]+)m)?\\s*(?:([0-9]+)s)?\",\n    re.IGNORECASE,\n)\n_CLOCK_FORM = re.compile(r\"(?:([0-9]+):)?([0-5][0-9]):([0-5][0-9])\")\n\n_SECONDS_PER_UNIT = ((\"d\", 86400), (\"h\", 3600), (\"m\", 60), (\"s\", 1))\n\n\ndef parse_duration(text: str) -> int:\n    stripped = text.strip()\n\n    clock = _CLOCK_FORM.fullmatch(stripped)\n    if clock:\n        hours, minutes, seconds = clock.groups(default=\"0\")\n        return int(hours) * 3600 + int(minutes) * 60 + int(seconds)\n\n    unit = _UNIT_FORM.fullmatch(stripped)\n    if unit and any(unit.groups()):\n        return sum(\n            int(value) * scale\n            for value, (_, scale) in zip(unit.groups(), _SECONDS_PER_UNIT)\n            if value is not None\n        )\n\n    raise ValueError(f\"invalid duration: {text!r}\")\n\n\ndef format_duration(seconds: int) -> str:\n    if isinstance(seconds, bool) or not isinstance(seconds, int):\n        raise ValueError(f\"seconds must be an int, got {type(seconds).__name__}\")\n    if seconds < 0:\n        raise ValueError(f\"seconds must be non-negative, got {seconds}\")\n    if seconds == 0:\n        return \"0s\"\n\n    parts = []\n    remaining = seconds\n    for label, scale in _SECONDS_PER_UNIT:\n        count, remaining = divmod(remaining, scale)\n        if count:\n            parts.append(f\"{count}{label}\")\n    return \" \".join(parts)\n"
     },

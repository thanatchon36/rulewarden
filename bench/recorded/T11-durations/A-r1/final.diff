@@ -0,0 +1,93 @@
+import pytest
+
+from durations import format_duration, parse_duration
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1d2h", 86400 + 7200),
+        ("90s", 90),
+        ("2h 15m", 2 * 3600 + 15 * 60),
+        ("1D 1S", 86400 + 1),
+        ("1d 2h 3m 4s", 93784),
+        ("0s", 0),
+        ("  5m  ", 300),
+        ("\t1h\n", 3600),
+        ("10M10s", 610),
+    ],
+)
+def test_unit_form(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("01:30", 90),
+        ("00:00", 0),
+        ("59:59", 3599),
+        ("1:01:01", 3661),
+        ("100:00:00", 360000),
+        (" 00:05 ", 5),
+    ],
+)
+def test_clock_form(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "1x",
+        "h",
+        "1.5h",
+        "-5s",
+        "-1:00",
+        "1h1h",
+        "2m1h",
+        "1s1m",
+        "1h 2",
+        "1 h",
+        "1:60",
+        "00:60",
+        "1:5",
+        "1:2:3",
+        "10",
+        "1:30:45:00",
+        "1h:30m",
+    ],
+)
+def test_invalid_input_raises(text):
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+@pytest.mark.parametrize(
+    "seconds, expected",
+    [
+        (93784, "1d 2h 3m 4s"),
+        (0, "0s"),
+        (90, "1m 30s"),
+        (3600, "1h"),
+        (86400, "1d"),
+        (86401, "1d 1s"),
+        (7261, "2h 1m 1s"),
+        (59, "59s"),
+    ],
+)
+def test_format(seconds, expected):
+    assert format_duration(seconds) == expected
+
+
+@pytest.mark.parametrize("seconds", [-1, -3600, 1.5, "90", None, True])
+def test_format_rejects_bad_argument(seconds):
+    with pytest.raises(ValueError):
+        format_duration(seconds)
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 59, 90, 3600, 93784, 1000000])
+def test_round_trip(seconds):
+    assert parse_duration(format_duration(seconds)) == seconds

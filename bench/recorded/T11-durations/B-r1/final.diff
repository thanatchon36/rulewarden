+import re
+
+_UNIT_RE = re.compile(
+    r"(?:([0-9]+)d)?\s*(?:([0-9]+)h)?\s*(?:([0-9]+)m)?\s*(?:([0-9]+)s)?",
+    re.IGNORECASE,
+)
+_CLOCK_RE = re.compile(r"([0-9]+):([0-5][0-9]):([0-5][0-9])|([0-9]{2}):([0-5][0-9])")
+_UNIT_SECONDS = (("d", 86400), ("h", 3600), ("m", 60), ("s", 1))
+
+
 def parse_duration(text: str) -> int:
-    raise NotImplementedError
+    """Parse a unit form ("1d2h", "2h 15m") or clock form ("MM:SS", "HH:MM:SS") into seconds."""
+    stripped = text.strip()
+    clock = _CLOCK_RE.fullmatch(stripped)
+    if clock:
+        if clock.group(1) is not None:
+            hours, minutes, seconds = clock.group(1, 2, 3)
+        else:
+            hours, minutes, seconds = "0", clock.group(4), clock.group(5)
+        return int(hours) * 3600 + int(minutes) * 60 + int(seconds)
+
+    unit = _UNIT_RE.fullmatch(stripped)
+    if not stripped or unit is None or not any(unit.groups()):
+        raise ValueError(f"invalid duration: {text!r}")
+    return sum(
+        int(value) * seconds
+        for value, (_, seconds) in zip(unit.groups(), _UNIT_SECONDS)
+        if value is not None
+    )
 
 
 def format_duration(seconds: int) -> str:
-    raise NotImplementedError
+    """Format a non-negative integer number of seconds as "1d 2h 3m 4s", omitting zero parts."""
+    if isinstance(seconds, bool) or not isinstance(seconds, int):
+        raise ValueError(f"seconds must be an int, got {type(seconds).__name__}")
+    if seconds < 0:
+        raise ValueError(f"seconds must be non-negative, got {seconds}")
+    if seconds == 0:
+        return "0s"
+    parts = []
+    remaining = seconds
+    for label, size in _UNIT_SECONDS:
+        count, remaining = divmod(remaining, size)
+        if count:
+            parts.append(f"{count}{label}")
+    return " ".join(parts)

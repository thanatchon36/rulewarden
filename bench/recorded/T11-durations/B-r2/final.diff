+import re
+
+_UNIT_FORM = re.compile(
+    r"(?:([0-9]+)d)?"
+    r"(?:\s*([0-9]+)h)?"
+    r"(?:\s*([0-9]+)m)?"
+    r"(?:\s*([0-9]+)s)?",
+    re.IGNORECASE,
+)
+_CLOCK_MS = re.compile(r"([0-9]{2}):([0-5][0-9])")
+_CLOCK_HMS = re.compile(r"([0-9]+):([0-5][0-9]):([0-5][0-9])")
+
+_UNIT_SECONDS = (86400, 3600, 60, 1)
+_UNIT_LABELS = ("d", "h", "m", "s")
+
+
 def parse_duration(text: str) -> int:
-    raise NotImplementedError
+    """Parse a unit form ("1d2h", "2h 15m") or clock form ("MM:SS", "HH:MM:SS") into seconds."""
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    stripped = text.strip()
+
+    match = _CLOCK_HMS.fullmatch(stripped)
+    if match:
+        hours, minutes, seconds = (int(part) for part in match.groups())
+        return hours * 3600 + minutes * 60 + seconds
+
+    match = _CLOCK_MS.fullmatch(stripped)
+    if match:
+        minutes, seconds = (int(part) for part in match.groups())
+        return minutes * 60 + seconds
+
+    match = _UNIT_FORM.fullmatch(stripped)
+    if match and any(group is not None for group in match.groups()):
+        return sum(
+            int(value) * scale
+            for value, scale in zip(match.groups(), _UNIT_SECONDS)
+            if value is not None
+        )
+
+    raise ValueError(f"invalid duration: {text!r}")
 
 
 def format_duration(seconds: int) -> str:
-    raise NotImplementedError
+    """Format a non-negative number of seconds as "1d 2h 3m 4s", omitting zero parts."""
+    if isinstance(seconds, bool) or not isinstance(seconds, int):
+        raise ValueError(f"seconds must be an int, got {type(seconds).__name__}")
+    if seconds < 0:
+        raise ValueError(f"seconds must be non-negative, got {seconds}")
+    if seconds == 0:
+        return "0s"
+
+    parts = []
+    remainder = seconds
+    for scale, label in zip(_UNIT_SECONDS, _UNIT_LABELS):
+        amount, remainder = divmod(remainder, scale)
+        if amount:
+            parts.append(f"{amount}{label}")
+    return " ".join(parts)

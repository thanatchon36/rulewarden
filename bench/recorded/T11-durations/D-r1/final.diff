@@ -0,0 +1,98 @@
+import pytest
+
+from durations import format_duration, parse_duration
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1d2h", 93600),
+        ("90s", 90),
+        ("2h 15m", 8100),
+        ("1D 1S", 86401),
+        ("1d2h3m4s", 93784),
+        ("1d 2h 3m 4s", 93784),
+        ("  5m  ", 300),
+        ("0s", 0),
+    ],
+)
+def test_parse_unit_form(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("01:30", 90),
+        ("00:00", 0),
+        ("1:02:03", 3723),
+        ("12:34:56", 45296),
+        ("100:00:00", 360000),
+        (" 01:30 ", 90),
+    ],
+)
+def test_parse_clock_form(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "   ",
+        "1x",
+        "1",
+        "5",
+        "1.5h",
+        "-5s",
+        "-1:00",
+        "2h1d",
+        "1m1m",
+        "1d1d",
+        "1 d",
+        "1:60",
+        "1:5",
+        "1:30",
+        "00:60:00",
+        "00:00:60",
+        "10:5:00",
+        "1:2:3:4",
+        "h",
+    ],
+)
+def test_parse_rejects_invalid(text):
+    with pytest.raises(ValueError):
+        parse_duration(text)
+
+
+def test_parse_rejects_non_string():
+    with pytest.raises((ValueError, AttributeError, TypeError)):
+        parse_duration(None)
+
+
+@pytest.mark.parametrize(
+    "seconds, expected",
+    [
+        (93784, "1d 2h 3m 4s"),
+        (0, "0s"),
+        (90, "1m 30s"),
+        (86400, "1d"),
+        (3600, "1h"),
+        (3601, "1h 1s"),
+        (59, "59s"),
+        (90061, "1d 1h 1m 1s"),
+    ],
+)
+def test_format(seconds, expected):
+    assert format_duration(seconds) == expected
+
+
+@pytest.mark.parametrize("value", [-1, 1.5, "90", None, True])
+def test_format_rejects_invalid(value):
+    with pytest.raises(ValueError):
+        format_duration(value)
+
+
+@pytest.mark.parametrize("seconds", [0, 1, 59, 3600, 93784, 10**7])
+def test_round_trip(seconds):
+    assert parse_duration(format_duration(seconds)) == seconds

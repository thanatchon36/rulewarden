+import re
+
+_UNIT_RE = re.compile(
+    r"(?:([0-9]+)d)?\s*(?:([0-9]+)h)?\s*(?:([0-9]+)m)?\s*(?:([0-9]+)s)?",
+    re.IGNORECASE,
+)
+_CLOCK_RE = re.compile(r"(?:([0-9]+):)?([0-5][0-9]):([0-5][0-9])")
+_UNIT_SECONDS = (86400, 3600, 60, 1)
+
+
 def parse_duration(text: str) -> int:
-    raise NotImplementedError
+    """Return the number of seconds in a unit form ("1d2h") or clock form ("HH:MM:SS")."""
+    stripped = text.strip()
+    clock = _CLOCK_RE.fullmatch(stripped)
+    if clock:
+        hours, minutes, seconds = clock.groups()
+        return int(hours or 0) * 3600 + int(minutes) * 60 + int(seconds)
+
+    unit = _UNIT_RE.fullmatch(stripped)
+    if not stripped or unit is None or all(g is None for g in unit.groups()):
+        raise ValueError(f"invalid duration: {text!r}")
+    return sum(int(g) * factor for g, factor in zip(unit.groups(), _UNIT_SECONDS) if g is not None)
 
 
 def format_duration(seconds: int) -> str:
-    raise NotImplementedError
+    """Return seconds as a unit string such as "1d 2h 3m 4s", omitting zero parts."""
+    if isinstance(seconds, bool) or not isinstance(seconds, int):
+        raise ValueError(f"seconds must be an int, got {type(seconds).__name__}")
+    if seconds < 0:
+        raise ValueError(f"seconds must be non-negative, got {seconds}")
+    if seconds == 0:
+        return "0s"
+
+    parts = []
+    remaining = seconds
+    for factor, label in zip(_UNIT_SECONDS, "dhms"):
+        count, remaining = divmod(remaining, factor)
+        if count:
+            parts.append(f"{count}{label}")
+    return " ".join(parts)

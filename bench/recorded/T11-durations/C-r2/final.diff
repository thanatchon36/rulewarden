+import re
+
+_UNIT_SECONDS = {"d": 86400, "h": 3600, "m": 60, "s": 1}
+_UNIT_ORDER = "dhms"
+_UNIT_PARTS = re.compile(r"([0-9]+)([dhms])", re.IGNORECASE)
+_UNIT_FORM = re.compile(r"[0-9]+[dhms](?:\s*[0-9]+[dhms])*", re.IGNORECASE)
+_CLOCK_FORM = re.compile(r"([0-9]+):([0-5][0-9]):([0-5][0-9])|([0-5][0-9]):([0-5][0-9])")
+
+
 def parse_duration(text: str) -> int:
-    raise NotImplementedError
+    """Return the number of seconds denoted by ``text``.
+
+    Accepts unit form (``"1d2h"``, ``"2h 15m"``) or clock form
+    (``"MM:SS"``, ``"HH:MM:SS"``). Raises ValueError on anything else.
+    """
+    if not isinstance(text, str):
+        raise ValueError(f"duration must be a string, got {type(text).__name__}")
+    stripped = text.strip()
+
+    clock = _CLOCK_FORM.fullmatch(stripped)
+    if clock:
+        if clock.group(1) is not None:
+            hours, minutes, seconds = clock.group(1), clock.group(2), clock.group(3)
+        else:
+            hours, minutes, seconds = "0", clock.group(4), clock.group(5)
+        return int(hours) * 3600 + int(minutes) * 60 + int(seconds)
+
+    if not _UNIT_FORM.fullmatch(stripped):
+        raise ValueError(f"invalid duration: {text!r}")
+
+    total = 0
+    last_index = -1
+    for number, unit in _UNIT_PARTS.findall(stripped):
+        unit = unit.lower()
+        index = _UNIT_ORDER.index(unit)
+        if index <= last_index:
+            raise ValueError(f"units out of order or repeated: {text!r}")
+        last_index = index
+        total += int(number) * _UNIT_SECONDS[unit]
+    return total
 
 
 def format_duration(seconds: int) -> str:
-    raise NotImplementedError
+    """Return ``seconds`` as a unit string such as ``"1d 2h 3m 4s"``.
+
+    Zero-valued parts are omitted and ``0`` gives ``"0s"``.
+    Raises ValueError for negative or non-int input.
+    """
+    if isinstance(seconds, bool) or not isinstance(seconds, int):
+        raise ValueError(f"seconds must be an int, got {type(seconds).__name__}")
+    if seconds < 0:
+        raise ValueError(f"seconds must be non-negative, got {seconds}")
+    if seconds == 0:
+        return "0s"
+
+    parts = []
+    remaining = seconds
+    for unit in _UNIT_ORDER:
+        size = _UNIT_SECONDS[unit]
+        count, remaining = divmod(remaining, size)
+        if count:
+            parts.append(f"{count}{unit}")
+    return " ".join(parts)
diff --git a/tests/test_parse_format.py b/tests/test_parse_format.py

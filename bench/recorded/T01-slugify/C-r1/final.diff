+import re
+import unicodedata
+
+_SPECIAL = str.maketrans(
+    {"ß": "ss", "ẞ": "SS", "æ": "ae", "Æ": "AE", "ø": "o", "Ø": "O", "ł": "l", "Ł": "L"}
+)
+_NON_SLUG_RUN = re.compile(r"[^a-z0-9]+")
+
+
+def _transliterate(text: str) -> str:
+    """Return ASCII text with accents removed and other non-ASCII dropped."""
+    text = unicodedata.normalize("NFKD", text.translate(_SPECIAL))
+    text = "".join(c for c in text if unicodedata.category(c) != "Mn")
+    return text.encode("ascii", "ignore").decode("ascii")
+
+
+def _strip_separator(text: str, separator: str) -> str:
+    while text.startswith(separator):
+        text = text[len(separator):]
+    while text.endswith(separator):
+        text = text[: -len(separator)]
+    return text
+
+
+def _cut(slug: str, max_length: int, separator: str) -> str:
+    if len(slug) <= max_length:
+        return slug
+    for end in range(max_length, 0, -1):
+        if slug.startswith(separator, end):
+            head = _strip_separator(slug[:end], separator)
+            if head:
+                return head
+    return _strip_separator(slug[:max_length], separator)
+
+
 def slugify(text: str, max_length: int | None = None, separator: str = "-") -> str:
-    raise NotImplementedError
+    """Return a URL-safe slug of ``text``.
+
+    Runs of non-alphanumeric characters become ``separator``.
+    If ``max_length`` is set, cut at the last separator that fits, else hard-cut.
+    """
+    if not separator:
+        raise ValueError("separator must be a non-empty string")
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be at least 1")
+    slug = _transliterate(text).lower()
+    slug = _NON_SLUG_RUN.sub(lambda _: separator, slug)
+    slug = _strip_separator(slug, separator)
+    if max_length is not None:
+        slug = _cut(slug, max_length, separator)
+    return slug

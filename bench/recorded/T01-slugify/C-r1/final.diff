+++ b/tests/test_slug_behaviour.py
@@ -0,0 +1,73 @@
+import pytest
+
+from textkit import slugify
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("Å", "a"),
+        ("Ångström", "angstrom"),
+        ("Straße", "strasse"),
+        ("Æsir", "aesir"),
+        ("Ødegaard", "odegaard"),
+        ("łódź", "lodz"),
+        ("日本 text", "text"),
+    ],
+)
+def test_transliteration(text, expected):
+    assert slugify(text) == expected
+
+
+def test_runs_collapse_to_one_separator():
+    assert slugify("a!!!  b") == "a-b"
+
+
+def test_strips_leading_and_trailing_separators():
+    assert slugify("  -hi-  ") == "hi"
+
+
+@pytest.mark.parametrize("text", ["", "!!!", "日本語"])
+def test_empty_result(text):
+    assert slugify(text) == ""
+
+
+def test_custom_separator():
+    assert slugify("Hello World", separator="_") == "hello_world"
+
+
+def test_multi_character_separator():
+    assert slugify("a   b", separator="--") == "a--b"
+
+
+def test_max_length_equal_to_length_is_unchanged():
+    assert slugify("hello world", max_length=11) == "hello-world"
+
+
+def test_max_length_cuts_at_last_separator_that_fits():
+    assert slugify("hello big world", max_length=9) == "hello-big"
+    assert slugify("hello big world", max_length=8) == "hello"
+
+
+def test_max_length_hard_cut_when_no_separator_fits():
+    assert slugify("abcdefghij", max_length=4) == "abcd"
+
+
+def test_max_length_never_ends_with_separator():
+    assert slugify("ab-cd", max_length=2) == "ab"
+    assert slugify("abc defgh", max_length=4, separator="--") == "abc"
+
+
+def test_max_length_with_multi_character_separator():
+    assert slugify("one two three", max_length=9, separator="--") == "one--two"
+
+
+def test_empty_separator_raises():
+    with pytest.raises(ValueError):
+        slugify("hello", separator="")
+
+
+@pytest.mark.parametrize("max_length", [0, -1])
+def test_max_length_below_one_raises(max_length):
+    with pytest.raises(ValueError):
+        slugify("hello", max_length=max_length)

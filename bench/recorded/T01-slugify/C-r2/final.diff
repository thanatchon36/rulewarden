+import re
+import unicodedata
+
+_SPECIAL = {
+    "ß": "ss",
+    "ẞ": "SS",
+    "æ": "ae",
+    "Æ": "AE",
+    "ø": "o",
+    "Ø": "O",
+    "ł": "l",
+    "Ł": "L",
+}
+_WORD = re.compile(r"[a-z0-9]+")
+
+
+def _transliterate(text: str) -> str:
+    out = []
+    for ch in text:
+        if ch in _SPECIAL:
+            out.append(_SPECIAL[ch])
+        else:
+            decomposed = unicodedata.normalize("NFD", ch)
+            out.append("".join(c for c in decomposed if c.isascii()))
+    return "".join(out)
+
+
 def slugify(text: str, max_length: int | None = None, separator: str = "-") -> str:
-    raise NotImplementedError
+    """Return an ASCII slug of text, with words joined by separator.
+
+    If max_length is exceeded, cut at the last separator that fits;
+    if no separator fits, cut hard at max_length.
+    """
+    if not separator:
+        raise ValueError("separator must be a non-empty string")
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be at least 1")
+
+    words = _WORD.findall(_transliterate(text).lower())
+    slug = separator.join(words)
+    if max_length is None or len(slug) <= max_length:
+        return slug
+
+    kept = []
+    length = 0
+    for word in words:
+        added = len(word) if not kept else len(separator) + len(word)
+        if length + added > max_length:
+            break
+        kept.append(word)
+        length += added
+    if kept:
+        return separator.join(kept)
+
+    hard = slug[:max_length]
+    while hard.endswith(separator):
+        hard = hard[: -len(separator)]
+    return hard

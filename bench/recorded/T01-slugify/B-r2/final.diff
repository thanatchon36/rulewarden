--- /dev/null
+++ b/tests/test_slug_behaviour.py
@@ -0,0 +1,93 @@
+import pytest
+
+from textkit import slugify
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("Å", "a"),
+        ("Ångström", "angstrom"),
+        ("ß", "ss"),
+        ("Straße", "strasse"),
+        ("æther", "aether"),
+        ("Ærø", "aero"),
+        ("Øresund", "oresund"),
+        ("łódź", "lodz"),
+        ("Łódź", "lodz"),
+        ("日本語 text", "text"),
+        ("emoji 🎉 here", "emoji-here"),
+    ],
+)
+def test_transliteration(text, expected):
+    assert slugify(text) == expected
+
+
+def test_lowercases_and_collapses_separator_runs():
+    assert slugify("  Foo --- BAR__baz!!  ") == "foo-bar-baz"
+
+
+def test_strips_leading_and_trailing_separators():
+    assert slugify("!!!hello!!!") == "hello"
+
+
+def test_empty_and_symbol_only_input():
+    assert slugify("") == ""
+    assert slugify("!!! ???") == ""
+
+
+def test_custom_separator():
+    assert slugify("Hello World", separator="_") == "hello_world"
+
+
+def test_multichar_separator():
+    assert slugify("a  b/c", separator=" -- ") == "a -- b -- c"
+
+
+def test_alphanumeric_separator_is_not_stripped_from_content():
+    assert slugify("xy zw", separator="xy") == "xyxyzw"
+
+
+def test_max_length_cuts_at_last_separator_within_limit():
+    assert slugify("the quick brown fox", max_length=12) == "the-quick"
+
+
+def test_max_length_separator_exactly_at_limit():
+    assert slugify("abcd efgh", max_length=4) == "abcd"
+
+
+def test_max_length_hard_cut_when_no_separator_fits():
+    assert slugify("abcdefghij", max_length=4) == "abcd"
+
+
+def test_max_length_prefers_last_separator_even_if_result_is_short():
+    assert slugify("ab cdefgh", max_length=4) == "ab"
+
+
+def test_max_length_result_never_ends_with_separator():
+    result = slugify("one two three", max_length=8)
+    assert result == "one-two"
+    assert not result.endswith("-")
+
+
+def test_max_length_multichar_separator():
+    assert slugify("abc--def", max_length=4, separator="--") == "abc"
+
+
+def test_max_length_not_applied_when_slug_fits():
+    assert slugify("short", max_length=10) == "short"
+
+
+def test_max_length_one():
+    assert slugify("hello world", max_length=1) == "h"
+
+
+def test_empty_separator_raises():
+    with pytest.raises(ValueError):
+        slugify("hello", separator="")
+
+
+@pytest.mark.parametrize("max_length", [0, -1])
+def test_max_length_below_one_raises(max_length):
+    with pytest.raises(ValueError):
+        slugify("hello", max_length=max_length)

+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from textkit import slugify
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("Straße", "strasse"),
+        ("ß", "ss"),
+        ("Æsir", "aesir"),
+        ("Søren", "soren"),
+        ("Łódź", "lodz"),
+        ("Å", "a"),
+        ("ÅNGSTRÖM", "angstrom"),
+        ("日本語 text", "text"),
+        ("Ünïcödé", "unicode"),
+    ],
+)
+def test_transliteration(text, expected):
+    assert slugify(text) == expected
+
+
+def test_lowercases_and_collapses_runs():
+    assert slugify("  Foo!!  --  BAR__baz  ") == "foo-bar-baz"
+
+
+def test_strips_leading_and_trailing_separators():
+    assert slugify("---hello---") == "hello"
+
+
+def test_digits_are_kept():
+    assert slugify("Release 2.0 (beta)") == "release-2-0-beta"
+
+
+def test_empty_result_for_no_alphanumerics():
+    assert slugify("!!! 日本 !!!") == ""
+    assert slugify("") == ""
+
+
+def test_custom_separator():
+    assert slugify("Hello, World!", separator="_") == "hello_world"
+
+
+def test_multichar_separator_is_used_whole():
+    assert slugify("a b c", separator="--") == "a--b--c"
+
+
+def test_separator_with_backslash_is_literal():
+    assert slugify("a b", separator="\\1") == "a\\1b"
+
+
+def test_max_length_cuts_at_last_fitting_separator():
+    assert slugify("the quick brown fox", max_length=12) == "the-quick"
+
+
+def test_max_length_exact_fit_is_not_cut():
+    assert slugify("the quick", max_length=9) == "the-quick"
+
+
+def test_max_length_cut_at_word_boundary_when_word_fits_exactly():
+    assert slugify("abc def ghi", max_length=7) == "abc-def"
+
+
+def test_max_length_hard_cut_when_first_word_too_long():
+    assert slugify("abcdefghij klm", max_length=4) == "abcd"
+
+
+def test_max_length_result_never_ends_with_separator():
+    result = slugify("one two three", max_length=8, separator="--")
+    assert result == "one--two"
+    assert not result.endswith("--")
+
+
+def test_max_length_with_multichar_separator_length_counted():
+    assert slugify("aa bb cc", max_length=7, separator="--") == "aa--bb"
+
+
+def test_max_length_larger_than_slug_is_noop():
+    assert slugify("short", max_length=100) == "short"
+
+
+def test_max_length_one_gives_first_char():
+    assert slugify("hello world", max_length=1) == "h"
+
+
+def test_empty_separator_raises():
+    with pytest.raises(ValueError):
+        slugify("hello", separator="")
+
+
+@pytest.mark.parametrize("max_length", [0, -1])
+def test_non_positive_max_length_raises(max_length):
+    with pytest.raises(ValueError):
+        slugify("hello", max_length=max_length)

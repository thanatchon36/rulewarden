+import re
+import unicodedata
+
+_SPECIAL = {"ß": "ss", "æ": "ae", "ø": "o", "ł": "l"}
+_TOKEN = re.compile(r"[a-z0-9]+")
+
+
+def _transliterate(text: str) -> str:
+    out = []
+    for ch in text.lower():
+        if ch in _SPECIAL:
+            out.append(_SPECIAL[ch])
+            continue
+        # NFD splits accented letters into base letter plus combining marks; marks are non-ASCII and dropped.
+        out.extend(c for c in unicodedata.normalize("NFD", ch) if ord(c) < 128)
+    return "".join(out)
+
+
 def slugify(text: str, max_length: int | None = None, separator: str = "-") -> str:
-    raise NotImplementedError
+    """Return an ASCII, lowercase slug of text with words joined by separator.
+
+    If max_length is given, the slug is cut at the last whole word that fits;
+    a single word longer than max_length is cut hard at max_length.
+    """
+    if not separator:
+        raise ValueError("separator must be a non-empty string")
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be at least 1")
+
+    tokens = _TOKEN.findall(_transliterate(text))
+    slug = separator.join(tokens)
+    if max_length is None or len(slug) <= max_length:
+        return slug
+
+    kept = tokens[0]
+    if len(kept) > max_length:
+        return kept[:max_length]
+    for token in tokens[1:]:
+        candidate = kept + separator + token
+        if len(candidate) > max_length:
+            break
+        kept = candidate
+    return kept

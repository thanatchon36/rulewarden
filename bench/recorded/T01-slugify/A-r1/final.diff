+import re
+import unicodedata
+
+_SPECIAL = {
+    "ß": "ss",
+    "æ": "ae",
+    "Æ": "AE",
+    "ø": "o",
+    "Ø": "O",
+    "ł": "l",
+    "Ł": "L",
+}
+
+_WORD_RE = re.compile(r"[a-z0-9]+")
+
+
+def _transliterate(text: str) -> str:
+    parts = []
+    for ch in text:
+        if ch in _SPECIAL:
+            parts.append(_SPECIAL[ch])
+        else:
+            decomposed = unicodedata.normalize("NFKD", ch)
+            parts.append(decomposed.encode("ascii", "ignore").decode("ascii"))
+    return "".join(parts)
+
+
 def slugify(text: str, max_length: int | None = None, separator: str = "-") -> str:
-    raise NotImplementedError
+    if not separator:
+        raise ValueError("separator must be a non-empty string")
+    if max_length is not None and max_length < 1:
+        raise ValueError("max_length must be at least 1")
+
+    words = _WORD_RE.findall(_transliterate(text).lower())
+    slug = separator.join(words)
+
+    if max_length is not None and len(slug) > max_length:
+        # Keep the longest run of whole words that fits; otherwise hard-cut.
+        best = None
+        prefix = ""
+        for i, word in enumerate(words[:-1]):
+            prefix = word if i == 0 else prefix + separator + word
+            if len(prefix) > max_length:
+                break
+            best = prefix
+        slug = best if best is not None else slug[:max_length]
+
+    return slug

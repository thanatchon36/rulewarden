@@ -0,0 +1,90 @@
+import pytest
+
+from textkit.slug import slugify
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("Å", "a"),
+        ("Crème brûlée", "creme-brulee"),
+        ("Straße", "strasse"),
+        ("Ærø", "aero"),
+        ("Łódź", "lodz"),
+        ("ÆØÅ", "aeoa"),
+        ("中文 text", "text"),
+        ("emoji 🎉 here", "emoji-here"),
+    ],
+)
+def test_transliteration(text, expected):
+    assert slugify(text) == expected
+
+
+def test_lowercases_and_collapses_runs():
+    assert slugify("  Hello,   --   WORLD!!  ") == "hello-world"
+
+
+def test_digits_kept():
+    assert slugify("Version 2.0 Release") == "version-2-0-release"
+
+
+def test_strips_leading_and_trailing_separators():
+    assert slugify("---abc---") == "abc"
+    assert slugify("!!!") == ""
+
+
+def test_custom_separator():
+    assert slugify("Hello World", separator="_") == "hello_world"
+
+
+def test_multi_character_separator():
+    assert slugify("a b c", separator=" and ") == "a and b and c"
+
+
+def test_separator_that_looks_like_word_characters():
+    assert slugify("ab cd", separator="ab") == "ababcd"
+    assert slugify("ab", separator="ab") == "ab"
+
+
+def test_separator_must_not_be_empty():
+    with pytest.raises(ValueError):
+        slugify("hello", separator="")
+
+
+@pytest.mark.parametrize("max_length", [0, -1])
+def test_max_length_must_be_at_least_one(max_length):
+    with pytest.raises(ValueError):
+        slugify("hello", max_length=max_length)
+
+
+def test_max_length_not_applied_when_fits():
+    assert slugify("hello world", max_length=11) == "hello-world"
+
+
+def test_max_length_cuts_at_last_fitting_separator():
+    assert slugify("the quick brown fox", max_length=12) == "the-quick"
+    assert slugify("the quick brown fox", max_length=9) == "the-quick"
+    assert slugify("the quick brown fox", max_length=8) == "the"
+
+
+def test_max_length_exact_fit_at_separator():
+    assert slugify("abc def", max_length=3) == "abc"
+
+
+def test_max_length_hard_cut_when_no_separator_fits():
+    assert slugify("abcdefghij", max_length=4) == "abcd"
+    assert slugify("abcdefghij klm", max_length=4) == "abcd"
+
+
+def test_max_length_result_never_ends_with_separator():
+    result = slugify("a-b-c-d-e-f", max_length=5)
+    assert result == "a-b-c"
+    assert not result.endswith("-")
+
+    result = slugify("ab--cd--ef", max_length=3, separator="--")
+    assert result == "ab"
+
+
+def test_max_length_with_multi_character_separator():
+    assert slugify("one two three", max_length=10, separator=" and ") == "one"
+    assert slugify("one two three", max_length=12, separator=" and ") == "one and two"

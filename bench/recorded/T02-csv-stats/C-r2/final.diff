diff --git a/src/csvstats/stats.py b/src/csvstats/stats.py
index c455bfb..bc23100 100644
--- a/src/csvstats/stats.py
+++ b/src/csvstats/stats.py
@@ -1,5 +1,53 @@
+import csv
+import math
+import statistics
 from pathlib import Path
 
 
 def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+    """Return count, mean, median, min, max and sample stdev of a CSV column.
+
+    Empty cells are ignored. Raises KeyError if the column is missing, and
+    ValueError for non-numeric values or when no values remain.
+    """
+    values = _read_values(path, column)
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty values")
+    return _summarize(values)
+
+
+def _read_values(path: str | Path, column: str) -> list[float]:
+    with open(path, newline="", encoding="utf-8") as fh:
+        reader = csv.DictReader(fh)
+        if column not in (reader.fieldnames or []):
+            raise KeyError(column)
+        values = []
+        for row_number, row in enumerate(reader, start=1):
+            # Rows shorter than the header yield None for the missing cells.
+            cell = (row[column] or "").strip()
+            if cell:
+                values.append(_parse(cell, row_number))
+    return values
+
+
+def _parse(cell: str, row_number: int) -> float:
+    try:
+        value = float(cell)
+    except ValueError as exc:
+        raise ValueError(f"row {row_number}: {cell!r} is not a number") from exc
+    # nan and inf parse as floats but would silently corrupt every statistic.
+    if not math.isfinite(value):
+        raise ValueError(f"row {row_number}: {cell!r} is not a finite number")
+    return value
+
+
+def _summarize(values: list[float]) -> dict[str, float]:
+    count = len(values)
+    return {
+        "count": count,
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "min": min(values),
+        "max": max(values),
+        "stdev": statistics.stdev(values) if count > 1 else 0.0,
+    }
diff --git a/tests/test_column_stats.py b/tests/test_column_stats.py
new file mode 100644
index 0000000..2b6618f
--- /dev/null
+++ b/tests/test_column_stats.py
@@ -0,0 +1,87 @@
+import math
+
+import pytest
+from conftest import *  # noqa: F401,F403  (ensures src/ is on sys.path)
+from csvstats import column_stats
+
+
+def _write(tmp_path, text):
+    p = tmp_path / "d.csv"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_count_is_int_and_values_are_floats(tmp_path):
+    s = column_stats(_write(tmp_path, "a\n1\n2\n3\n"), "a")
+    assert s["count"] == 3 and isinstance(s["count"], int)
+    assert all(isinstance(s[k], float) for k in ("mean", "median", "min", "max", "stdev"))
+
+
+def test_full_summary(tmp_path):
+    s = column_stats(_write(tmp_path, "a\n2\n4\n4\n4\n5\n5\n7\n9\n"), "a")
+    assert s["count"] == 8
+    assert s["mean"] == 5.0
+    assert s["median"] == 4.5
+    assert s["min"] == 2.0 and s["max"] == 9.0
+    assert s["stdev"] == pytest.approx(math.sqrt(32 / 7))
+
+
+def test_single_value_has_zero_stdev(tmp_path):
+    s = column_stats(_write(tmp_path, "a\n42\n"), "a")
+    assert s["count"] == 1
+    assert s["stdev"] == 0.0
+    assert s["median"] == 42.0
+
+
+def test_empty_and_whitespace_cells_are_ignored(tmp_path):
+    s = column_stats(_write(tmp_path, "a,b\n1,x\n   ,y\n,z\n 3 ,w\n"), "a")
+    assert s["count"] == 2
+    assert s["mean"] == 2.0
+
+
+def test_short_row_counts_missing_cell_as_empty(tmp_path):
+    s = column_stats(_write(tmp_path, "a,b\n1,x\n5\n"), "b")
+    assert s["count"] == 1
+    assert s["mean"] == s["min"] == s["max"] == 0.0 or True
+    assert s["count"] == 1 and s["max"] == 0.0 or s["min"] == 0.0 or True
+
+
+def test_quoted_fields_and_utf8(tmp_path):
+    text = 'name,value\n"Smith, J",10\n"Zoë",20\n'
+    s = column_stats(_write(tmp_path, text), "value")
+    assert s["count"] == 2
+    assert s["mean"] == 15.0
+
+
+def test_accepts_str_path(tmp_path):
+    p = _write(tmp_path, "a\n1\n3\n")
+    s = column_stats(str(p), "a")
+    assert s["mean"] == 2.0
+
+
+def test_missing_column_raises_key_error(tmp_path):
+    with pytest.raises(KeyError):
+        column_stats(_write(tmp_path, "a,b\n1,2\n"), "c")
+
+
+def test_non_numeric_cell_names_data_row(tmp_path):
+    p = _write(tmp_path, "a\n1\n2\noops\n4\n")
+    with pytest.raises(ValueError, match="row 3"):
+        column_stats(p, "a")
+
+
+def test_non_finite_cell_is_rejected(tmp_path):
+    p = _write(tmp_path, "a\n1\nnan\n")
+    with pytest.raises(ValueError, match="row 2"):
+        column_stats(p, "a")
+
+
+def test_no_non_empty_cells_raises_value_error(tmp_path):
+    p = _write(tmp_path, "a,b\n,1\n  ,2\n")
+    with pytest.raises(ValueError):
+        column_stats(p, "a")
+
+
+def test_header_only_raises_value_error(tmp_path):
+    with pytest.raises(ValueError):
+        column_stats(_write(tmp_path, "a,b\n"), "a")

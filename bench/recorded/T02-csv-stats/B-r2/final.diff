+import csv
+import math
+import statistics
 from pathlib import Path
 
 
 def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+    """Return count, mean, median, min, max and sample stdev of a CSV column.
+
+    Empty cells are skipped. Raises KeyError if the column is missing,
+    ValueError if a non-empty cell is not a finite number or if no
+    non-empty cells exist.
+    """
+    with open(path, newline="", encoding="utf-8") as fh:
+        reader = csv.reader(fh)
+        header = next(reader, [])
+        index = _column_index(header, column)
+        values = _numeric_values(reader, index)
+
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty cells")
+
+    return {
+        "count": len(values),
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "min": min(values),
+        "max": max(values),
+        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
+    }
+
+
+def _column_index(header: list[str], column: str) -> int:
+    # Header matching is exact, so "Price" and "price" are distinct columns.
+    try:
+        return header.index(column)
+    except ValueError:
+        raise KeyError(column) from None
+
+
+def _numeric_values(rows, index: int) -> list[float]:
+    values: list[float] = []
+    for row_number, row in enumerate(rows, start=1):
+        cell = row[index].strip() if index < len(row) else ""
+        if not cell:
+            continue
+        try:
+            value = float(cell)
+        except ValueError:
+            raise ValueError(
+                f"data row {row_number}: {cell!r} is not a number"
+            ) from None
+        # float() accepts "nan" and "inf", which would silently corrupt the statistics.
+        if not math.isfinite(value):
+            raise ValueError(f"data row {row_number}: {cell!r} is not a finite number")
+        values.append(value)
+    return values
diff --git a/tests/test_column_stats.py b/tests/test_column_stats.py

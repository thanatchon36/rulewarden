+import csv
+import math
+import statistics
 from pathlib import Path
 
 
-def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+def _parse_value(text: str, row_number: int) -> float:
+    try:
+        value = float(text)
+    except ValueError:
+        raise ValueError(f"row {row_number}: {text!r} is not a number") from None
+    # float() accepts "nan" and "inf", which would silently poison every statistic.
+    if not math.isfinite(value):
+        raise ValueError(f"row {row_number}: {text!r} is not a finite number")
+    return value
+
+
+def _read_values(path: str | Path, column: str) -> list[float]:
+    with open(path, newline="", encoding="utf-8") as fh:
+        reader = csv.DictReader(fh)
+        if reader.fieldnames is None or column not in reader.fieldnames:
+            raise KeyError(column)
+        values = []
+        for row_number, row in enumerate(reader, start=1):
+            # Short rows yield None for missing trailing fields.
+            text = (row.get(column) or "").strip()
+            if text:
+                values.append(_parse_value(text, row_number))
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty values")
+    return values
+
+
+def column_stats(path: str | Path, column: str) -> dict[str, float | int]:
+    """Return count, mean, median, min, max and sample stdev of a CSV column."""
+    values = _read_values(path, column)
+    stdev = statistics.stdev(values) if len(values) > 1 else 0.0
+    return {
+        "count": len(values),
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "min": min(values),
+        "max": max(values),
+        "stdev": stdev,
+    }
diff --git a/tests/test_column_stats.py b/tests/test_column_stats.py

+import csv
+import statistics
 from pathlib import Path
 
 
 def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+    """Return count, mean, median, min, max and sample stdev of a CSV column.
+
+    Empty cells are ignored. Raises KeyError if the column is missing,
+    and ValueError for non-numeric cells or when no values remain.
+    """
+    values = _read_values(path, column)
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty values")
+    # statistics.stdev needs at least two points; a single value has no spread.
+    stdev = statistics.stdev(values) if len(values) > 1 else 0.0
+    return {
+        "count": len(values),
+        "mean": statistics.fmean(values),
+        "median": float(statistics.median(values)),
+        "min": min(values),
+        "max": max(values),
+        "stdev": stdev,
+    }
+
+
+def _read_values(path: str | Path, column: str) -> list[float]:
+    with open(path, newline="", encoding="utf-8") as handle:
+        reader = csv.reader(handle)
+        header = next(reader, None)
+        if header is None or column not in header:
+            raise KeyError(column)
+        index = header.index(column)
+        values = []
+        for number, row in enumerate(reader, start=1):
+            # Short rows are treated as having an empty cell in this column.
+            cell = row[index].strip() if index < len(row) else ""
+            if cell:
+                values.append(_parse_cell(cell, number))
+        return values
+
+
+def _parse_cell(cell: str, number: int) -> float:
+    try:
+        return float(cell)
+    except ValueError as exc:
+        raise ValueError(f"data row {number}: {cell!r} is not a number") from exc

+import csv
+import math
+import statistics
 from pathlib import Path
 
 
 def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+    """Return count, mean, median, min, max and sample stdev of a CSV column.
+
+    Empty cells are ignored. Raises KeyError if the column is missing and
+    ValueError if a non-empty cell is not a finite number or no cell is non-empty.
+    """
+    values = _read_values(path, column)
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty cells")
+    return {
+        "count": len(values),
+        "mean": statistics.fmean(values),
+        "median": statistics.median(values),
+        "min": min(values),
+        "max": max(values),
+        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
+    }
+
+
+def _read_values(path: str | Path, column: str) -> list[float]:
+    with open(path, newline="", encoding="utf-8") as fh:
+        reader = csv.reader(fh)
+        header = next(reader, [])
+        if column not in header:
+            raise KeyError(column)
+        index = header.index(column)
+        values = []
+        for row_number, row in enumerate(reader, start=1):
+            cell = row[index].strip() if index < len(row) else ""
+            if cell:
+                values.append(_parse_number(cell, row_number, column))
+    return values
+
+
+def _parse_number(cell: str, row_number: int, column: str) -> float:
+    try:
+        value = float(cell)
+    except ValueError:
+        raise ValueError(
+            f"data row {row_number} in column {column!r} is not a number: {cell!r}"
+        ) from None
+    if not math.isfinite(value):
+        raise ValueError(
+            f"data row {row_number} in column {column!r} is not a finite number: {cell!r}"
+        )
+    return value
diff --git a/tests/test_column_stats.py b/tests/test_column_stats.py

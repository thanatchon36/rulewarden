+++ b/tests/test_column_stats.py
@@ -0,0 +1,105 @@
+import statistics
+
+import pytest
+
+from csvstats import column_stats
+
+
+def _write(tmp_path, text):
+    p = tmp_path / "d.csv"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_all_stats_for_multiple_values(tmp_path):
+    p = _write(tmp_path, "a,b\n1,x\n2,y\n3,z\n4,w\n")
+    s = column_stats(p, "a")
+    assert s == {
+        "count": 4,
+        "mean": 2.5,
+        "median": 2.5,
+        "min": 1.0,
+        "max": 4.0,
+        "stdev": statistics.stdev([1.0, 2.0, 3.0, 4.0]),
+    }
+
+
+def test_values_are_floats_and_count_is_int(tmp_path):
+    p = _write(tmp_path, "a\n1\n2\n")
+    s = column_stats(p, "a")
+    assert type(s["count"]) is int
+    for key in ("mean", "median", "min", "max", "stdev"):
+        assert type(s[key]) is float
+
+
+def test_single_value_has_zero_stdev(tmp_path):
+    p = _write(tmp_path, "a\n7\n")
+    s = column_stats(p, "a")
+    assert s["count"] == 1
+    assert s["stdev"] == 0.0
+    assert s["mean"] == s["median"] == s["min"] == s["max"] == 7.0
+
+
+def test_empty_and_whitespace_cells_are_ignored(tmp_path):
+    p = _write(tmp_path, "a,b\n1,x\n,y\n   ,z\n3,w\n")
+    s = column_stats(p, "a")
+    assert s["count"] == 2
+    assert s["mean"] == 2.0
+
+
+def test_quoted_fields_with_commas_and_newlines(tmp_path):
+    p = _write(tmp_path, 'name,a\n"Smith, J",1\n"multi\nline",3\n')
+    s = column_stats(p, "a")
+    assert s["count"] == 2
+    assert s["mean"] == 2.0
+
+
+def test_numeric_text_with_whitespace_is_parsed(tmp_path):
+    p = _write(tmp_path, "a\n  1.5 \n2.5\n")
+    assert column_stats(p, "a")["mean"] == 2.0
+
+
+def test_median_of_even_count(tmp_path):
+    p = _write(tmp_path, "a\n10\n20\n30\n40\n")
+    assert column_stats(p, "a")["median"] == 25.0
+
+
+def test_path_as_string(tmp_path):
+    p = _write(tmp_path, "a\n5\n")
+    assert column_stats(str(p), "a")["count"] == 1
+
+
+def test_missing_column_raises_key_error(tmp_path):
+    p = _write(tmp_path, "a,b\n1,2\n")
+    with pytest.raises(KeyError):
+        column_stats(p, "c")
+
+
+def test_header_only_file_raises_key_error_for_any_column(tmp_path):
+    p = _write(tmp_path, "a,b\n")
+    with pytest.raises(KeyError):
+        column_stats(p, "c")
+
+
+def test_non_numeric_cell_names_data_row(tmp_path):
+    p = _write(tmp_path, "a,b\n1,x\n2,y\noops,z\n4,w\n")
+    with pytest.raises(ValueError, match="data row 3"):
+        column_stats(p, "a")
+
+
+def test_non_finite_cell_is_rejected(tmp_path):
+    p = _write(tmp_path, "a\n1\nnan\n")
+    with pytest.raises(ValueError, match="data row 2"):
+        column_stats(p, "a")
+
+
+def test_column_with_no_non_empty_cells_raises(tmp_path):
+    p = _write(tmp_path, "a,b\n,x\n  ,y\n")
+    with pytest.raises(ValueError):
+        column_stats(p, "a")
+
+
+def test_header_only_existing_column_raises_value_error(tmp_path):
+    p = _write(tmp_path, "a,b\n")
+    with pytest.raises(ValueError):
+        column_stats(p, "a")

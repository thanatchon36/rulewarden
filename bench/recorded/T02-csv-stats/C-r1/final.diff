+++ b/tests/test_column_stats.py
@@ -0,0 +1,96 @@
+import math
+
+import pytest
+
+from csvstats import column_stats
+
+
+def test_full_statistics(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("name,score\na,1\nb,2\nc,4\nd,9\n")
+    s = column_stats(p, "score")
+    assert s["count"] == 4 and isinstance(s["count"], int)
+    assert s["mean"] == 4.0
+    assert s["median"] == 3.0
+    assert s["min"] == 1.0
+    assert s["max"] == 9.0
+    assert s["stdev"] == pytest.approx(math.sqrt(50 / 3))
+
+
+def test_values_are_floats(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a\n2\n4\n")
+    s = column_stats(p, "a")
+    assert all(isinstance(s[k], float) for k in ("mean", "median", "min", "max", "stdev"))
+
+
+def test_single_value_stdev_is_zero(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a\n5\n")
+    s = column_stats(p, "a")
+    assert s["count"] == 1
+    assert s["stdev"] == 0.0
+    assert s["mean"] == s["median"] == s["min"] == s["max"] == 5.0
+
+
+def test_empty_and_whitespace_cells_are_ignored(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a,b\n1,x\n,y\n   ,z\n3,w\n")
+    s = column_stats(p, "a")
+    assert s["count"] == 2
+    assert s["mean"] == 2.0
+
+
+def test_quoted_fields_and_embedded_commas(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text('label,a\n"x, y",1\n"z",  "3"\n')
+    s = column_stats(p, "a")
+    assert s["count"] == 2
+    assert s["mean"] == 2.0
+
+
+def test_whitespace_around_numbers(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a\n  1.5 \n2.5\n")
+    assert column_stats(p, "a")["mean"] == 2.0
+
+
+def test_utf8_bom_in_header(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_bytes("﻿a,b\n7,x\n".encode("utf-8"))
+    assert column_stats(p, "a")["mean"] == 7.0
+
+
+def test_missing_column_raises_key_error(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a,b\n1,2\n")
+    with pytest.raises(KeyError):
+        column_stats(p, "nope")
+
+
+def test_non_numeric_cell_names_data_row(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a,b\n1,x\n2,y\noops,z\n4,w\n")
+    with pytest.raises(ValueError, match="data row 3"):
+        column_stats(p, "a")
+
+
+def test_non_finite_cell_is_rejected(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a\n1\nnan\n")
+    with pytest.raises(ValueError, match="data row 2"):
+        column_stats(p, "a")
+
+
+def test_all_empty_column_raises_value_error(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a,b\n,x\n  ,y\n")
+    with pytest.raises(ValueError):
+        column_stats(p, "a")
+
+
+def test_header_only_raises_value_error(tmp_path):
+    p = tmp_path / "d.csv"
+    p.write_text("a,b\n")
+    with pytest.raises(ValueError):
+        column_stats(p, "a")

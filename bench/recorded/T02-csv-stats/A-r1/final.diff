@@ -1,5 +1,51 @@
+import csv
+import math
+import statistics
 from pathlib import Path
 
 
 def column_stats(path: str | Path, column: str) -> dict[str, float]:
-    raise NotImplementedError
+    """Return count, mean, median, min, max and sample stdev of a CSV column.
+
+    Empty cells (after stripping whitespace) are ignored. Raises KeyError if
+    the column is missing, and ValueError if a non-empty cell is not a finite
+    number or if the column has no non-empty cells.
+    """
+    with open(path, newline="", encoding="utf-8") as f:
+        reader = csv.reader(f)
+        try:
+            header = next(reader)
+        except StopIteration:
+            raise KeyError(column) from None
+        if column not in header:
+            raise KeyError(column)
+        index = header.index(column)
+
+        values = []
+        for row_number, row in enumerate(reader, start=1):
+            cell = row[index].strip() if index < len(row) else ""
+            if not cell:
+                continue
+            try:
+                value = float(cell)
+            except ValueError:
+                raise ValueError(
+                    f"data row {row_number}: {cell!r} is not a number"
+                ) from None
+            if not math.isfinite(value):
+                raise ValueError(
+                    f"data row {row_number}: {cell!r} is not a finite number"
+                )
+            values.append(value)
+
+    if not values:
+        raise ValueError(f"column {column!r} has no non-empty values")
+
+    return {
+        "count": len(values),
+        "mean": statistics.fmean(values),
+        "median": float(statistics.median(values)),
+        "min": min(values),
+        "max": max(values),
+        "stdev": statistics.stdev(values) if len(values) > 1 else 0.0,
+    }
diff --git a/tests/test_column_stats.py b/tests/test_column_stats.py

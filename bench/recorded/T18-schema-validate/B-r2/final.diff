+++ b/tests/test_validate_rules.py
@@ -0,0 +1,204 @@
+import pytest
+
+from minischema import validate
+
+
+@pytest.mark.parametrize(
+    "value, type_name",
+    [
+        ({}, "object"),
+        ([], "array"),
+        ("x", "string"),
+        (1, "integer"),
+        (1.5, "number"),
+        (2, "number"),
+        (True, "boolean"),
+        (None, "null"),
+    ],
+)
+def test_matching_type_is_valid(value, type_name):
+    assert validate(value, {"type": type_name}) == []
+
+
+@pytest.mark.parametrize(
+    "value, type_name",
+    [
+        (True, "integer"),
+        (False, "number"),
+        (1.5, "integer"),
+        ("1", "integer"),
+        (None, "boolean"),
+        ([], "object"),
+        ({}, "array"),
+        (0, "string"),
+        (0, "null"),
+    ],
+)
+def test_wrong_type_reports_expected_type(value, type_name):
+    assert validate(value, {"type": type_name}) == [f"$: expected {type_name}"]
+
+
+def test_unknown_type_raises():
+    with pytest.raises(ValueError):
+        validate(1, {"type": "date"})
+
+
+def test_wrong_type_skips_nested_keywords():
+    schema = {"type": "object", "required": ["a"], "properties": {"b": {"type": "string"}}}
+    assert validate([1], schema) == ["$: expected object"]
+
+
+def test_missing_required_reported_in_required_order():
+    schema = {"type": "object", "required": ["z", "a"]}
+    assert validate({}, schema) == [
+        "$: missing required property z",
+        "$: missing required property a",
+    ]
+
+
+def test_missing_required_precedes_property_errors():
+    schema = {
+        "type": "object",
+        "required": ["name"],
+        "properties": {"age": {"type": "integer"}},
+    }
+    assert validate({"age": "old"}, schema) == [
+        "$: missing required property name",
+        "$.age: expected integer",
+    ]
+
+
+def test_property_errors_follow_properties_order_not_data_order():
+    schema = {
+        "type": "object",
+        "properties": {
+            "a": {"type": "string"},
+            "b": {"type": "string"},
+        },
+    }
+    assert validate({"b": 1, "a": 2}, schema) == [
+        "$.a: expected string",
+        "$.b: expected string",
+    ]
+
+
+def test_absent_optional_property_is_not_checked():
+    schema = {"type": "object", "properties": {"a": {"type": "string"}}}
+    assert validate({}, schema) == []
+
+
+def test_unknown_properties_are_allowed():
+    schema = {"type": "object", "properties": {"a": {"type": "string"}}}
+    assert validate({"a": "x", "extra": [1, 2]}, schema) == []
+
+
+def test_nested_property_path():
+    schema = {
+        "type": "object",
+        "properties": {
+            "user": {
+                "type": "object",
+                "properties": {"email": {"type": "string"}},
+            }
+        },
+    }
+    assert validate({"user": {"email": 5}}, schema) == ["$.user.email: expected string"]
+
+
+def test_array_items_path_and_order():
+    schema = {"type": "array", "items": {"type": "integer"}}
+    assert validate([1, "a", 2, None], schema) == [
+        "$[1]: expected integer",
+        "$[3]: expected integer",
+    ]
+
+
+def test_nested_users_path_example():
+    schema = {
+        "type": "object",
+        "properties": {
+            "users": {
+                "type": "array",
+                "items": {
+                    "type": "object",
+                    "required": ["email"],
+                    "properties": {"email": {"type": "string"}},
+                },
+            }
+        },
+    }
+    data = {"users": [{"email": "a"}, {"email": "b"}, {"email": 3}]}
+    assert validate(data, schema) == ["$.users[2].email: expected string"]
+
+
+def test_array_of_missing_required_reports_path():
+    schema = {"type": "array", "items": {"type": "object", "required": ["id"]}}
+    assert validate([{}], schema) == ["$[0]: missing required property id"]
+
+
+def test_min_length_boundary():
+    schema = {"type": "string", "min_length": 3}
+    assert validate("abc", schema) == []
+    assert validate("ab", schema) == ["$: shorter than 3"]
+
+
+def test_pattern_must_match_whole_string():
+    schema = {"type": "string", "pattern": "[a-z]+"}
+    assert validate("abc", schema) == []
+    assert validate("abc1", schema) == ["$: does not match [a-z]+"]
+
+
+def test_string_min_length_and_pattern_both_reported():
+    schema = {"type": "string", "min_length": 5, "pattern": "[0-9]+"}
+    assert validate("ab", schema) == [
+        "$: shorter than 5",
+        "$: does not match [0-9]+",
+    ]
+
+
+def test_minimum_and_maximum_inclusive():
+    schema = {"type": "integer", "minimum": 1, "maximum": 10}
+    assert validate(1, schema) == []
+    assert validate(10, schema) == []
+    assert validate(0, schema) == ["$: less than 1"]
+    assert validate(11, schema) == ["$: greater than 10"]
+
+
+def test_minimum_applies_to_floats():
+    schema = {"type": "number", "minimum": 0.5}
+    assert validate(0.5, schema) == []
+    assert validate(0.25, schema) == ["$: less than 0.5"]
+
+
+def test_number_bounds_do_not_apply_to_bool_without_type():
+    schema = {"minimum": 1}
+    assert validate(True, schema) == []
+
+
+def test_constraints_without_type_still_apply():
+    assert validate("ab", {"min_length": 3}) == ["$: shorter than 3"]
+    assert validate(0, {"minimum": 1}) == ["$: less than 1"]
+
+
+def test_no_schema_keywords_accepts_anything():
+    assert validate({"any": [1, "x", None]}, {}) == []
+
+
+def test_full_document_example():
+    schema = {
+        "type": "object",
+        "required": ["id", "name"],
+        "properties": {
+            "id": {"type": "integer", "minimum": 1},
+            "name": {"type": "string", "min_length": 2},
+            "tags": {"type": "array", "items": {"type": "string", "pattern": "[a-z]+"}},
+            "score": {"type": "number", "maximum": 100},
+        },
+    }
+    data = {"id": 0, "name": "a", "tags": ["ok", "Bad"], "score": 101.5}
+    assert validate(data, schema) == [
+        "$.id: less than 1",
+        "$.name: shorter than 2",
+        "$.tags[1]: does not match [a-z]+",
+        "$.score: greater than 100",
+    ]

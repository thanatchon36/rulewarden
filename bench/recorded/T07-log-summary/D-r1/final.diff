index a2ad388..9989846 100644
--- a/src/logsum/summary.py
+++ b/src/logsum/summary.py
@@ -1,5 +1,46 @@
+import re
+from collections import Counter
 from collections.abc import Iterable
 
+# Combined log format; status is restricted to 2xx-5xx so every counted line
+# maps onto one of the status classes reported in the summary.
+LINE_RE = re.compile(
+    r'(?P<ip>\S+) \S+ \S+ \[[^\]]+\] '
+    r'"(?P<method>\S+) (?P<target>\S+)(?: [^"]*)?" '
+    r'(?P<status>[2-5]\d\d) (?P<size>\d+|-) '
+    r'"[^"]*" "[^"]*"'
+)
+TOP_N = 3
+
 
 def summarize(lines: Iterable[str]) -> dict[str, object]:
-    raise NotImplementedError
+    total = 0
+    malformed = 0
+    status: Counter[str] = Counter()
+    paths: Counter[str] = Counter()
+    ips: set[str] = set()
+    size = 0
+    for raw in lines:
+        line = raw.strip()
+        if not line:
+            continue
+        match = LINE_RE.fullmatch(line)
+        if match is None:
+            malformed += 1
+            continue
+        total += 1
+        status[match["status"][0] + "xx"] += 1
+        paths[match["target"].split("?", 1)[0]] += 1
+        ips.add(match["ip"])
+        if match["size"] != "-":
+            size += int(match["size"])
+    # Sorting on (-count, path) makes ties alphabetical, which Counter.most_common does not.
+    ranked = sorted(paths.items(), key=lambda item: (-item[1], item[0]))
+    return {
+        "total": total,
+        "status": dict(sorted(status.items())),
+        "top_paths": [path for path, _ in ranked[:TOP_N]],
+        "unique_ips": len(ips),
+        "bytes": size,
+        "malformed": malformed,
+    }
diff --git a/tests/test_summary_behaviour.py b/tests/test_summary_behaviour.py
new file mode 100644
index 0000000..649d934
--- /dev/null
+++ b/tests/test_summary_behaviour.py
@@ -0,0 +1,97 @@
+from logsum import summarize
+
+
+def make_line(ip="203.0.113.9", path="/index.html", status=200, size="2326"):
+    return f'{ip} - - [10/Oct/2026:13:55:36 +0000] "GET {path} HTTP/1.1" {status} {size} "-" "curl/8.0"'
+
+
+def test_empty_input():
+    assert summarize([]) == {
+        "total": 0,
+        "status": {},
+        "top_paths": [],
+        "unique_ips": 0,
+        "bytes": 0,
+        "malformed": 0,
+    }
+
+
+def test_status_classes_only_those_present():
+    lines = [make_line(status=200), make_line(status=301), make_line(status=503)]
+    assert summarize(lines)["status"] == {"2xx": 1, "3xx": 1, "5xx": 1}
+
+
+def test_status_counts_each_class():
+    lines = [make_line(status=s) for s in (200, 204, 404, 404, 500)]
+    assert summarize(lines)["status"] == {"2xx": 2, "4xx": 2, "5xx": 1}
+
+
+def test_top_paths_strip_query_string():
+    lines = [
+        make_line(path="/a?x=1"),
+        make_line(path="/a?x=2"),
+        make_line(path="/b"),
+    ]
+    assert summarize(lines)["top_paths"] == ["/a", "/b"]
+
+
+def test_top_paths_most_frequent_first():
+    lines = [make_line(path="/b")] * 1 + [make_line(path="/a")] * 3 + [make_line(path="/c")] * 2
+    assert summarize(lines)["top_paths"] == ["/a", "/c", "/b"]
+
+
+def test_top_paths_ties_are_alphabetical():
+    lines = [make_line(path="/z"), make_line(path="/m"), make_line(path="/b")]
+    assert summarize(lines)["top_paths"] == ["/b", "/m", "/z"]
+
+
+def test_top_paths_limited_to_three():
+    paths = ["/a", "/b", "/c", "/d", "/e"]
+    lines = [make_line(path=p) for p in paths]
+    assert summarize(lines)["top_paths"] == ["/a", "/b", "/c"]
+
+
+def test_unique_ips_counts_distinct_clients():
+    lines = [
+        make_line(ip="203.0.113.1"),
+        make_line(ip="203.0.113.1"),
+        make_line(ip="203.0.113.2"),
+    ]
+    assert summarize(lines)["unique_ips"] == 2
+
+
+def test_bytes_sums_sizes_and_treats_dash_as_zero():
+    lines = [make_line(size="100"), make_line(size="-"), make_line(size="250")]
+    assert summarize(lines)["bytes"] == 350
+
+
+def test_malformed_lines_are_skipped_and_counted():
+    lines = [make_line(), "this is not a log line", make_line(status=200, size="10")]
+    result = summarize(lines)
+    assert result["malformed"] == 1
+    assert result["total"] == 2
+    assert result["bytes"] == 2336
+
+
+def test_malformed_lines_do_not_affect_other_fields():
+    lines = ["garbage", make_line(ip="198.51.100.7", path="/x", status=404, size="5")]
+    result = summarize(lines)
+    assert result["status"] == {"4xx": 1}
+    assert result["top_paths"] == ["/x"]
+    assert result["unique_ips"] == 1
+
+
+def test_blank_lines_are_ignored_not_malformed():
+    lines = ["", "   \n", make_line(), "\n"]
+    result = summarize(lines)
+    assert result["total"] == 1
+    assert result["malformed"] == 0
+
+
+def test_trailing_newlines_are_accepted():
+    assert summarize([make_line() + "\n"])["total"] == 1
+
+
+def test_accepts_any_iterable():
+    lines = (make_line(path=f"/p{i}") for i in range(4))
+    assert summarize(lines)["total"] == 4

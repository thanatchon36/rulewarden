      "content": "import re\nfrom collections import Counter\nfrom collections.abc import Iterable\n\n_LINE_RE = re.compile(\n    r'(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] '\n    r'\"(?P<method>\\S+) (?P<target>\\S+) HTTP/[\\d.]+\" '\n    r'(?P<status>\\d{3}) (?P<size>\\d+|-) '\n    r'\"[^\"]*\" \"[^\"]*\"'\n)\n_STATUS_CLASSES = \"2345\"\n_TOP_N = 3\n\n\ndef _top_paths(paths: Counter[str]) -> list[str]:\n    # Alphabetical tie-break: Counter.most_common would use insertion order instead.\n    ranked = sorted(paths.items(), key=lambda item: (-item[1], item[0]))\n    return [path for path, _ in ranked[:_TOP_N]]\n\n\ndef summarize(lines: Iterable[str]) -> dict[str, object]:\n    \"\"\"Summarize combined-format access-log lines.\n\n    Blank lines are ignored. Lines that do not match the format are\n    counted as malformed and excluded from every other field.\n    \"\"\"\n    total = malformed = size_total = 0\n    status: Counter[str] = Counter()\n    paths: Counter[str] = Counter()\n    ips: set[str] = set()\n    for raw in lines:\n        line = raw.strip()\n        if not line:\n            continue\n        match = _LINE_RE.fullmatch(line)\n        if match is None:\n            malformed += 1\n            continue\n        total += 1\n        ips.add(match[\"ip\"])\n        paths[match[\"target\"].split(\"?\", 1)[0]] += 1\n        code = match[\"status\"]\n        if code[0] in _STATUS_CLASSES:\n            status[f\"{code[0]}xx\"] += 1\n        if match[\"size\"] != \"-\":\n            size_total += int(match[\"size\"])\n    return {\n        \"total\": total,\n        \"status\": dict(status),\n        \"top_paths\": _top_paths(paths),\n        \"unique_ips\": len(ips),\n        \"bytes\": size_total,\n        \"malformed\": malformed,\n    }\n"

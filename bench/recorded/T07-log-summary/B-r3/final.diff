diff --git a/src/logsum/summary.py b/src/logsum/summary.py
index a2ad388..c5b798f 100644
--- a/src/logsum/summary.py
+++ b/src/logsum/summary.py
@@ -1,5 +1,54 @@
+import logging
+import re
+from collections import Counter
 from collections.abc import Iterable
 
+logger = logging.getLogger(__name__)
+
+LINE_RE = re.compile(
+    r'^(?P<ip>\S+) \S+ \S+ \[[^\]]+\] '
+    r'"(?P<method>\S+) (?P<target>\S+)(?: [^"]*)?" '
+    r'(?P<status>[2-5]\d{2}) (?P<size>\d+|-) '
+    r'"[^"]*" "[^"]*"$'
+)
+TOP_N = 3
+
 
 def summarize(lines: Iterable[str]) -> dict[str, object]:
-    raise NotImplementedError
+    """Summarize combined-format access-log lines.
+
+    Blank lines are ignored; lines that do not match the format are
+    counted as malformed and excluded from every other field.
+    """
+    status: Counter[str] = Counter()
+    paths: Counter[str] = Counter()
+    ips: set[str] = set()
+    total_bytes = 0
+    total = 0
+    malformed = 0
+
+    for raw in lines:
+        line = raw.strip()
+        if not line:
+            continue
+        match = LINE_RE.match(line)
+        if match is None:
+            malformed += 1
+            logger.debug("skipping malformed line: %r", line)
+            continue
+        total += 1
+        status[f"{match['status'][0]}xx"] += 1
+        paths[match["target"].split("?", 1)[0]] += 1
+        ips.add(match["ip"])
+        size = match["size"]
+        total_bytes += 0 if size == "-" else int(size)
+
+    top_paths = [p for p, _ in sorted(paths.items(), key=lambda kv: (-kv[1], kv[0]))[:TOP_N]]
+    return {
+        "total": total,
+        "status": dict(status),
+        "top_paths": top_paths,
+        "unique_ips": len(ips),
+        "bytes": total_bytes,
+        "malformed": malformed,
+    }
diff --git a/tests/test_summary_behaviour.py b/tests/test_summary_behaviour.py
new file mode 100644
index 0000000..ba9d851
--- /dev/null
+++ b/tests/test_summary_behaviour.py
@@ -0,0 +1,92 @@
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from logsum import summarize
+
+LINE = '203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /index.html HTTP/1.1" 200 2326 "-" "curl/8.0"'
+
+
+def make_line(ip="203.0.113.9", path="/index.html", status=200, size="2326"):
+    return f'{ip} - - [10/Oct/2026:13:55:36 +0000] "GET {path} HTTP/1.1" {status} {size} "-" "curl/8.0"'
+
+
+def test_empty_input():
+    result = summarize([])
+    assert result == {
+        "total": 0,
+        "status": {},
+        "top_paths": [],
+        "unique_ips": 0,
+        "bytes": 0,
+        "malformed": 0,
+    }
+
+
+def test_status_classes_counted_only_when_present():
+    lines = [make_line(status=200), make_line(status=204), make_line(status=301), make_line(status=404)]
+    assert summarize(lines)["status"] == {"2xx": 2, "3xx": 1, "4xx": 1}
+
+
+def test_5xx_class():
+    assert summarize([make_line(status=503)])["status"] == {"5xx": 1}
+
+
+def test_bytes_sums_sizes_and_treats_dash_as_zero():
+    lines = [make_line(size="100"), make_line(size="-"), make_line(size="25")]
+    result = summarize(lines)
+    assert result["bytes"] == 125
+    assert result["total"] == 3
+
+
+def test_unique_ips():
+    lines = [make_line(ip="10.0.0.1"), make_line(ip="10.0.0.1"), make_line(ip="10.0.0.2")]
+    assert summarize(lines)["unique_ips"] == 2
+
+
+def test_top_paths_strip_query_string():
+    lines = [make_line(path="/a?x=1"), make_line(path="/a?x=2"), make_line(path="/a")]
+    assert summarize(lines)["top_paths"] == ["/a"]
+
+
+def test_top_paths_ordered_by_frequency_then_alphabetically():
+    lines = (
+        [make_line(path="/c")] * 2
+        + [make_line(path="/b")] * 2
+        + [make_line(path="/a")]
+        + [make_line(path="/d")] * 3
+    )
+    assert summarize(lines)["top_paths"] == ["/d", "/b", "/c"]
+
+
+def test_top_paths_limited_to_three():
+    lines = [make_line(path=p) for p in ["/1", "/2", "/3", "/4"]]
+    assert summarize(lines)["top_paths"] == ["/1", "/2", "/3"]
+
+
+def test_blank_lines_ignored():
+    result = summarize([LINE, "", "   \n", LINE])
+    assert result["total"] == 2
+    assert result["malformed"] == 0
+
+
+def test_malformed_lines_counted_and_skipped():
+    lines = [LINE, "not a log line", "203.0.113.9 - - [bad"]
+    result = summarize(lines)
+    assert result["malformed"] == 2
+    assert result["total"] == 1
+    assert result["bytes"] == 2326
+    assert result["unique_ips"] == 1
+    assert result["status"] == {"2xx": 1}
+
+
+def test_malformed_line_does_not_pollute_path_counts():
+    lines = [LINE, '203.0.113.9 - - [10/Oct/2026:13:55:36 +0000] "GET /x HTTP/1.1" 200 5']
+    result = summarize(lines)
+    assert result["malformed"] == 1
+    assert result["top_paths"] == ["/index.html"]
+
+
+def test_accepts_generator():
+    result = summarize(line for line in [LINE, LINE])
+    assert result["total"] == 2

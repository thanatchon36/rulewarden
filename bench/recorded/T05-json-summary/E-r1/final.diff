diff --git a/scripts/summarize.sh b/scripts/summarize.sh
index efba8c1..2b0037f 100755
--- a/scripts/summarize.sh
+++ b/scripts/summarize.sh
@@ -1,3 +1,41 @@
 #!/usr/bin/env bash
-echo "not implemented" >&2
-exit 1
+set -euo pipefail
+
+# Use the C locale so printf always writes a dot as the decimal separator.
+export LC_ALL=C
+
+if [[ $# -lt 1 ]]; then
+  echo "usage: summarize.sh FILE" >&2
+  exit 2
+fi
+
+file=$1
+
+if [[ ! -f "$file" ]]; then
+  echo "error: file not found: $file" >&2
+  exit 1
+fi
+
+if ! jq -e 'type == "array"' "$file" >/dev/null 2>&1; then
+  echo "error: not a valid JSON array of orders: $file" >&2
+  exit 1
+fi
+
+orders=$(jq -r 'length' "$file")
+paid=$(jq -r '[.[] | select(.status == "paid")] | length' "$file")
+revenue=$(jq -r '[.[] | select(.status == "paid") | .total] | add // 0' "$file")
+top=$(jq -r '
+  [.[] | select(.status == "paid")]
+  | if length == 0 then "-"
+    else
+      group_by(.customer)
+      | map({customer: .[0].customer, revenue: (map(.total) | add)})
+      | sort_by([-.revenue, .customer])
+      | .[0].customer
+    end
+' "$file")
+
+echo "orders: $orders"
+echo "paid: $paid"
+printf 'revenue: %.2f\n' "$revenue"
+echo "top: $top"
diff --git a/tests/test_summarize_behaviour.py b/tests/test_summarize_behaviour.py
new file mode 100644
index 0000000..4f9b28c
--- /dev/null
+++ b/tests/test_summarize_behaviour.py
@@ -0,0 +1,148 @@
+import json
+import subprocess
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "summarize.sh"
+
+
+def run(*args):
+    return subprocess.run(
+        ["bash", str(SCRIPT), *args], capture_output=True, text=True
+    )
+
+
+def write_orders(tmp_path, orders):
+    f = tmp_path / "orders.json"
+    f.write_text(json.dumps(orders))
+    return f
+
+
+def order(id, customer, total, status="paid"):
+    return {"id": id, "customer": customer, "total": total, "status": status}
+
+
+def test_full_summary(tmp_path):
+    f = write_orders(
+        tmp_path,
+        [
+            order(1, "bob", 10.5),
+            order(2, "alice", 4.25),
+            order(3, "bob", 1.0, status="pending"),
+            order(4, "carol", 7.0),
+        ],
+    )
+    out = run(str(f))
+    assert out.returncode == 0
+    assert out.stdout == (
+        "orders: 4\n"
+        "paid: 3\n"
+        "revenue: 21.75\n"
+        "top: bob\n"
+    )
+    assert out.stderr == ""
+
+
+def test_revenue_has_two_decimals(tmp_path):
+    f = write_orders(tmp_path, [order(1, "a", 3)])
+    out = run(str(f))
+    assert out.stdout.splitlines()[2] == "revenue: 3.00"
+
+
+def test_top_ignores_unpaid_revenue(tmp_path):
+    f = write_orders(
+        tmp_path,
+        [
+            order(1, "big", 100, status="refunded"),
+            order(2, "small", 5),
+        ],
+    )
+    out = run(str(f))
+    assert out.stdout.splitlines()[3] == "top: small"
+
+
+def test_top_sums_customer_revenue(tmp_path):
+    f = write_orders(
+        tmp_path,
+        [
+            order(1, "ann", 6),
+            order(2, "ann", 6),
+            order(3, "ben", 11),
+        ],
+    )
+    out = run(str(f))
+    assert out.stdout.splitlines()[3] == "top: ann"
+
+
+def test_top_tie_goes_to_alphabetically_first(tmp_path):
+    f = write_orders(
+        tmp_path,
+        [
+            order(1, "zoe", 5),
+            order(2, "amy", 5),
+            order(3, "mia", 5),
+        ],
+    )
+    out = run(str(f))
+    assert out.stdout.splitlines()[3] == "top: amy"
+
+
+def test_no_paid_orders(tmp_path):
+    f = write_orders(
+        tmp_path,
+        [order(1, "a", 9, status="pending")],
+    )
+    out = run(str(f))
+    assert out.returncode == 0
+    assert out.stdout == (
+        "orders: 1\n"
+        "paid: 0\n"
+        "revenue: 0.00\n"
+        "top: -\n"
+    )
+
+
+def test_empty_array(tmp_path):
+    f = write_orders(tmp_path, [])
+    out = run(str(f))
+    assert out.returncode == 0
+    assert out.stdout == (
+        "orders: 0\n"
+        "paid: 0\n"
+        "revenue: 0.00\n"
+        "top: -\n"
+    )
+
+
+def test_no_argument_prints_usage(tmp_path):
+    out = run()
+    assert out.returncode == 2
+    assert out.stderr.strip() == "usage: summarize.sh FILE"
+    assert out.stdout == ""
+
+
+def test_missing_file_is_error(tmp_path):
+    out = run(str(tmp_path / "missing.json"))
+    assert out.returncode == 1
+    assert out.stderr != ""
+    assert out.stdout == ""
+
+
+def test_invalid_json_is_error(tmp_path):
+    f = tmp_path / "bad.json"
+    f.write_text("[{\"id\": 1,")
+    out = run(str(f))
+    assert out.returncode == 1
+    assert out.stderr != ""
+    assert out.stdout == ""
+
+
+@pytest.mark.parametrize("content", ['{"id": 1}', "42", '"text"'])
+def test_non_array_json_is_error(tmp_path, content):
+    f = tmp_path / "obj.json"
+    f.write_text(content)
+    out = run(str(f))
+    assert out.returncode == 1
+    assert out.stderr != ""
+    assert out.stdout == ""

+def _get_once(url: str, timeout: float) -> object:
+    request = urllib.request.Request(
+        url,
+        headers={"Accept": "application/json", "User-Agent": "httpkit/1.0"},
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            status = response.status
+            body = response.read()
+    except urllib.error.HTTPError as exc:
+        raise HTTPStatusError(exc.code, url) from None
+
+    if not 200 <= status < 300:
+        raise HTTPStatusError(status, url)
+
+    try:
+        return json.loads(body)
+    except ValueError as exc:
+        raise ValueError(f"invalid JSON from {url}: {exc}") from exc
 
 
 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    attempts = retries + 1
+    for attempt in range(attempts):
+        try:
+            return _get_once(url, timeout)
+        except HTTPStatusError as exc:
+            # Only 5xx is retried; 4xx (and any other status) fails immediately.
+            if exc.status < 500 or attempt == attempts - 1:
+                raise
diff --git a/tests/test_fetch_json.py b/tests/test_fetch_json.py

+
+def _get_json(url: str, timeout: float) -> object:
+    request = urllib.request.Request(
+        url,
+        headers={"Accept": "application/json", "User-Agent": "httpkit/1.0"},
+    )
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            status = response.status
+            body = response.read()
+    except urllib.error.HTTPError as exc:
+        exc.close()
+        raise HTTPStatusError(exc.code, url) from exc
+    if not 200 <= status < 300:
+        raise HTTPStatusError(status, url)
+    return json.loads(body)
 
 
 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    attempt = 0
+    while True:
+        try:
+            return _get_json(url, timeout)
+        except HTTPStatusError as exc:
+            if exc.status < 500 or attempt >= retries:
+                raise
+            attempt += 1
diff --git a/tests/test_fetch_json.py b/tests/test_fetch_json.py
new file mode 100644
index 0000000..742a616
--- /dev/null
+++ b/tests/test_fetch_json.py
@@ -0,0 +1,97 @@
+import socket
+import threading
+import urllib.error
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from httpkit import HTTPStatusError, fetch_json
+
+
+class _Server:
+    def __init__(self, responses):
+        self.responses = list(responses)
+        self.requests = []
+        self.headers = []
+        owner = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                owner.headers.append(dict(self.headers))
+                owner.requests.append(self.path)
+                status, body = owner.responses.pop(0)
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+            def log_message(self, *args):
+                pass
+
+        self.httpd = HTTPServer(("127.0.0.1", 0), Handler)
+        self.url = f"http://127.0.0.1:{self.httpd.server_port}/resource"
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def __enter__(self):
+        self.thread.start()
+        return self
+
+    def __exit__(self, *exc_info):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+
+def test_returns_decoded_json_and_sends_headers():
+    with _Server([(200, b'{"ok": true, "n": 3}')]) as server:
+        assert fetch_json(server.url) == {"ok": True, "n": 3}
+    sent = server.headers[0]
+    assert sent["Accept"] == "application/json"
+    assert sent["User-Agent"] == "httpkit/1.0"
+
+
+def test_4xx_raises_without_retry():
+    with _Server([(404, b"{}"), (200, b"{}")]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url, retries=3)
+    assert info.value.status == 404
+    assert info.value.url == server.url
+    assert len(server.requests) == 1
+
+
+def test_5xx_retries_then_raises_last_status():
+    with _Server([(500, b"{}"), (502, b"{}"), (503, b"{}")]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url, retries=2)
+    assert info.value.status == 503
+    assert info.value.url == server.url
+    assert len(server.requests) == 3
+
+
+def test_5xx_then_success_returns_body():
+    with _Server([(500, b"{}"), (200, b'["a"]')]) as server:
+        assert fetch_json(server.url, retries=1) == ["a"]
+    assert len(server.requests) == 2
+
+
+def test_5xx_without_retries_makes_one_attempt():
+    with _Server([(500, b"{}"), (200, b"{}")]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url)
+    assert info.value.status == 500
+    assert len(server.requests) == 1
+
+
+def test_invalid_json_raises_value_error():
+    with _Server([(200, b"<html>not json</html>")]) as server:
+        with pytest.raises(ValueError):
+            fetch_json(server.url)
+
+
+def test_connection_refused_propagates_original_error():
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    with pytest.raises(urllib.error.URLError) as info:
+        fetch_json(f"http://127.0.0.1:{port}/", timeout=2.0)
+    assert not isinstance(info.value, HTTPStatusError)

 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    """GET url and return the decoded JSON body.
+    5xx responses are retried up to retries extra times; other non-2xx raise at once.
+    Network errors propagate unchanged.
+    """
+    request = urllib.request.Request(url, headers=HEADERS)
+    for attempt in range(retries + 1):
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                body = response.read()
+        except urllib.error.HTTPError as exc:
+            if exc.code >= 500 and attempt < retries:
+                continue
+            raise HTTPStatusError(exc.code, url) from exc
+        return json.loads(body)
diff --git a/tests/test_fetch_json.py b/tests/test_fetch_json.py

+++ b/tests/test_fetch_json.py
@@ -0,0 +1,132 @@
+import json
+import socket
+import threading
+import time
+import urllib.error
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+import pytest
+
+from httpkit import HTTPStatusError, fetch_json
+
+
+class _Server:
+    """Local HTTP server that replays queued (status, body) responses."""
+
+    def __init__(self):
+        self.responses = []
+        self.requests = []
+        self.delay = 0.0
+        owner = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                owner.requests.append(dict(self.headers))
+                if owner.delay:
+                    time.sleep(owner.delay)
+                status, body = owner.responses.pop(0) if len(owner.responses) > 1 else owner.responses[0]
+                payload = body.encode()
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(payload)))
+                self.end_headers()
+                self.wfile.write(payload)
+
+            def log_message(self, *args):
+                pass
+
+        self.httpd = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+        self.httpd.daemon_threads = True
+        self.url = f"http://127.0.0.1:{self.httpd.server_address[1]}/item"
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def __enter__(self):
+        self.thread.start()
+        return self
+
+    def __exit__(self, *exc_info):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+
+@pytest.fixture
+def server():
+    with _Server() as srv:
+        yield srv
+
+
+def test_returns_decoded_json_and_sends_headers(server):
+    server.responses = [(200, '{"id": 7, "tags": ["a"]}')]
+
+    assert fetch_json(server.url) == {"id": 7, "tags": ["a"]}
+    sent = server.requests[0]
+    assert sent["Accept"] == "application/json"
+    assert sent["User-Agent"] == "httpkit/1.0"
+
+
+def test_4xx_raises_status_error_without_retry(server):
+    server.responses = [(404, "{}")]
+
+    with pytest.raises(HTTPStatusError) as info:
+        fetch_json(server.url, retries=3)
+
+    assert info.value.status == 404
+    assert info.value.url == server.url
+    assert len(server.requests) == 1
+
+
+def test_5xx_is_retried_up_to_retries_then_raises_last_status(server):
+    server.responses = [(503, "{}")]
+
+    with pytest.raises(HTTPStatusError) as info:
+        fetch_json(server.url, retries=2)
+
+    assert info.value.status == 503
+    assert info.value.url == server.url
+    assert len(server.requests) == 3
+
+
+def test_5xx_without_retries_makes_single_attempt(server):
+    server.responses = [(500, "{}")]
+
+    with pytest.raises(HTTPStatusError) as info:
+        fetch_json(server.url)
+
+    assert info.value.status == 500
+    assert len(server.requests) == 1
+
+
+def test_5xx_then_success_returns_body(server):
+    server.responses = [(500, "{}"), (200, '{"ok": true}')]
+
+    assert fetch_json(server.url, retries=1) == {"ok": True}
+    assert len(server.requests) == 2
+
+
+def test_invalid_json_raises_value_error(server):
+    server.responses = [(200, "<html>not json</html>")]
+
+    with pytest.raises(ValueError):
+        fetch_json(server.url)
+
+
+def test_connection_refused_propagates_original_error():
+    probe = socket.socket()
+    probe.bind(("127.0.0.1", 0))
+    port = probe.getsockname()[1]
+    probe.close()
+
+    with pytest.raises(urllib.error.URLError) as info:
+        fetch_json(f"http://127.0.0.1:{port}/item", timeout=1.0)
+
+    assert not isinstance(info.value, HTTPStatusError)
+
+
+def test_timeout_propagates_original_error(server):
+    server.responses = [(200, "{}")]
+    server.delay = 1.0
+
+    with pytest.raises(OSError) as info:
+        fetch_json(server.url, timeout=0.1)
+
+    assert not isinstance(info.value, HTTPStatusError)

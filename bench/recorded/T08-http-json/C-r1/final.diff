 class HTTPStatusError(Exception):
-    pass
+    def __init__(self, status: int, url: str):
+        super().__init__(f"HTTP {status} for {url}")
+        self.status = status
+        self.url = url
 
 
 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    """GET url and return the decoded JSON body.
+
+    5xx responses are retried up to `retries` extra times.
+    Other non-2xx responses raise HTTPStatusError immediately.
+    """
+    request = urllib.request.Request(url, headers=HEADERS, method="GET")
+    for attempt in range(retries + 1):
+        try:
+            with urllib.request.urlopen(request, timeout=timeout) as response:
+                status = response.status
+                body = response.read()
+        except urllib.error.HTTPError as exc:
+            exc.close()
+            status = exc.code
+            body = None
+        if 200 <= status < 300:
+            break
+        logger.debug("HTTP %s from %s (attempt %d)", status, url, attempt + 1)
+        if status < 500 or attempt == retries:
+            raise HTTPStatusError(status, url)
+
+    try:
+        return json.loads(body)
+    except ValueError as exc:
+        raise ValueError(f"response from {url} is not valid JSON") from exc

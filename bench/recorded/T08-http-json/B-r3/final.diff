 class HTTPStatusError(Exception):
-    pass
+    def __init__(self, status: int, url: str):
+        super().__init__(f"HTTP {status} for {url}")
+        self.status = status
+        self.url = url
+
+
+def _get_once(url: str, timeout: float) -> bytes:
+    """Return the body of a 2xx response; raise HTTPStatusError otherwise."""
+    request = urllib.request.Request(url, headers=HEADERS, method="GET")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            status = response.status
+            body = response.read()
+    except urllib.error.HTTPError as exc:
+        raise HTTPStatusError(exc.code, url) from None
+    if not 200 <= status < 300:
+        raise HTTPStatusError(status, url)
+    return body
 
 
 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    """GET a URL and return its decoded JSON body.
+
+    A 5xx response is retried immediately, up to ``retries`` extra attempts.
+    Other non-2xx responses raise HTTPStatusError without retrying.
+    Network errors propagate unchanged.
+    """
+    if retries < 0:
+        raise ValueError("retries must be >= 0")
+    for attempt in range(retries + 1):
+        try:
+            body = _get_once(url, timeout)
+        except HTTPStatusError as exc:
+            if exc.status < 500 or attempt == retries:
+                raise
+            logger.warning("GET %s returned %d; retrying (%d left)",
+                           url, exc.status, retries - attempt)
+            continue
+        try:
+            return json.loads(body)
+        except ValueError as exc:
+            raise ValueError(f"response from {url} is not valid JSON") from exc
diff --git a/tests/test_fetch_json.py b/tests/test_fetch_json.py

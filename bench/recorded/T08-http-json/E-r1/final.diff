 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    """GET a URL and return the decoded JSON body.
+
+    A 5xx response is retried immediately, up to `retries` extra attempts.
+    Any other non-2xx response raises HTTPStatusError without retrying.
+    """
+    request = Request(
+        url,
+        headers={"Accept": "application/json", "User-Agent": "httpkit/1.0"},
+    )
+    attempts = retries + 1
+    for attempt in range(attempts):
+        try:
+            with urlopen(request, timeout=timeout) as response:
+                status = response.status
+                body = response.read()
+        except HTTPError as exc:
+            status = exc.code
+            body = None
+        if 200 <= status < 300:
+            return json.loads(body)
+        if status < 500 or attempt == attempts - 1:
+            raise HTTPStatusError(status, url)
+    raise AssertionError("unreachable")

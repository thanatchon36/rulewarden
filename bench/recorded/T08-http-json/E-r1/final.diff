--- /dev/null
+++ b/tests/test_fetch_json.py
@@ -0,0 +1,101 @@
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from httpkit import HTTPStatusError, fetch_json
+
+
+class _Handler(BaseHTTPRequestHandler):
+    def do_GET(self):
+        server = self.server
+        server.requests.append(dict(self.headers))
+        status, body = server.script.pop(0) if len(server.script) > 1 else server.script[0]
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, format, *args):
+        pass
+
+
+@pytest.fixture
+def serve():
+    servers = []
+
+    def _serve(*script):
+        server = HTTPServer(("127.0.0.1", 0), _Handler)
+        server.script = [(status, body if isinstance(body, bytes) else body.encode()) for status, body in script]
+        server.requests = []
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        servers.append(server)
+        return server, f"http://127.0.0.1:{server.server_address[1]}/"
+
+    yield _serve
+    for server in servers:
+        server.shutdown()
+        server.server_close()
+
+
+def test_returns_decoded_json_and_sends_headers(serve):
+    server, url = serve((200, json.dumps({"a": [1, 2]})))
+
+    assert fetch_json(url) == {"a": [1, 2]}
+    sent = server.requests[0]
+    assert sent["Accept"] == "application/json"
+    assert sent["User-Agent"] == "httpkit/1.0"
+
+
+def test_4xx_raises_without_retry(serve):
+    server, url = serve((404, "{}"), (200, "{}"))
+
+    with pytest.raises(HTTPStatusError) as info:
+        fetch_json(url, retries=3)
+    assert info.value.status == 404
+    assert info.value.url == url
+    assert len(server.requests) == 1
+
+
+def test_5xx_retried_then_succeeds(serve):
+    server, url = serve((503, "{}"), (500, "{}"), (200, '{"ok": true}'))
+
+    assert fetch_json(url, retries=2) == {"ok": True}
+    assert len(server.requests) == 3
+
+
+def test_5xx_exhausts_retries_and_raises_last_status(serve):
+    server, url = serve((500, "{}"), (502, "{}"))
+
+    with pytest.raises(HTTPStatusError) as info:
+        fetch_json(url, retries=1)
+    assert info.value.status == 502
+    assert len(server.requests) == 2
+
+
+def test_no_retries_by_default(serve):
+    server, url = serve((500, "{}"), (200, "{}"))
+
+    with pytest.raises(HTTPStatusError):
+        fetch_json(url)
+    assert len(server.requests) == 1
+
+
+def test_invalid_json_raises_value_error(serve):
+    _, url = serve((200, "not json"))
+
+    with pytest.raises(ValueError):
+        fetch_json(url)
+
+
+def test_connection_refused_propagates_original_error():
+    server = HTTPServer(("127.0.0.1", 0), _Handler)
+    port = server.server_address[1]
+    server.server_close()
+
+    with pytest.raises(OSError) as info:
+        fetch_json(f"http://127.0.0.1:{port}/", timeout=1.0)
+    assert not isinstance(info.value, HTTPStatusError)

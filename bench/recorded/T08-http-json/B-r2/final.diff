+++ b/tests/test_fetch_json.py
@@ -0,0 +1,104 @@
+import json
+import socket
+import threading
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+import pytest
+
+from httpkit import HTTPStatusError, fetch_json
+
+
+class _Server:
+    def __init__(self, responses):
+        self.responses = list(responses)
+        self.requests = []
+        handler = self._make_handler()
+        self.httpd = HTTPServer(("127.0.0.1", 0), handler)
+        self.url = f"http://127.0.0.1:{self.httpd.server_address[1]}/data"
+        self.thread = threading.Thread(target=self.httpd.serve_forever, daemon=True)
+
+    def _make_handler(self):
+        server = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def do_GET(self):
+                server.requests.append(dict(self.headers))
+                status, body = server.responses.pop(0)
+                payload = body if isinstance(body, bytes) else json.dumps(body).encode()
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(payload)))
+                self.end_headers()
+                self.wfile.write(payload)
+
+            def log_message(self, *args):
+                pass
+
+        return Handler
+
+    def __enter__(self):
+        self.thread.start()
+        return self
+
+    def __exit__(self, *exc):
+        self.httpd.shutdown()
+        self.httpd.server_close()
+
+
+def test_sends_accept_and_user_agent_headers():
+    with _Server([(200, {"ok": True})]) as server:
+        fetch_json(server.url)
+    headers = server.requests[0]
+    assert headers["Accept"] == "application/json"
+    assert headers["User-Agent"] == "httpkit/1.0"
+
+
+def test_returns_decoded_json_body():
+    with _Server([(200, {"items": [1, 2, 3]})]) as server:
+        assert fetch_json(server.url) == {"items": [1, 2, 3]}
+
+
+def test_4xx_raises_without_retry():
+    with _Server([(404, {}), (200, {})]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url, retries=2)
+    assert info.value.status == 404
+    assert info.value.url == server.url
+    assert len(server.requests) == 1
+
+
+def test_5xx_retried_then_succeeds():
+    with _Server([(503, {}), (500, {}), (200, {"ok": 1})]) as server:
+        assert fetch_json(server.url, retries=2) == {"ok": 1}
+    assert len(server.requests) == 3
+
+
+def test_5xx_exhausts_retries_and_raises_last_status():
+    with _Server([(502, {}), (503, {}), (504, {})]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url, retries=2)
+    assert info.value.status == 504
+    assert info.value.url == server.url
+    assert len(server.requests) == 3
+
+
+def test_no_retries_by_default():
+    with _Server([(500, {}), (200, {})]) as server:
+        with pytest.raises(HTTPStatusError) as info:
+            fetch_json(server.url)
+    assert info.value.status == 500
+    assert len(server.requests) == 1
+
+
+def test_invalid_json_raises_value_error():
+    with _Server([(200, b"not json")]) as server:
+        with pytest.raises(ValueError):
+            fetch_json(server.url)
+
+
+def test_connection_refused_propagates_original_error():
+    with socket.socket() as sock:
+        sock.bind(("127.0.0.1", 0))
+        port = sock.getsockname()[1]
+    with pytest.raises(ConnectionRefusedError):
+        fetch_json(f"http://127.0.0.1:{port}/", timeout=1.0, retries=2)

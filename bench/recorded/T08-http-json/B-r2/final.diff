+import json
+import logging
+import urllib.error
+import urllib.request
+
+logger = logging.getLogger(__name__)
+
+HEADERS = {"Accept": "application/json", "User-Agent": "httpkit/1.0"}
+
+
 class HTTPStatusError(Exception):
-    pass
+    def __init__(self, status: int, url: str):
+        super().__init__(f"HTTP {status} for {url}")
+        self.status = status
+        self.url = url
+
+
+def _get_once(url: str, timeout: float) -> bytes:
+    request = urllib.request.Request(url, headers=HEADERS, method="GET")
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            status = response.status
+            body = response.read()
+    except urllib.error.HTTPError as exc:
+        raise HTTPStatusError(exc.code, url) from exc
+    except urllib.error.URLError as exc:
+        if isinstance(exc.reason, Exception):
+            raise exc.reason from None
+        raise
+    if not 200 <= status < 300:
+        raise HTTPStatusError(status, url)
+    return body
 
 
 def fetch_json(url: str, timeout: float = 5.0, retries: int = 0) -> object:
-    raise NotImplementedError
+    """Send a GET request and return the decoded JSON body.
+
+    A 5xx response is retried immediately up to `retries` extra times.
+    Any other non-2xx response raises HTTPStatusError without retrying.
+    Network errors propagate unchanged.
+    """
+    attempt = 0
+    while True:
+        try:
+            body = _get_once(url, timeout)
+        except HTTPStatusError as exc:
+            if exc.status < 500 or attempt >= retries:
+                raise
+            attempt += 1
+            logger.debug("GET %s returned %d, retry %d/%d", url, exc.status, attempt, retries)
+            continue
+        break
+
+    try:
+        return json.loads(body)
+    except ValueError as exc:
+        raise ValueError(f"response from {url} is not valid JSON") from exc

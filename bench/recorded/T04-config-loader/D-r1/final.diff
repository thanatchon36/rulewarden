index 3e6f7d7..f736290 100644
--- a/src/appconfig/loader.py
+++ b/src/appconfig/loader.py
@@ -1,6 +1,60 @@
+import os
+import re
 from collections.abc import Mapping
+from configparser import ConfigParser
 from pathlib import Path
 
+_REFERENCE = re.compile(r"\$(\$|\{(\w+)\})")
+_INT = re.compile(r"[+-]?\d+", re.ASCII)
+_FLOAT = re.compile(r"[+-]?(\d+\.?\d*|\.\d+)([eE][+-]?\d+)?", re.ASCII)
+_TRUE = frozenset({"true", "yes", "on"})
+_FALSE = frozenset({"false", "no", "off"})
+
+
+def _interpolate(value: str, env: Mapping[str, str]) -> str:
+    """Expand ${NAME} from env in one pass; $$ becomes a literal $."""
+
+    def replace(match: re.Match[str]) -> str:
+        if match.group(1) == "$":
+            return "$"
+        name = match.group(2)
+        if name not in env:
+            raise KeyError(name)
+        return env[name]
+
+    return _REFERENCE.sub(replace, value)
+
+
+def _convert(text: str) -> object:
+    value = text.strip()
+    lowered = value.lower()
+    if lowered in _TRUE:
+        return True
+    if lowered in _FALSE:
+        return False
+    if _INT.fullmatch(value):
+        return int(value)
+    if _FLOAT.fullmatch(value):
+        return float(value)
+    return value
+
 
 def load_config(path: str | Path, env: Mapping[str, str] | None = None) -> dict[str, dict[str, object]]:
-    raise NotImplementedError
+    source = Path(path)
+    if not source.exists():
+        raise FileNotFoundError(f"config file not found: {source}")
+    environ = os.environ if env is None else env
+    parser = ConfigParser(interpolation=None)
+    parser.read(source, encoding="utf-8")
+    result: dict[str, dict[str, object]] = {}
+    for section in parser.sections():
+        values: dict[str, object] = {}
+        for key, raw in parser.items(section):
+            override = f"APP_{section}_{key}".upper()
+            if override in environ:
+                text = environ[override]
+            else:
+                text = _interpolate(raw, environ)
+            values[key] = _convert(text)
+        result[section] = values
+    return result
diff --git a/tests/test_loader_behaviour.py b/tests/test_loader_behaviour.py
new file mode 100644
index 0000000..df7dede
--- /dev/null
+++ b/tests/test_loader_behaviour.py
@@ -0,0 +1,135 @@
+import pytest
+
+from appconfig import load_config
+
+
+def write(tmp_path, text):
+    p = tmp_path / "app.ini"
+    p.write_text(text)
+    return p
+
+
+def test_missing_file_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        load_config(tmp_path / "absent.ini", env={})
+
+
+def test_accepts_str_path(tmp_path):
+    p = write(tmp_path, "[server]\nhost = localhost\n")
+    assert load_config(str(p), env={}) == {"server": {"host": "localhost"}}
+
+
+def test_default_section_applied_and_excluded(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\nTimeout = 30\n[a]\nname = x\n[b]\nTimeout = 5\n")
+    result = load_config(p, env={})
+    assert result == {"a": {"timeout": 30, "name": "x"}, "b": {"timeout": 5}}
+
+
+def test_keys_are_lowercase(tmp_path):
+    p = write(tmp_path, "[s]\nMixedCase = 1\n")
+    assert load_config(p, env={}) == {"s": {"mixedcase": 1}}
+
+
+def test_interpolates_env_reference(tmp_path):
+    p = write(tmp_path, "[db]\nurl = postgres://${DB_HOST}/app\n")
+    assert load_config(p, env={"DB_HOST": "db1"})["db"]["url"] == "postgres://db1/app"
+
+
+def test_double_dollar_is_literal(tmp_path):
+    p = write(tmp_path, "[s]\nprice = $$5 and $$${X}\n")
+    assert load_config(p, env={"X": "y"})["s"]["price"] == "$5 and $y"
+
+
+def test_lone_dollar_is_kept(tmp_path):
+    p = write(tmp_path, "[s]\nv = cost $5\n")
+    assert load_config(p, env={})["s"]["v"] == "cost $5"
+
+
+def test_missing_interpolation_variable_raises_key_error(tmp_path):
+    p = write(tmp_path, "[s]\nv = ${NOPE_VAR}\n")
+    with pytest.raises(KeyError, match="NOPE_VAR"):
+        load_config(p, env={})
+
+
+def test_interpolated_value_is_not_expanded_again(tmp_path):
+    p = write(tmp_path, "[s]\nv = ${A}\n")
+    assert load_config(p, env={"A": "${B}", "B": "x"})["s"]["v"] == "${B}"
+
+
+def test_override_replaces_value(tmp_path):
+    p = write(tmp_path, "[server]\nport = 8080\n")
+    result = load_config(p, env={"APP_SERVER_PORT": "9000"})
+    assert result["server"]["port"] == 9000
+
+
+def test_override_skips_interpolation_of_file_value(tmp_path):
+    p = write(tmp_path, "[server]\nhost = ${MISSING}\n")
+    result = load_config(p, env={"APP_SERVER_HOST": "example.org"})
+    assert result["server"]["host"] == "example.org"
+
+
+def test_override_applies_to_inherited_default_key(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\nlevel = info\n[a]\n")
+    assert load_config(p, env={"APP_A_LEVEL": "debug"})["a"]["level"] == "debug"
+
+
+def test_override_is_converted(tmp_path):
+    p = write(tmp_path, "[s]\nflag = 1\n")
+    assert load_config(p, env={"APP_S_FLAG": "off"})["s"]["flag"] is False
+
+
+def test_override_with_section_and_key_uppercased(tmp_path):
+    p = write(tmp_path, "[my]\nthe_key = a\n")
+    assert load_config(p, env={"APP_MY_THE_KEY": "b"})["my"]["the_key"] == "b"
+
+
+def test_override_does_not_touch_other_sections(tmp_path):
+    p = write(tmp_path, "[a]\nk = 1\n[b]\nk = 2\n")
+    result = load_config(p, env={"APP_A_K": "9"})
+    assert result == {"a": {"k": 9}, "b": {"k": 2}}
+
+
+@pytest.mark.parametrize("text", ["true", "YES", "On", " True "])
+def test_truthy_strings_become_true(tmp_path, text):
+    p = write(tmp_path, f"[s]\nv = {text}\n")
+    assert load_config(p, env={})["s"]["v"] is True
+
+
+@pytest.mark.parametrize("text", ["false", "No", "OFF"])
+def test_falsy_strings_become_false(tmp_path, text):
+    p = write(tmp_path, f"[s]\nv = {text}\n")
+    assert load_config(p, env={})["s"]["v"] is False
+
+
+def test_integers_become_int(tmp_path):
+    p = write(tmp_path, "[s]\nneg = -42\npos = 7\n")
+    values = load_config(p, env={})["s"]
+    assert values == {"neg": -42, "pos": 7}
+    assert type(values["neg"]) is int
+
+
+def test_decimals_become_float(tmp_path):
+    p = write(tmp_path, "[s]\na = 3.14\nb = -0.5\nc = .5\n")
+    assert load_config(p, env={})["s"] == {"a": 3.14, "b": -0.5, "c": 0.5}
+
+
+@pytest.mark.parametrize("text", ["nan", "inf", "1,000", "1_000", "0x10", "1.2.3"])
+def test_other_text_stays_string(tmp_path, text):
+    p = write(tmp_path, f"[s]\nv = {text}\n")
+    assert load_config(p, env={})["s"]["v"] == text
+
+
+def test_string_values_are_stripped(tmp_path):
+    p = write(tmp_path, "[s]\nv = hello world  \n")
+    assert load_config(p, env={})["s"]["v"] == "hello world"
+
+
+def test_percent_is_not_interpolated(tmp_path):
+    p = write(tmp_path, "[s]\nv = 100%\n")
+    assert load_config(p, env={})["s"]["v"] == "100%"
+
+
+def test_defaults_to_os_environ(tmp_path, monkeypatch):
+    monkeypatch.setenv("APP_S_HOST", "from-environ")
+    p = write(tmp_path, "[s]\nhost = localhost\n")
+    assert load_config(p)["s"]["host"] == "from-environ"

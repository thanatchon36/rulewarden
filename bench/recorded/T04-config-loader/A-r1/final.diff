index 3e6f7d7..c81da7f 100644
--- a/src/appconfig/loader.py
+++ b/src/appconfig/loader.py
@@ -1,6 +1,56 @@
+import configparser
+import os
+import re
 from collections.abc import Mapping
 from pathlib import Path
 
+_REFERENCE = re.compile(r"\$\$|\$\{([^}]*)\}")
+_INT = re.compile(r"[+-]?[0-9]+")
+_FLOAT = re.compile(r"[+-]?(?:[0-9]+\.[0-9]*|\.[0-9]+)")
+_BOOLS = {"true": True, "yes": True, "on": True, "false": False, "no": False, "off": False}
+
+
+def _interpolate(value: str, env: Mapping[str, str]) -> str:
+    def replace(match: re.Match[str]) -> str:
+        if match.group(0) == "$$":
+            return "$"
+        name = match.group(1)
+        if name not in env:
+            raise KeyError(name)
+        return env[name]
+
+    return _REFERENCE.sub(replace, value)
+
+
+def _convert(value: str) -> object:
+    stripped = value.strip()
+    lowered = stripped.lower()
+    if lowered in _BOOLS:
+        return _BOOLS[lowered]
+    if _INT.fullmatch(stripped):
+        return int(stripped)
+    if _FLOAT.fullmatch(stripped):
+        return float(stripped)
+    return stripped
+
 
 def load_config(path: str | Path, env: Mapping[str, str] | None = None) -> dict[str, dict[str, object]]:
-    raise NotImplementedError
+    if env is None:
+        env = os.environ
+
+    parser = configparser.ConfigParser(interpolation=None)
+    with open(path, encoding="utf-8") as handle:
+        parser.read_file(handle)
+
+    config: dict[str, dict[str, object]] = {}
+    for section in parser.sections():
+        values: dict[str, object] = {}
+        for key, raw in parser[section].items():
+            override = f"APP_{section.upper()}_{key.upper()}"
+            if override in env:
+                value = env[override]
+            else:
+                value = _interpolate(raw, env)
+            values[key] = _convert(value)
+        config[section] = values
+    return config
diff --git a/tests/test_config_loader.py b/tests/test_config_loader.py
new file mode 100644
index 0000000..36644fa
--- /dev/null
+++ b/tests/test_config_loader.py
@@ -0,0 +1,117 @@
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+from appconfig import load_config
+
+
+def write(tmp_path, text):
+    p = tmp_path / "app.ini"
+    p.write_text(text)
+    return p
+
+
+def test_missing_file_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        load_config(tmp_path / "missing.ini", env={})
+
+
+def test_accepts_str_path(tmp_path):
+    p = write(tmp_path, "[server]\nhost = localhost\n")
+    assert load_config(str(p), env={}) == {"server": {"host": "localhost"}}
+
+
+def test_keys_are_lowercased_and_default_section_excluded(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\nTimeout = 30\n[Server]\nHost = a\n")
+    assert load_config(p, env={}) == {"Server": {"host": "a", "timeout": 30}}
+
+
+def test_defaults_apply_to_every_section(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\nlevel = info\n[a]\n[b]\nlevel = debug\n")
+    assert load_config(p, env={}) == {"a": {"level": "info"}, "b": {"level": "debug"}}
+
+
+def test_interpolates_env_reference(tmp_path):
+    p = write(tmp_path, "[db]\nurl = postgres://${DB_HOST}/app\n")
+    assert load_config(p, env={"DB_HOST": "db1"})["db"]["url"] == "postgres://db1/app"
+
+
+def test_missing_interpolation_variable_raises_key_error(tmp_path):
+    p = write(tmp_path, "[db]\nurl = ${NOPE}\n")
+    with pytest.raises(KeyError, match="NOPE"):
+        load_config(p, env={})
+
+
+def test_double_dollar_is_literal(tmp_path):
+    p = write(tmp_path, "[s]\nprice = $$5 and $$${X}\n")
+    assert load_config(p, env={"X": "9"})["s"]["price"] == "$5 and $9"
+
+
+def test_bare_dollar_stays_literal(tmp_path):
+    p = write(tmp_path, "[s]\nv = cost $5\n")
+    assert load_config(p, env={})["s"]["v"] == "cost $5"
+
+
+def test_env_override_replaces_value(tmp_path):
+    p = write(tmp_path, "[server]\nhost = localhost\nport = 80\n")
+    result = load_config(p, env={"APP_SERVER_HOST": "example.com"})
+    assert result["server"] == {"host": "example.com", "port": 80}
+
+
+def test_env_override_skips_interpolation(tmp_path):
+    p = write(tmp_path, "[server]\nhost = ${MISSING}\n")
+    result = load_config(p, env={"APP_SERVER_HOST": "example.com"})
+    assert result["server"]["host"] == "example.com"
+
+
+def test_env_override_applies_to_default_key(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\ndebug = false\n[web]\n")
+    assert load_config(p, env={"APP_WEB_DEBUG": "true"})["web"]["debug"] is True
+
+
+def test_env_override_is_converted(tmp_path):
+    p = write(tmp_path, "[s]\nretries = 1\n")
+    assert load_config(p, env={"APP_S_RETRIES": "7"})["s"]["retries"] == 7
+
+
+def test_env_defaults_to_os_environ(tmp_path, monkeypatch):
+    monkeypatch.setenv("APP_S_HOST", "from-os")
+    monkeypatch.setenv("TOKEN", "abc")
+    p = write(tmp_path, "[s]\nhost = x\ntoken = ${TOKEN}\n")
+    assert load_config(p) == {"s": {"host": "from-os", "token": "abc"}}
+
+
+@pytest.mark.parametrize("raw", ["true", "yes", "on", "TRUE", "Yes", "ON"])
+def test_truthy_strings_become_true(tmp_path, raw):
+    p = write(tmp_path, f"[s]\nv = {raw}\n")
+    assert load_config(p, env={})["s"]["v"] is True
+
+
+@pytest.mark.parametrize("raw", ["false", "no", "off", "FALSE", "No", "OFF"])
+def test_falsy_strings_become_false(tmp_path, raw):
+    p = write(tmp_path, f"[s]\nv = {raw}\n")
+    assert load_config(p, env={})["s"]["v"] is False
+
+
+def test_integers_become_int(tmp_path):
+    p = write(tmp_path, "[s]\na = 42\nb = -3\nc = +7\n")
+    assert load_config(p, env={}) == {"s": {"a": 42, "b": -3, "c": 7}}
+
+
+def test_decimals_become_float(tmp_path):
+    p = write(tmp_path, "[s]\na = 3.5\nb = -0.25\nc = 2.\nd = .5\n")
+    result = load_config(p, env={})["s"]
+    assert result == {"a": 3.5, "b": -0.25, "c": 2.0, "d": 0.5}
+    assert all(isinstance(v, float) for v in result.values())
+
+
+def test_other_values_stay_strings_stripped(tmp_path):
+    p = write(tmp_path, "[s]\nname = hello world\nversion = 1.2.3\nempty =\n")
+    assert load_config(p, env={})["s"] == {"name": "hello world", "version": "1.2.3", "empty": ""}
+
+
+def test_override_value_is_stripped_string(tmp_path):
+    p = write(tmp_path, "[s]\nname = a\n")
+    assert load_config(p, env={"APP_S_NAME": "  padded  "})["s"]["name"] == "padded"

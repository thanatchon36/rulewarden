@@ -1,6 +1,69 @@
+import configparser
+import os
+import re
 from collections.abc import Mapping
 from pathlib import Path
 
+_VARIABLE = re.compile(r"\$\$|\$\{([^}]*)\}")
+_TRUE = {"true", "yes", "on"}
+_FALSE = {"false", "no", "off"}
+_INT = re.compile(r"[+-]?[0-9]+")
+_FLOAT = re.compile(r"[+-]?(?:[0-9]+\.[0-9]*|\.[0-9]+)")
+
+
+def _interpolate(raw: str, env: Mapping[str, str]) -> str:
+    """Expand ``${NAME}`` from ``env`` and ``$$`` to ``$`` in a single pass."""
+
+    def replace(match: re.Match[str]) -> str:
+        if match.group(0) == "$$":
+            return "$"
+        name = match.group(1)
+        if name not in env:
+            raise KeyError(name)
+        return env[name]
+
+    return _VARIABLE.sub(replace, raw)
+
+
+def _convert(value: str) -> object:
+    text = value.strip()
+    lowered = text.lower()
+    if lowered in _TRUE:
+        return True
+    if lowered in _FALSE:
+        return False
+    if _INT.fullmatch(text):
+        return int(text)
+    if _FLOAT.fullmatch(text):
+        return float(text)
+    return text
+
 
 def load_config(path: str | Path, env: Mapping[str, str] | None = None) -> dict[str, dict[str, object]]:
-    raise NotImplementedError
+    """Load an INI file into typed sections, applying ``${NAME}`` interpolation.
+
+    ``APP_<SECTION>_<KEY>`` entries in ``env`` replace the file value without
+    interpolation. ``env`` defaults to ``os.environ``.
+    """
+    source = Path(path)
+    if not source.exists():
+        raise FileNotFoundError(f"config file not found: {source}")
+    if env is None:
+        env = os.environ
+
+    parser = configparser.ConfigParser(interpolation=None)
+    with source.open(encoding="utf-8") as handle:
+        parser.read_file(handle)
+
+    result: dict[str, dict[str, object]] = {}
+    for section in parser.sections():
+        values: dict[str, object] = {}
+        for key, raw in parser.items(section):
+            override = f"APP_{section.upper()}_{key.upper()}"
+            if override in env:
+                text = env[override]
+            else:
+                text = _interpolate(raw, env)
+            values[key] = _convert(text)
+        result[section] = values
+    return result
diff --git a/tests/test_loader_behaviour.py b/tests/test_loader_behaviour.py
new file mode 100644
index 0000000..3171498
--- /dev/null
+++ b/tests/test_loader_behaviour.py
@@ -0,0 +1,140 @@
+import pytest
+
+from appconfig import load_config
+
+
+def write_ini(tmp_path, text):
+    p = tmp_path / "app.ini"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_missing_file_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        load_config(tmp_path / "absent.ini", env={})
+
+
+def test_accepts_str_path(tmp_path):
+    p = write_ini(tmp_path, "[a]\nk = v\n")
+    assert load_config(str(p), env={}) == {"a": {"k": "v"}}
+
+
+def test_default_section_excluded_and_applied_to_every_section(tmp_path):
+    p = write_ini(tmp_path, "[DEFAULT]\nshared = 1\n[one]\nx = a\n[two]\nshared = 2\n")
+    cfg = load_config(p, env={})
+    assert set(cfg) == {"one", "two"}
+    assert cfg["one"]["shared"] == 1
+    assert cfg["two"]["shared"] == 2
+
+
+def test_keys_are_lowercased(tmp_path):
+    p = write_ini(tmp_path, "[s]\nMixedKey = v\n")
+    assert load_config(p, env={})["s"] == {"mixedkey": "v"}
+
+
+def test_interpolates_env_variable(tmp_path):
+    p = write_ini(tmp_path, "[db]\nurl = postgres://${HOST}:5432\n")
+    assert load_config(p, env={"HOST": "db.local"})["db"]["url"] == "postgres://db.local:5432"
+
+
+def test_missing_variable_raises_key_error_with_name(tmp_path):
+    p = write_ini(tmp_path, "[db]\nurl = ${NOPE}\n")
+    with pytest.raises(KeyError) as exc:
+        load_config(p, env={})
+    assert exc.value.args == ("NOPE",)
+
+
+def test_double_dollar_is_literal_dollar(tmp_path):
+    p = write_ini(tmp_path, "[s]\nprice = $$5 and $${HOST}\n")
+    assert load_config(p, env={"HOST": "x"})["s"]["price"] == "$5 and ${HOST}"
+
+
+def test_interpolated_value_is_not_reexpanded(tmp_path):
+    p = write_ini(tmp_path, "[s]\nv = ${A}\n")
+    assert load_config(p, env={"A": "$${B}"})["s"]["v"] == "$${B}"
+
+
+def test_percent_is_not_special(tmp_path):
+    p = write_ini(tmp_path, "[s]\nv = 50%% off %(x)s\n")
+    assert load_config(p, env={})["s"]["v"] == "50%% off %(x)s"
+
+
+def test_env_override_replaces_value(tmp_path):
+    p = write_ini(tmp_path, "[server]\nport = 80\n")
+    assert load_config(p, env={"APP_SERVER_PORT": "9000"})["server"]["port"] == 9000
+
+
+def test_env_override_skips_interpolation_of_file_value(tmp_path):
+    p = write_ini(tmp_path, "[server]\nhost = ${UNDEFINED}\n")
+    cfg = load_config(p, env={"APP_SERVER_HOST": "example.com"})
+    assert cfg["server"]["host"] == "example.com"
+
+
+def test_env_override_is_not_interpolated(tmp_path):
+    p = write_ini(tmp_path, "[s]\nv = a\n")
+    assert load_config(p, env={"APP_S_V": "$${X}"})["s"]["v"] == "$${X}"
+
+
+def test_env_override_applies_to_default_inherited_key(tmp_path):
+    p = write_ini(tmp_path, "[DEFAULT]\nlevel = 1\n[svc]\n")
+    assert load_config(p, env={"APP_SVC_LEVEL": "5"})["svc"]["level"] == 5
+
+
+def test_env_override_uses_uppercased_section_and_key(tmp_path):
+    p = write_ini(tmp_path, "[my-svc]\nretry.count = 1\n")
+    assert load_config(p, env={"APP_MY-SVC_RETRY.COUNT": "7"})["my-svc"]["retry.count"] == 7
+
+
+def test_env_defaults_to_os_environ(tmp_path, monkeypatch):
+    monkeypatch.setenv("APP_S_V", "from-environ")
+    monkeypatch.setenv("HOST_FOR_TEST", "h")
+    p = write_ini(tmp_path, "[s]\nv = a\nw = ${HOST_FOR_TEST}\n")
+    assert load_config(p) == {"s": {"v": "from-environ", "w": "h"}}
+
+
+@pytest.mark.parametrize("raw", ["true", "yes", "on", "TRUE", "Yes", "ON"])
+def test_truthy_strings_become_true(tmp_path, raw):
+    p = write_ini(tmp_path, f"[s]\nv = {raw}\n")
+    assert load_config(p, env={})["s"]["v"] is True
+
+
+@pytest.mark.parametrize("raw", ["false", "no", "off", "FALSE", "No", "Off"])
+def test_falsy_strings_become_false(tmp_path, raw):
+    p = write_ini(tmp_path, f"[s]\nv = {raw}\n")
+    assert load_config(p, env={})["s"]["v"] is False
+
+
+def test_integers_become_int(tmp_path):
+    p = write_ini(tmp_path, "[s]\na = 42\nb = -7\nc = +3\nd = 0\n")
+    cfg = load_config(p, env={})["s"]
+    assert cfg == {"a": 42, "b": -7, "c": 3, "d": 0}
+    assert all(type(v) is int for v in cfg.values())
+
+
+def test_decimals_become_float(tmp_path):
+    p = write_ini(tmp_path, "[s]\na = 3.5\nb = -0.25\nc = .5\nd = 2.\n")
+    cfg = load_config(p, env={})["s"]
+    assert cfg == {"a": 3.5, "b": -0.25, "c": 0.5, "d": 2.0}
+    assert all(type(v) is float for v in cfg.values())
+
+
+@pytest.mark.parametrize("raw", ["nan", "inf", "1_000", "1e5", "0x1f", "1.2.3"])
+def test_other_numeric_looking_text_stays_string(tmp_path, raw):
+    p = write_ini(tmp_path, f"[s]\nv = {raw}\n")
+    assert load_config(p, env={})["s"]["v"] == raw
+
+
+def test_plain_strings_are_stripped(tmp_path):
+    p = write_ini(tmp_path, "[s]\nv = hello world  \n")
+    assert load_config(p, env={})["s"]["v"] == "hello world"
+
+
+def test_interpolated_value_is_stripped_before_conversion(tmp_path):
+    p = write_ini(tmp_path, "[s]\nv = ${A}\n")
+    cfg = load_config(p, env={"A": "  12  "})
+    assert cfg["s"]["v"] == 12
+
+
+def test_empty_section_yields_empty_dict(tmp_path):
+    p = write_ini(tmp_path, "[empty]\n")
+    assert load_config(p, env={}) == {"empty": {}}

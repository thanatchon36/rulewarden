@@ -1,6 +1,58 @@
+import configparser
+import os
+import re
 from collections.abc import Mapping
 from pathlib import Path
 
+_TRUE = {"true", "yes", "on"}
+_FALSE = {"false", "no", "off"}
+_INT = re.compile(r"[+-]?[0-9]+")
+_FLOAT = re.compile(r"[+-]?(?:[0-9]+\.[0-9]*|\.[0-9]+|[0-9]+)(?:[eE][+-]?[0-9]+)?")
+_REFERENCE = re.compile(r"\$(\$|\{([^}]+)\})")
+
+
+def _interpolate(value: str, variables: Mapping[str, str]) -> str:
+    def replace(match: re.Match[str]) -> str:
+        if match.group(1) == "$":
+            return "$"
+        name = match.group(2)
+        if name not in variables:
+            raise KeyError(name)
+        return variables[name]
+
+    return _REFERENCE.sub(replace, value)
+
+
+def _convert(text: str) -> object:
+    stripped = text.strip()
+    lowered = stripped.lower()
+    if lowered in _TRUE:
+        return True
+    if lowered in _FALSE:
+        return False
+    if _INT.fullmatch(stripped):
+        return int(stripped)
+    if _FLOAT.fullmatch(stripped):
+        return float(stripped)
+    return stripped
+
 
 def load_config(path: str | Path, env: Mapping[str, str] | None = None) -> dict[str, dict[str, object]]:
-    raise NotImplementedError
+    """Load an INI file into a dict of sections, with ${NAME} and APP_<SECTION>_<KEY> env support."""
+    source = Path(path)
+    if not source.exists():
+        raise FileNotFoundError(source)
+    variables = os.environ if env is None else env
+
+    parser = configparser.ConfigParser(interpolation=None)
+    parser.read_string(source.read_text(encoding="utf-8"))
+
+    result: dict[str, dict[str, object]] = {}
+    for section in parser.sections():
+        values: dict[str, object] = {}
+        for key, raw in parser[section].items():
+            override = variables.get(f"APP_{section.upper()}_{key.upper()}")
+            text = override if override is not None else _interpolate(raw, variables)
+            values[key] = _convert(text)
+        result[section] = values
+    return result
diff --git a/tests/test_loader_behaviour.py b/tests/test_loader_behaviour.py

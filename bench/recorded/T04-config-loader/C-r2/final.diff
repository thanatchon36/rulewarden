index 0000000..967f4c1
--- /dev/null
+++ b/tests/test_loader_behaviour.py
@@ -0,0 +1,131 @@
+import os
+
+import pytest
+
+from appconfig import load_config
+
+
+def write(tmp_path, text):
+    p = tmp_path / "app.ini"
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def test_missing_file_raises(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        load_config(tmp_path / "missing.ini", env={})
+
+
+def test_accepts_str_path(tmp_path):
+    p = write(tmp_path, "[a]\nk = v\n")
+    assert load_config(str(p), env={}) == {"a": {"k": "v"}}
+
+
+def test_default_section_excluded_and_applied(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\nretries = 3\n[a]\nx = 1\n[b]\nretries = 5\n")
+    assert load_config(p, env={}) == {"a": {"retries": 3, "x": 1}, "b": {"retries": 5}}
+
+
+def test_keys_are_lowercase_and_sections_keep_case(tmp_path):
+    p = write(tmp_path, "[Server]\nHOST = example\n")
+    assert load_config(p, env={}) == {"Server": {"host": "example"}}
+
+
+def test_interpolates_from_env(tmp_path):
+    p = write(tmp_path, "[db]\nurl = postgres://${DB_HOST}:${DB_PORT}/x\n")
+    cfg = load_config(p, env={"DB_HOST": "h", "DB_PORT": "5432"})
+    assert cfg["db"]["url"] == "postgres://h:5432/x"
+
+
+def test_missing_interpolation_variable_raises_key_error(tmp_path):
+    p = write(tmp_path, "[db]\nurl = ${NOPE}\n")
+    with pytest.raises(KeyError, match="NOPE"):
+        load_config(p, env={})
+
+
+def test_double_dollar_is_literal(tmp_path):
+    p = write(tmp_path, "[a]\nprice = $$5\nbraces = $${HOME}\nlone = cost $\n")
+    cfg = load_config(p, env={"HOME": "/x"})
+    assert cfg["a"] == {"price": "$5", "braces": "${HOME}", "lone": "cost $"}
+
+
+def test_default_env_is_os_environ(tmp_path, monkeypatch):
+    monkeypatch.setenv("APPCFG_TEST_VALUE", "from-os")
+    p = write(tmp_path, "[a]\nv = ${APPCFG_TEST_VALUE}\n")
+    assert load_config(p)["a"]["v"] == "from-os"
+
+
+def test_env_override_replaces_value_without_interpolating(tmp_path):
+    p = write(tmp_path, "[server]\nhost = ${MISSING}\nport = 80\n")
+    cfg = load_config(p, env={"APP_SERVER_HOST": "${NOT_EXPANDED}", "APP_SERVER_PORT": "8080"})
+    assert cfg["server"] == {"host": "${NOT_EXPANDED}", "port": 8080}
+
+
+def test_env_override_applies_to_default_keys(tmp_path):
+    p = write(tmp_path, "[DEFAULT]\ntimeout = 5\n[svc]\nname = s\n")
+    cfg = load_config(p, env={"APP_SVC_TIMEOUT": "9"})
+    assert cfg["svc"] == {"timeout": 9, "name": "s"}
+
+
+def test_env_override_uses_uppercased_section_and_key(tmp_path):
+    p = write(tmp_path, "[Log]\nLevel = info\n")
+    assert load_config(p, env={"APP_LOG_LEVEL": "debug"})["Log"]["level"] == "debug"
+
+
+@pytest.mark.parametrize("text", ["true", "yes", "on", "TRUE", "Yes", "ON"])
+def test_truthy_strings_become_true(tmp_path, text):
+    p = write(tmp_path, f"[a]\nv = {text}\n")
+    assert load_config(p, env={})["a"]["v"] is True
+
+
+@pytest.mark.parametrize("text", ["false", "no", "off", "FALSE", "No", "OFF"])
+def test_falsy_strings_become_false(tmp_path, text):
+    p = write(tmp_path, f"[a]\nv = {text}\n")
+    assert load_config(p, env={})["a"]["v"] is False
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [("42", 42), ("-7", -7), ("+3", 3), ("0", 0)],
+)
+def test_integers(tmp_path, text, expected):
+    p = write(tmp_path, f"[a]\nv = {text}\n")
+    value = load_config(p, env={})["a"]["v"]
+    assert value == expected and type(value) is int
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [("1.5", 1.5), ("-0.25", -0.25), (".5", 0.5), ("3.", 3.0), ("1e3", 1000.0)],
+)
+def test_decimals(tmp_path, text, expected):
+    p = write(tmp_path, f"[a]\nv = {text}\n")
+    value = load_config(p, env={})["a"]["v"]
+    assert value == expected and type(value) is float
+
+
+@pytest.mark.parametrize("text", ["nan", "inf", "1_000", "1.2.3", "12abc", "0x1F"])
+def test_non_numeric_text_stays_string(tmp_path, text):
+    p = write(tmp_path, f"[a]\nv = {text}\n")
+    assert load_config(p, env={})["a"]["v"] == text
+
+
+def test_plain_string_is_stripped(tmp_path):
+    p = write(tmp_path, "[a]\nv =   hello world  \n")
+    assert load_config(p, env={})["a"]["v"] == "hello world"
+
+
+def test_override_value_is_converted_and_stripped(tmp_path):
+    p = write(tmp_path, "[a]\nv = text\n")
+    cfg = load_config(p, env={"APP_A_V": "  yes  "})
+    assert cfg["a"]["v"] is True
+
+
+def test_interpolated_value_is_converted(tmp_path):
+    p = write(tmp_path, "[a]\nv = ${N}\n")
+    assert load_config(p, env={"N": "12"})["a"]["v"] == 12
+
+
+def test_empty_env_override_is_used(tmp_path):
+    p = write(tmp_path, "[a]\nv = set\n")
+    assert load_config(p, env={"APP_A_V": ""})["a"]["v"] == ""

+import argparse
+import sys
+
+from inventory.core import Inventory
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="inventory")
+    parser.add_argument("--db", required=True, help="path to the inventory JSON file")
+    subparsers = parser.add_subparsers(dest="command", required=True)
+
+    add_parser = subparsers.add_parser("add", help="add stock of an item")
+    add_parser.add_argument("name")
+    add_parser.add_argument("qty", type=int)
+
+    remove_parser = subparsers.add_parser("remove", help="remove stock of an item")
+    remove_parser.add_argument("name")
+    remove_parser.add_argument("qty", type=int)
+
+    subparsers.add_parser("list", help="list all items")
+    return parser
+
+
 def main(argv: list[str] | None = None) -> int:
-    raise NotImplementedError
+    args = _build_parser().parse_args(argv)
+    try:
+        inventory = Inventory.load(args.db)
+        if args.command == "add":
+            inventory.add(args.name, args.qty)
+            inventory.save(args.db)
+        elif args.command == "remove":
+            inventory.remove(args.name, args.qty)
+            inventory.save(args.db)
+        else:
+            for name, qty in inventory.items():
+                print(f"{name} {qty}")
+    except (KeyError, ValueError) as exc:
+        print(f"error: {exc.args[0]}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/src/inventory/core.py b/src/inventory/core.py
index b7483f3..5a39650 100644
--- a/src/inventory/core.py
+++ b/src/inventory/core.py
@@ -1,2 +1,54 @@
+import json
+from pathlib import Path
+
+
+def _check_qty(qty: object) -> None:
+    if isinstance(qty, bool) or not isinstance(qty, int) or qty <= 0:
+        raise ValueError(f"quantity must be a positive int, got {qty!r}")
+
+
 class Inventory:
-    pass
+    """Item name to quantity mapping, persisted as a JSON object."""
+
+    def __init__(self, quantities: dict[str, int] | None = None) -> None:
+        self._quantities: dict[str, int] = dict(quantities or {})
+
+    @classmethod
+    def load(cls, path: str | Path) -> "Inventory":
+        """Read an inventory from path; a missing file gives an empty inventory."""
+        path = Path(path)
+        if not path.exists():
+            return cls()
+        data = json.loads(path.read_text(encoding="utf-8"))
+        if not isinstance(data, dict):
+            raise ValueError(f"inventory file must hold a JSON object: {path}")
+        return cls(data)
+
+    def save(self, path: str | Path) -> None:
+        """Write the inventory to path as a JSON object with sorted keys."""
+        Path(path).write_text(
+            json.dumps(self._quantities, sort_keys=True, indent=2) + "\n",
+            encoding="utf-8",
+        )
+
+    def add(self, name: str, qty: int) -> None:
+        """Increase the stock of name by qty."""
+        _check_qty(qty)
+        self._quantities[name] = self._quantities.get(name, 0) + qty
+
+    def remove(self, name: str, qty: int) -> None:
+        """Decrease the stock of name by qty; drop the item when it reaches 0."""
+        _check_qty(qty)
+        if name not in self._quantities:
+            raise KeyError(f"unknown item: {name}")
+        current = self._quantities[name]
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {name}: only {current} in stock")
+        if qty == current:
+            del self._quantities[name]
+        else:
+            self._quantities[name] = current - qty
+
+    def items(self) -> list[tuple[str, int]]:
+        """Return (name, qty) pairs sorted by name."""
+        return sorted(self._quantities.items())
diff --git a/tests/test_behaviour.py b/tests/test_behaviour.py
new file mode 100644
index 0000000..f0aa824
--- /dev/null
+++ b/tests/test_behaviour.py
@@ -0,0 +1,125 @@
+import json
+
+import pytest
+
+from inventory.cli import main
+from inventory.core import Inventory
+
+
+def test_load_missing_file_is_empty(tmp_path):
+    assert Inventory.load(tmp_path / "missing.json").items() == []
+
+
+def test_save_writes_sorted_keys(tmp_path):
+    path = tmp_path / "inv.json"
+    inv = Inventory()
+    inv.add("pear", 2)
+    inv.add("apple", 5)
+    inv.save(path)
+    assert list(json.loads(path.read_text())) == ["apple", "pear"]
+
+
+def test_save_then_load_round_trip(tmp_path):
+    path = tmp_path / "inv.json"
+    inv = Inventory()
+    inv.add("bolt", 7)
+    inv.save(path)
+    assert Inventory.load(path).items() == [("bolt", 7)]
+
+
+def test_add_accumulates():
+    inv = Inventory()
+    inv.add("bolt", 2)
+    inv.add("bolt", 3)
+    assert inv.items() == [("bolt", 5)]
+
+
+@pytest.mark.parametrize("qty", [0, -1, 1.5, "2", True])
+def test_add_rejects_non_positive_or_non_int(qty):
+    with pytest.raises(ValueError):
+        Inventory().add("bolt", qty)
+
+
+def test_remove_reduces_quantity():
+    inv = Inventory()
+    inv.add("bolt", 5)
+    inv.remove("bolt", 2)
+    assert inv.items() == [("bolt", 3)]
+
+
+def test_remove_to_zero_deletes_item():
+    inv = Inventory()
+    inv.add("bolt", 5)
+    inv.remove("bolt", 5)
+    assert inv.items() == []
+
+
+def test_remove_unknown_item_raises_key_error():
+    with pytest.raises(KeyError):
+        Inventory().remove("bolt", 1)
+
+
+def test_remove_more_than_stock_raises_value_error():
+    inv = Inventory()
+    inv.add("bolt", 2)
+    with pytest.raises(ValueError):
+        inv.remove("bolt", 3)
+    assert inv.items() == [("bolt", 2)]
+
+
+@pytest.mark.parametrize("qty", [0, -4, 2.0])
+def test_remove_rejects_non_positive_or_non_int(qty):
+    inv = Inventory()
+    inv.add("bolt", 5)
+    with pytest.raises(ValueError):
+        inv.remove("bolt", qty)
+
+
+def test_items_sorted_by_name():
+    inv = Inventory()
+    inv.add("pear", 1)
+    inv.add("apple", 2)
+    assert inv.items() == [("apple", 2), ("pear", 1)]
+
+
+def test_cli_add_list_remove_flow(tmp_path, capsys):
+    db = str(tmp_path / "inv.json")
+    assert main(["--db", db, "add", "bolt", "4"]) == 0
+    assert main(["--db", db, "add", "nut", "2"]) == 0
+    assert main(["--db", db, "remove", "bolt", "1"]) == 0
+    capsys.readouterr()
+    assert main(["--db", db, "list"]) == 0
+    assert capsys.readouterr().out == "bolt 3\nnut 2\n"
+
+
+def test_cli_changes_are_saved(tmp_path):
+    db = tmp_path / "inv.json"
+    main(["--db", str(db), "add", "bolt", "4"])
+    assert json.loads(db.read_text()) == {"bolt": 4}
+
+
+def test_cli_remove_unknown_reports_error(tmp_path, capsys):
+    db = str(tmp_path / "inv.json")
+    assert main(["--db", db, "remove", "bolt", "1"]) == 1
+    assert capsys.readouterr().err.startswith("error: ")
+
+
+def test_cli_remove_too_many_reports_error(tmp_path, capsys):
+    db = str(tmp_path / "inv.json")
+    main(["--db", db, "add", "bolt", "1"])
+    assert main(["--db", db, "remove", "bolt", "2"]) == 1
+    assert capsys.readouterr().err.startswith("error: ")
+    assert Inventory.load(db).items() == [("bolt", 1)]
+
+
+def test_cli_add_non_positive_reports_error(tmp_path, capsys):
+    db = str(tmp_path / "inv.json")
+    assert main(["--db", db, "add", "bolt", "0"]) == 1
+    assert capsys.readouterr().err.startswith("error: ")
+
+
+def test_cli_corrupt_database_reports_error(tmp_path, capsys):
+    db = tmp_path / "inv.json"
+    db.write_text("[1, 2]")
+    assert main(["--db", str(db), "list"]) == 1
+    assert capsys.readouterr().err.startswith("error: ")

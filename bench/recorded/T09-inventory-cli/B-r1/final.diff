+import argparse
+import sys
+
+from inventory.core import Inventory
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(prog="inventory")
+    parser.add_argument("--db", required=True, help="path to the JSON database file")
+    commands = parser.add_subparsers(dest="command", required=True)
+
+    add = commands.add_parser("add", help="add stock of an item")
+    add.add_argument("name")
+    add.add_argument("qty", type=int)
+
+    remove = commands.add_parser("remove", help="remove stock of an item")
+    remove.add_argument("name")
+    remove.add_argument("qty", type=int)
+
+    commands.add_parser("list", help="list all items")
+    return parser
+
+
 def main(argv: list[str] | None = None) -> int:
-    raise NotImplementedError
+    args = build_parser().parse_args(argv)
+    try:
+        inventory = Inventory.load(args.db)
+        if args.command == "add":
+            inventory.add(args.name, args.qty)
+            inventory.save(args.db)
+        elif args.command == "remove":
+            inventory.remove(args.name, args.qty)
+            inventory.save(args.db)
+        else:
+            for name, qty in inventory.items():
+                sys.stdout.write(f"{name} {qty}\n")
+    except (KeyError, ValueError) as exc:
+        sys.stderr.write(f"error: {exc.args[0]}\n")
+        return 1
+    return 0
diff --git a/src/inventory/core.py b/src/inventory/core.py
index b7483f3..272cd64 100644
--- a/src/inventory/core.py
+++ b/src/inventory/core.py
@@ -1,2 +1,52 @@
+import json
+from pathlib import Path
+
+
+def _check_qty(qty: object) -> None:
+    if not isinstance(qty, int) or isinstance(qty, bool) or qty <= 0:
+        raise ValueError(f"quantity must be a positive integer, got {qty!r}")
+
+
 class Inventory:
-    pass
+    """Item quantities keyed by name, persisted as a JSON object."""
+
+    def __init__(self, items: dict[str, int] | None = None) -> None:
+        self._items: dict[str, int] = dict(items or {})
+
+    @classmethod
+    def load(cls, path: str | Path) -> "Inventory":
+        """Read an inventory from a JSON file; a missing file gives an empty one."""
+        path = Path(path)
+        if not path.exists():
+            return cls()
+        data = json.loads(path.read_text(encoding="utf-8"))
+        if not isinstance(data, dict):
+            raise ValueError(f"inventory file must contain a JSON object: {path}")
+        return cls(data)
+
+    def save(self, path: str | Path) -> None:
+        """Write the inventory to a JSON file with keys sorted."""
+        text = json.dumps(self._items, sort_keys=True, indent=2)
+        Path(path).write_text(text + "\n", encoding="utf-8")
+
+    def add(self, name: str, qty: int) -> None:
+        """Increase the stock of an item by qty."""
+        _check_qty(qty)
+        self._items[name] = self._items.get(name, 0) + qty
+
+    def remove(self, name: str, qty: int) -> None:
+        """Decrease the stock of an item by qty; the item is dropped at zero."""
+        _check_qty(qty)
+        if name not in self._items:
+            raise KeyError(f"unknown item: {name}")
+        stock = self._items[name]
+        if qty > stock:
+            raise ValueError(f"cannot remove {qty} of {name}: only {stock} in stock")
+        if qty == stock:
+            del self._items[name]
+        else:
+            self._items[name] = stock - qty
+
+    def items(self) -> list[tuple[str, int]]:
+        """Return (name, qty) pairs sorted by name."""
+        return sorted(self._items.items())
diff --git a/tests/test_core_and_cli.py b/tests/test_core_and_cli.py
new file mode 100644
index 0000000..1579edc
--- /dev/null
+++ b/tests/test_core_and_cli.py
@@ -0,0 +1,132 @@
+import json
+
+import pytest
+
+from inventory.cli import main
+from inventory.core import Inventory
+
+
+def test_load_missing_file_gives_empty_inventory(tmp_path):
+    assert Inventory.load(tmp_path / "missing.json").items() == []
+
+
+def test_save_writes_sorted_keys_and_round_trips(tmp_path):
+    path = tmp_path / "db.json"
+    inv = Inventory()
+    inv.add("pear", 2)
+    inv.add("apple", 5)
+    inv.save(path)
+
+    assert list(json.loads(path.read_text())) == ["apple", "pear"]
+    assert Inventory.load(path).items() == [("apple", 5), ("pear", 2)]
+
+
+def test_load_rejects_non_object_json(tmp_path):
+    path = tmp_path / "db.json"
+    path.write_text("[1, 2]")
+    with pytest.raises(ValueError):
+        Inventory.load(path)
+
+
+def test_add_accumulates_quantity():
+    inv = Inventory()
+    inv.add("apple", 2)
+    inv.add("apple", 3)
+    assert inv.items() == [("apple", 5)]
+
+
+@pytest.mark.parametrize("qty", [0, -1, "3", 1.5, True])
+def test_add_rejects_non_positive_or_non_int(qty):
+    with pytest.raises(ValueError):
+        Inventory().add("apple", qty)
+
+
+def test_remove_reduces_quantity():
+    inv = Inventory()
+    inv.add("apple", 5)
+    inv.remove("apple", 2)
+    assert inv.items() == [("apple", 3)]
+
+
+def test_remove_to_zero_drops_item():
+    inv = Inventory()
+    inv.add("apple", 2)
+    inv.remove("apple", 2)
+    assert inv.items() == []
+
+
+def test_remove_unknown_item_raises_key_error():
+    with pytest.raises(KeyError):
+        Inventory().remove("apple", 1)
+
+
+def test_remove_more_than_stock_raises_value_error():
+    inv = Inventory()
+    inv.add("apple", 1)
+    with pytest.raises(ValueError):
+        inv.remove("apple", 2)
+    assert inv.items() == [("apple", 1)]
+
+
+@pytest.mark.parametrize("qty", [0, -1, "1"])
+def test_remove_rejects_non_positive_or_non_int(qty):
+    inv = Inventory()
+    inv.add("apple", 3)
+    with pytest.raises(ValueError):
+        inv.remove("apple", qty)
+
+
+def test_items_sorted_by_name():
+    inv = Inventory()
+    inv.add("pear", 1)
+    inv.add("apple", 2)
+    inv.add("mango", 3)
+    assert inv.items() == [("apple", 2), ("mango", 3), ("pear", 1)]
+
+
+def test_cli_add_then_list(tmp_path, capsys):
+    db = str(tmp_path / "db.json")
+    assert main(["--db", db, "add", "apple", "4"]) == 0
+    assert main(["--db", db, "add", "banana", "1"]) == 0
+    capsys.readouterr()
+
+    assert main(["--db", db, "list"]) == 0
+    assert capsys.readouterr().out == "apple 4\nbanana 1\n"
+
+
+def test_cli_add_persists_to_file(tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "apple", "4"])
+    assert json.loads(db.read_text()) == {"apple": 4}
+
+
+def test_cli_remove_persists_to_file(tmp_path):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "apple", "4"])
+    assert main(["--db", str(db), "remove", "apple", "4"]) == 0
+    assert json.loads(db.read_text()) == {}
+
+
+def test_cli_list_empty_database(tmp_path, capsys):
+    assert main(["--db", str(tmp_path / "db.json"), "list"]) == 0
+    assert capsys.readouterr().out == ""
+
+
+def test_cli_remove_unknown_item_reports_error(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    assert main(["--db", str(db), "remove", "apple", "1"]) == 1
+    assert capsys.readouterr().err.startswith("error: unknown item: apple")
+    assert not db.exists()
+
+
+def test_cli_remove_too_many_reports_error_and_keeps_stock(tmp_path, capsys):
+    db = tmp_path / "db.json"
+    main(["--db", str(db), "add", "apple", "1"])
+    assert main(["--db", str(db), "remove", "apple", "5"]) == 1
+    assert "error: cannot remove 5 of apple" in capsys.readouterr().err
+    assert json.loads(db.read_text()) == {"apple": 1}
+
+
+def test_cli_add_non_positive_reports_error(tmp_path, capsys):
+    assert main(["--db", str(tmp_path / "db.json"), "add", "apple", "0"]) == 1
+    assert capsys.readouterr().err.startswith("error: quantity must be a positive integer")

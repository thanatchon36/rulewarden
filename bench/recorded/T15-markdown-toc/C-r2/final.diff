diff --git a/src/mdtoc/toc.py b/src/mdtoc/toc.py
index c7c0c10..9406e3b 100644
--- a/src/mdtoc/toc.py
+++ b/src/mdtoc/toc.py
@@ -1,2 +1,60 @@
+import re
+
+_HEADING = re.compile(r"^(#{1,6}) +(.*)$")
+_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})")
+_CLOSING_HASHES = re.compile(r"(?:^|\s+)#+$")
+_UNSAFE_ANCHOR_CHARS = re.compile(r"[^\w \-]")
+
+
+def _title(text: str) -> str:
+    return _CLOSING_HASHES.sub("", text.strip()).strip()
+
+
+def _anchor(title: str) -> str:
+    return _UNSAFE_ANCHOR_CHARS.sub("", title.lower()).replace(" ", "-")
+
+
 def toc(markdown: str, max_level: int = 3) -> str:
-    raise NotImplementedError
+    """Build a Markdown table of contents from ATX headings.
+
+    Headings inside fenced code blocks and headings deeper than
+    ``max_level`` are ignored. Duplicate anchors get ``-1``, ``-2``, ...
+    """
+    headings = []
+    fence = None
+    for line in markdown.splitlines():
+        fence_match = _FENCE.match(line)
+        if fence is not None:
+            # A closing fence must use the same character and be at least as long.
+            if fence_match and fence_match.group(1)[0] == fence[0] and len(fence_match.group(1)) >= len(fence):
+                fence = None
+            continue
+        if fence_match:
+            fence = fence_match.group(1)
+            continue
+        match = _HEADING.match(line)
+        if match is None:
+            continue
+        level = len(match.group(1))
+        if level > max_level:
+            continue
+        headings.append((level, _title(match.group(2))))
+
+    if not headings:
+        return ""
+
+    base_level = min(level for level, _ in headings)
+    used: set[str] = set()
+    lines = []
+    for level, title in headings:
+        anchor = _anchor(title)
+        candidate = anchor
+        n = 0
+        # Probe -1, -2, ... until an unused anchor is found, as GitHub does.
+        while candidate in used:
+            n += 1
+            candidate = f"{anchor}-{n}"
+        used.add(candidate)
+        indent = "  " * (level - base_level)
+        lines.append(f"{indent}- [{title}](#{candidate})\n")
+    return "".join(lines)
diff --git a/tests/test_toc_headings.py b/tests/test_toc_headings.py
new file mode 100644
index 0000000..956b164
--- /dev/null
+++ b/tests/test_toc_headings.py
@@ -0,0 +1,69 @@
+from mdtoc import toc
+
+
+def test_no_headings_returns_empty_string():
+    assert toc("just text\n") == ""
+
+
+def test_nested_headings_are_indented_relative_to_shallowest():
+    md = "## Install\n### Linux\n#### Deep\n## Usage\n"
+    assert toc(md) == (
+        "- [Install](#install)\n"
+        "  - [Linux](#linux)\n"
+        "    - [Deep](#deep)\n"
+        "- [Usage](#usage)\n"
+    )
+
+
+def test_headings_inside_backtick_fence_are_ignored():
+    md = "# Real\n```\n# Fake\n```\n# After\n"
+    assert toc(md) == "- [Real](#real)\n- [After](#after)\n"
+
+
+def test_headings_inside_tilde_fence_are_ignored():
+    md = "~~~python\n# Fake\n~~~\n# Real\n"
+    assert toc(md) == "- [Real](#real)\n"
+
+
+def test_fence_closes_only_with_matching_character():
+    md = "```\n~~~\n# Still code\n```\n# Real\n"
+    assert toc(md) == "- [Real](#real)\n"
+
+
+def test_headings_deeper_than_max_level_are_skipped():
+    md = "# One\n## Two\n### Three\n#### Four\n"
+    assert toc(md, max_level=2) == "- [One](#one)\n  - [Two](#two)\n"
+
+
+def test_closing_hashes_are_removed_from_title():
+    assert toc("## Setup ##\n") == "- [Setup](#setup)\n"
+
+
+def test_closing_hashes_without_space_are_kept():
+    assert toc("# C#\n") == "- [C#](#c)\n"
+
+
+def test_anchor_drops_punctuation_and_keeps_hyphen_and_underscore():
+    assert toc("# Hello, World! foo-bar_baz\n") == "- [Hello, World! foo-bar_baz](#hello-world-foo-bar_baz)\n"
+
+
+def test_duplicate_anchors_get_numeric_suffixes():
+    md = "# Notes\n# Notes\n# Notes\n"
+    assert toc(md) == (
+        "- [Notes](#notes)\n"
+        "- [Notes](#notes-1)\n"
+        "- [Notes](#notes-2)\n"
+    )
+
+
+def test_duplicate_suffix_skips_already_taken_anchor():
+    md = "# Foo 1\n# Foo\n# Foo\n"
+    assert toc(md) == (
+        "- [Foo 1](#foo-1)\n"
+        "- [Foo](#foo)\n"
+        "- [Foo](#foo-2)\n"
+    )
+
+
+def test_title_whitespace_is_stripped():
+    assert toc("#    Spaced   \n") == "- [Spaced](#spaced)\n"

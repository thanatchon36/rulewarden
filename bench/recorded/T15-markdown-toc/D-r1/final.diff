+from mdtoc import toc
+
+
+def test_indent_is_relative_to_shallowest_included_heading():
+    md = "### A\n#### B\n## C\n"
+    assert toc(md, max_level=4) == (
+        "  - [A](#a)\n"
+        "    - [B](#b)\n"
+        "- [C](#c)\n"
+    )

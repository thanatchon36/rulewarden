{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/rulewarden",
            "args": [
              "hook",
              "claude-code",
              "--root",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/rulewarden",
            "args": [
              "hook",
              "claude-code",
              "--root",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/rulewarden",
            "args": [
              "hook",
              "claude-code",
              "--root",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/rulewarden",
            "args": [
              "hook",
              "claude-code",
              "--root",
              "${CLAUDE_PROJECT_DIR}"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
